@* HomeController.Index trả List<SuKien>; ViewBag chứa danh mục và bộ lọc. *@
@model List<SuKien>

@{
    ViewData["Title"] = "Trang chủ";
    var danhMucs = ViewBag.DanhMucs as List<DanhMuc> ?? new List<DanhMuc>();
    var noiBat = Model.Take(6).ToList();
    var sapDienRa = Model.OrderBy(x => x.NgayBatDau).Take(8).ToList();
    var daDienRa = ViewBag.SuKienDaQua as List<SuKien> ?? new List<SuKien>();
    var loaiSuKien = ViewBag.LoaiSuKien as string ?? "tat-ca";
}

@* Banner và form tìm kiếm GET tới Home/SuKien. *@
<section class="hero d-flex align-items-center" style="min-height: 480px; padding: 4rem 0;">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7 text-start">
                <span class="hero-badge text-uppercase"><i class="fas fa-bolt me-1"></i> WUANGEVENTS</span>
                <h1 class="font-heading display-5 mb-3 mt-3 text-white fw-bold" style="line-height: 1.2;">
                    Khám phá &amp; Trải nghiệm<br />
                    <span style="color: #f3e8ff;">Những Sự Kiện Đỉnh Cao</span>
                </h1>
                <p class="text-white-50 mb-4 lead" style="font-size: 1.05rem;">
                    Nền tảng đặt vé và quản lý sự kiện trực tuyến nhanh chóng, an toàn và tiện lợi.
                </p>

                <form method="get" asp-controller="Home" asp-action="SuKien" class="d-flex p-2 align-items-center" style="max-width: 680px; background: rgba(255,255,255,0.95); border: 1px solid rgba(255,255,255,0.6); border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                    <input type="hidden" name="loaiSuKien" value="@loaiSuKien" />
                    <div class="input-group align-items-center px-3" style="flex: 1; border-right: 1px solid #e2e8f0;">
                        <i class="fas fa-search text-muted me-2"></i>
                        <input type="text" name="q" value="@ViewBag.TuKhoa" class="form-control border-0 bg-transparent py-2 shadow-none" placeholder="Tìm tên ca sĩ, đêm nhạc, hội thảo..." />
                    </div>
                    <div class="px-2" style="width: 170px;">
                        <select name="thanhPho" class="form-select border-0 bg-transparent shadow-none" style="cursor: pointer; font-weight: 500;">
                            <option value="">Tất cả tỉnh thành</option>
                            @if (ViewBag.Cities != null)
                            {
                                foreach (var city in ViewBag.Cities)
                                {
                                    <option value="@city" selected="@(ViewBag.SelectedCity == city ? "selected" : null)">@city</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded fw-bold" style="border-radius: 12px !important; white-space: nowrap;">
                        <i class="fas fa-compass me-1"></i> Tìm vé
                    </button>
                </form>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="hero-image-wrapper position-relative">
                    <img src="/images/hero-illustration.jpg" alt="Minh họa sự kiện WuangEvents" class="img-fluid rounded-4 shadow-lg" style="max-height: 360px; width: auto; object-fit: cover; border: 3px solid rgba(255,255,255,0.25);" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container mt-4 mb-5" aria-label="Khám phá theo hình thức tổ chức">
    <div class="home-format-filter">
        <a asp-controller="Home" asp-action="Index" asp-route-loaiSuKien="tat-ca"
           class="home-format-option @(loaiSuKien == "tat-ca" ? "active" : "")">
            <span class="format-icon"><i class="fas fa-border-all"></i></span>
            <span>Tất cả sự kiện</span>
        </a>
        <a asp-controller="Home" asp-action="Index" asp-route-loaiSuKien="truc-tiep"
           class="home-format-option @(loaiSuKien == "truc-tiep" ? "active" : "")">
            <span class="format-icon"><i class="fas fa-location-dot"></i></span>
            <span>Sự kiện trực tiếp</span>
        </a>
        <a asp-controller="Home" asp-action="Index" asp-route-loaiSuKien="truc-tuyen"
           class="home-format-option @(loaiSuKien == "truc-tuyen" ? "active" : "")">
            <span class="format-icon"><i class="fas fa-video"></i></span>
            <span>Sự kiện trực tuyến</span>
        </a>
    </div>
</section>

@* Danh mục được Controller gửi qua ViewBag.DanhMucs. *@
<section class="container my-5">
    <div class="section-title d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 fw-bold font-heading mb-0">Danh mục nổi bật</h2>
        <a asp-controller="Home" asp-action="SuKien" asp-route-loaiSuKien="@loaiSuKien" class="text-primary fw-bold text-decoration-none small">Xem tất cả sự kiện <i class="fas fa-chevron-right ms-1"></i></a>
    </div>
    <div class="row g-3 row-cols-lg-6 row-cols-md-3 row-cols-2">
        @foreach (var item in danhMucs)
        {
            <div class="col">
                <a class="category-card p-3 rounded text-center h-100 d-flex flex-column align-items-center justify-content-center gap-2"
                   asp-controller="Home" asp-action="SuKien" asp-route-danhMucId="@item.Id" asp-route-loaiSuKien="@loaiSuKien"
                   style="min-height: 90px; text-decoration: none; border: 1px solid #ede9fe; background: #ffffff; transition: all 0.2s ease;">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon text-primary fs-4"></i>
                    }
                    <div class="category-name fw-bold" style="color: #1e1b4b; font-size: 0.9rem;">@item.TenDanhMuc</div>
                </a>
            </div>
        }
    </div>
</section>

@* Hiển thị tối đa sáu sự kiện nổi bật. *@
<section class="container my-5" id="featured-events">
    <div class="section-title d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 fw-bold font-heading mb-0">Sự kiện HOT nổi bật</h2>
        <a asp-controller="Home" asp-action="SuKien" asp-route-loaiSuKien="@loaiSuKien" class="text-primary fw-bold text-decoration-none small">Xem tất cả sự kiện <i class="fas fa-chevron-right ms-1"></i></a>
    </div>

    @{
        var featuredList = noiBat.Count > 0 ? noiBat : Model.Take(6).ToList();
    }

    @if (featuredList.Count == 0)
    {
        <div class="card p-5 text-center">
            <h3 class="h5 fw-bold">Chưa có sự kiện để hiển thị</h3>
        </div>
    }
    else
    {
        <div class="row g-4 row-cols-lg-3 row-cols-md-2 row-cols-1">
            @foreach (var item in featuredList)
            {
                <div class="col animate-hover-up">
                    <div class="card h-100 rounded overflow-hidden">
                        <div class="position-relative overflow-hidden" style="height: 200px;">
                            <img src="@item.LayAnhBiaHienThi" alt="@item.TenSuKien" class="w-100 h-100 bg-light" style="object-fit:contain" onerror="this.onerror=null;this.src='/images/default-event.svg';" />
                            <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 bg-danger text-white rounded fw-bold text-uppercase">HOT</span>
                            <span class="event-format-badge position-absolute top-0 end-0 m-3"><i class="fas @(item.LoaiSuKien == 1 ? "fa-video" : "fa-location-dot") me-1"></i>@(item.LoaiSuKien == 1 ? "Trực tuyến" : "Trực tiếp")</span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <span class="text-primary small fw-bold text-uppercase d-block mb-1">
                                    <i class="far fa-calendar-alt"></i> @item.NgayBatDau.ToString("dd/MM/yyyy - HH:mm")
                                </span>
                                <h3 class="h6 card-title fw-bold text-truncate-2 mb-3">@item.TenSuKien</h3>
                                <div class="d-flex align-items-center gap-2 text-muted small mb-4">
                                    <i class="fas @(item.LoaiSuKien == 1 ? "fa-video text-primary" : "fa-map-marker-alt text-danger")"></i>
                                    <span class="text-truncate" style="max-width: 250px;" title="@(item.LoaiSuKien == 1 ? "Trực tuyến" : $"{item.TenDiaDiem}, {item.ThanhPhoDiaDiem}")">
                                        @(item.LoaiSuKien == 1 ? "Trực tuyến" : (!string.IsNullOrEmpty(item.ThanhPhoDiaDiem) ? $"{item.TenDiaDiem} ({item.ThanhPhoDiaDiem})" : item.TenDiaDiem ?? "Trực tiếp"))
                                    </span>
                                </div>
                            </div>
                            <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                <span class="text-success small fw-bold"><i class="fas fa-circle-check me-1"></i>Đang mở bán</span>
                                <a href="/Home/ChiTiet/@item.Slug" class="btn btn-primary px-4 py-2 rounded fw-bold small"><i class="fas fa-ticket me-1"></i>Mua vé ngay</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* Sắp xếp và hiển thị tối đa tám sự kiện gần nhất. *@
<section class="container my-5" id="sap-dien-ra">
    <div class="section-title d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 fw-bold font-heading mb-0">Sự kiện sắp diễn ra</h2>
    </div>

    <div class="row g-4 row-cols-lg-4 row-cols-md-2 row-cols-1">
        @foreach (var item in sapDienRa)
        {
            <div class="col animate-hover-up">
                <div class="card h-100 rounded overflow-hidden">
                    <div class="position-relative overflow-hidden" style="height: 160px;">
                        <img src="@item.LayAnhBiaHienThi" alt="@item.TenSuKien" class="w-100 h-100 bg-light" style="object-fit:contain" onerror="this.onerror=null;this.src='/images/default-event.svg';" />
                        <span class="event-format-badge position-absolute top-0 start-0 m-3"><i class="fas @(item.LoaiSuKien == 1 ? "fa-video" : "fa-location-dot") me-1"></i>@(item.LoaiSuKien == 1 ? "Trực tuyến" : "Trực tiếp")</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <span class="text-primary small fw-bold text-uppercase d-block mb-1">
                                <i class="far fa-calendar-alt"></i> @item.NgayBatDau.ToString("dd/MM/yyyy - HH:mm")
                            </span>
                            <h3 class="h6 card-title fw-bold text-truncate-2 mb-2">@item.TenSuKien</h3>
                            <div class="d-flex align-items-center gap-2 text-muted small mb-3">
                                <i class="fas @(item.LoaiSuKien == 1 ? "fa-video text-primary" : "fa-map-marker-alt text-danger")"></i>
                                <span class="text-truncate" style="max-width: 200px;" title="@(item.LoaiSuKien == 1 ? "Trực tuyến" : $"{item.TenDiaDiem}, {item.ThanhPhoDiaDiem}")">
                                    @(item.LoaiSuKien == 1 ? "Trực tuyến" : (!string.IsNullOrEmpty(item.ThanhPhoDiaDiem) ? $"{item.TenDiaDiem} ({item.ThanhPhoDiaDiem})" : item.TenDiaDiem ?? "Trực tiếp"))
                                </span>
                            </div>
                        </div>
                        <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                            <span class="text-success small fw-bold"><i class="fas fa-circle-check me-1"></i>Đang bán</span>
                            <a href="/Home/ChiTiet/@item.Slug" class="btn btn-sm btn-primary px-3 py-2 rounded fw-bold small"><i class="fas fa-ticket me-1"></i>Mua vé</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@if (daDienRa.Count > 0)
{
    <section class="container my-5" id="da-dien-ra">
        <div class="section-title d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold font-heading mb-0">Sự kiện đã diễn ra</h2>
            <a asp-controller="Home" asp-action="SuKien" asp-route-thoiGian="da-dien-ra" asp-route-loaiSuKien="@loaiSuKien" class="text-primary fw-bold text-decoration-none small">Xem tất cả <i class="fas fa-chevron-right ms-1"></i></a>
        </div>

        <div class="row g-4 row-cols-lg-3 row-cols-md-2 row-cols-1">
            @foreach (var item in daDienRa)
            {
                <div class="col animate-hover-up">
                    <div class="card h-100 rounded overflow-hidden border-0" style="box-shadow: 0 4px 20px rgba(0,0,0,.06);">
                        <div class="position-relative overflow-hidden" style="height: 180px;">
                            <img src="@item.LayAnhBiaHienThi" alt="@item.TenSuKien" class="w-100 h-100 bg-light" style="object-fit:contain" onerror="this.onerror=null;this.src='/images/default-event.svg';" />
                            <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 bg-secondary">Đã diễn ra</span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <span class="text-secondary small fw-bold d-block mb-2">
                                    <i class="far fa-calendar-alt me-1"></i>@item.NgayBatDau.ToString("dd/MM/yyyy - HH:mm")
                                </span>
                                <h3 class="h6 fw-bold text-truncate-2 mb-3">@item.TenSuKien</h3>
                                <div class="text-muted small mb-4 text-truncate">
                                    <i class="fas @(item.LoaiSuKien == 1 ? "fa-video text-primary" : "fa-map-marker-alt text-danger") me-1"></i>
                                    @(item.LoaiSuKien == 1 ? "Trực tuyến" : item.TenDiaDiem ?? "Trực tiếp")
                                </div>
                            </div>
                            <a href="/Home/ChiTiet/@item.Slug" class="btn btn-outline-primary fw-bold">Xem sự kiện</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
