@* Form POST Account/DangNhap; Controller kiểm tra tài khoản/BCrypt rồi tạo cookie.
   ViewBag.Error hiển thị lỗi và returnUrl đưa người dùng về trang ban đầu. *@
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container page-section">
    <div class="auth-container">
        <div class="auth-header">
            <h2>Chào mừng trở lại</h2>
        </div>

        @* Hiển thị thông báo lỗi từ Controller gửi sang nếu có *@
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
            </div>
        }

        @if (ViewBag.EmailChuaXacMinh != null)
        {
            <form method="post" asp-controller="Account" asp-action="GuiLaiEmailXacMinh" class="mb-3">
                <input type="hidden" name="email" value="@ViewBag.EmailChuaXacMinh" />
                <button type="submit" class="btn btn-outline-primary w-100">Gửi lại email xác minh</button>
            </form>
        }

        @* Form gửi dữ liệu đăng nhập *@
        <form method="post" asp-controller="Account" asp-action="DangNhap">
            @* Trường ẩn lưu URL cần quay lại sau khi đăng nhập thành công *@
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            
            <div class="form-group">
                <label>Địa chỉ Email</label>
                <input class="form-control" type="email" name="email" required autocomplete="email" placeholder="Ví dụ: nguyenvana@gmail.com" />
            </div>
            
            <div class="form-group">
                <label>Mật khẩu</label>
                <input class="form-control" type="password" name="matKhau" required autocomplete="current-password" placeholder="Nhập mật khẩu tài khoản" />
            </div>
            
            <button type="submit" class="btn btn-primary w-100 py-3 mt-2">Đăng nhập ngay</button>
        </form>

        <div class="text-center mt-3 small">
            <a href="/Account/QuenMatKhau">Bạn quên mật khẩu?</a>
        </div>
        <div class="text-center mt-3 text-muted small">
            Chưa có tài khoản? <a href="/Account/DangKy" class="text-primary fw-bold">Đăng ký tài khoản mới</a>
        </div>
    </div>
</div>

