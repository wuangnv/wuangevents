@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container page-section">
    <div class="auth-container">
        <div class="auth-header">
            <h2>Quên mật khẩu</h2>
            <p>Nhập email để tạo liên kết đặt lại mật khẩu.</p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info">@ViewBag.Message</div>
        }
        @if (ViewBag.ResetLink != null)
        {
            <div class="alert alert-info" style="font-size: 0.88rem; line-height: 1.5;">
                <i class="fas fa-circle-info"></i> <strong>Môi trường Demo / Thử nghiệm:</strong><br />
                Để thuận tiện cho việc kiểm thử tính năng mà không cần cấu hình SMTP thực tế, vui lòng truy cập đường dẫn dưới đây để đổi mật khẩu mới:<br />
                <a href="@ViewBag.ResetLink" class="fw-bold text-decoration-underline" style="color: inherit; display: inline-block; margin-top: 6px;">Đặt lại mật khẩu mới &raquo;</a>
            </div>
        }

        <form method="post">
            <div class="form-group">
                <label>Địa chỉ Email</label>
                <input class="form-control" type="email" name="email" placeholder="Nhập email tài khoản của bạn..." required />
            </div>
            <button class="btn btn-primary w-100" type="submit"><i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu đặt lại mật khẩu</button>
        </form>
    </div>
</div>
