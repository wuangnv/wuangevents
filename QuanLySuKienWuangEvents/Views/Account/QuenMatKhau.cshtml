@{
    ViewData["Title"] = "Quên mật khẩu";
}

@* POST gửi liên kết đặt lại mật khẩu qua email. *@
<div class="container page-section">
    <div class="auth-container">
        <div class="auth-header">
            <h2>Quên mật khẩu</h2>
        </div>

        @if (ViewBag.Message != null)
        {
            <div data-ui-toast="@ViewBag.Message" data-ui-toast-type="success" hidden></div>
        }
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Địa chỉ Email</label>
                <input class="form-control" type="email" name="email" placeholder="Nhập email tài khoản của bạn..." required />
            </div>
            <button class="btn btn-primary w-100" type="submit"><i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu đặt lại mật khẩu</button>
        </form>
    </div>
</div>
