@* Form đăng ký POST Account/DangKy; input name khớp tham số action.
   Controller kiểm tra dữ liệu, băm BCrypt, INSERT NguoiDung và gửi email. *@
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container page-section">
    <div class="auth-container">
        <div class="auth-header">
            <h2>Tạo tài khoản mới</h2>
        </div>

        @* Hiển thị thông báo lỗi từ Controller gửi sang nếu có *@
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
            </div>
        }

        @* Form gửi dữ liệu đăng ký *@
        <form method="post" asp-controller="Account" asp-action="DangKy">
            <div class="form-group">
                <label>Họ và Tên</label>
                <input class="form-control" name="hoTen" required placeholder="Nhập họ tên đầy đủ" />
            </div>
            
            <div class="form-group">
                <label>Địa chỉ Email</label>
                <input class="form-control" type="email" name="email" required placeholder="Ví dụ: nguyenvana@gmail.com" />
            </div>
            
            <div class="form-group">
                <label>Mật khẩu (tối thiểu 6 ký tự)</label>
                <input class="form-control" type="password" name="matKhau" required minlength="6" placeholder="Nhập mật khẩu an toàn" />
            </div>
            
            <div class="form-group">
                <label>Số điện thoại (tùy chọn)</label>
                <input class="form-control" name="soDienThoai" placeholder="Nhập số điện thoại liên lạc" />
            </div>
            
            <button class="btn btn-primary w-100 py-3 mt-2" type="submit">Đăng ký tài khoản</button>
        </form>

        <div class="text-center mt-4 text-muted small">
            Đã có tài khoản? <a href="/Account/DangNhap" class="text-primary fw-bold">Đăng nhập ngay</a>
        </div>
    </div>
</div>

