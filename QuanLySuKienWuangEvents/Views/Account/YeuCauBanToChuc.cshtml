@model NguoiDung
@{
    ViewData["Title"] = "Trở thành Ban tổ chức";
}

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            
            <div class="text-center mb-4">
                <span class="badge bg-primary-soft text-primary px-3 py-2 text-uppercase fw-bold mb-2">Ban Tổ Chức</span>
                <h1 class="h3 fw-bold font-heading mb-2">Đăng ký đối tác tổ chức</h1>
                <p class="text-muted small">Hãy cung cấp thông tin liên hệ để được cấp quyền truy cập hệ thống quản lý sự kiện.</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                </div>
            }

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Message"]
                </div>
            }

            <div class="card p-4 shadow-sm" style="border: 1px solid var(--border-color); border-radius: 16px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px);">
                @if (Model.YeuCauBanToChuc == 1)
                {
                    <!-- Trạng thái chờ duyệt -->
                    <div class="text-center py-4">
                        <div class="display-3 text-warning mb-3">
                            <i class="fas fa-hourglass-half animate-spin"></i>
                        </div>
                        <h3 class="h5 fw-bold text-warning mb-2">Đang chờ phê duyệt</h3>
                        <p class="text-muted small mb-4">Yêu cầu nâng cấp tài khoản của bạn đã được gửi thành công vào lúc <strong>@Model.NgayYeuCauBTC?.ToString("dd/MM/yyyy HH:mm")</strong>.</p>
                        <hr />
                        <div class="text-start small text-muted">
                            <div class="mb-2"><strong>Họ và tên:</strong> @Model.HoTen</div>
                            <div><strong>Số điện thoại liên hệ:</strong> @Model.SdtBanToChuc</div>
                        </div>
                        <a href="/" class="btn btn-outline-secondary w-100 mt-4 py-2 fw-bold" style="border-radius: 10px;">Quay lại trang chủ</a>
                    </div>
                }
                else
                {
                    @if (Model.YeuCauBanToChuc == 3)
                    {
                        <!-- Trạng thái bị từ chối -->
                        <div class="alert alert-warning border-0 mb-4 small">
                            <h5 class="alert-heading fw-bold"><i class="fas fa-circle-xmark me-1"></i> Yêu cầu trước đó bị từ chối</h5>
                            <p class="mb-0">Lý do từ chối: <strong>@Model.LyDoTuChoiBTC</strong></p>
                            <p class="mb-0 text-muted mt-1">Bạn có thể điều chỉnh lại thông tin và gửi lại yêu cầu mới bên dưới.</p>
                        </div>
                    }

                    <form method="post" action="/Account/GuiYeuCauBanToChuc">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Họ và tên hiển thị <span class="text-danger">*</span></label>
                            <input type="text" class="form-control py-2" name="hoTen" value="@Model.HoTen" required style="border-radius: 10px;" />
                            <div class="form-text small text-muted">Tên này sẽ hiển thị ở hồ sơ đối tác của bạn.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control py-2" name="sdt" value="@Model.SoDienThoai" placeholder="Ví dụ: 0987654321" required style="border-radius: 10px;" />
                            <div class="form-text small text-muted">Số điện thoại để Admin liên hệ đối soát và xác minh.</div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mt-3" style="border-radius: 10px; background: var(--primary); border: none; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);">
                            <i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu duyệt
                        </button>
                        
                        <a href="/" class="btn btn-outline-secondary w-100 py-2 fw-bold mt-2" style="border-radius: 10px;">Hủy bỏ</a>
                    </form>
                }
            </div>

        </div>
    </div>
</div>
