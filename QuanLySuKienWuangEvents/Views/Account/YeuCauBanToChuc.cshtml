@model NguoiDung
@{
    ViewData["Title"] = "Trở thành Ban tổ chức";
}

@* GET lấy NguoiDung hiện tại; form POST GuiYeuCauBanToChuc.
   Controller đặt YeuCauBanToChuc = 1 để Admin duyệt. *@
<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            
            <div class="text-center mb-4">
                <span class="badge bg-primary-soft text-primary px-3 py-2 text-uppercase fw-bold mb-2">Ban Tổ Chức</span>
                <h1 class="h3 fw-bold font-heading mb-2">Đăng ký đối tác tổ chức</h1>
            </div>

            <div class="card p-4 shadow-sm" style="border: 1px solid var(--border-color); border-radius: 16px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px);">
                @if (Model.YeuCauBanToChuc == 1)
                {
                    <!-- Trạng thái chờ duyệt -->
                    <div class="text-center py-4">
                        <div class="display-3 text-warning mb-3">
                            <i class="fas fa-hourglass-half animate-spin"></i>
                        </div>
                        <h3 class="h5 fw-bold text-warning mb-2">Đang chờ phê duyệt</h3>
                        <p class="text-muted small mb-4">Yêu cầu nâng cấp tài khoản của bạn đã được gửi thành công vào lúc <strong>@(VietnamTime.FromUtc(Model.NgayYeuCauBTC)?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong>.</p>
                        <hr />
                        <div class="text-start small text-muted">
                            <div class="mb-2"><strong>Ban tổ chức:</strong> @Model.TenToChuc</div>
                            <div class="mb-2"><strong>Người đại diện:</strong> @Model.HoTen</div>
                            <div class="mb-2"><strong>Loại chủ thể:</strong> @(Model.LoaiChuTheBTC == 1 ? "Doanh nghiệp / đơn vị" : "Cá nhân")</div>
                            <div><strong>Số điện thoại:</strong> @Model.SdtBanToChuc</div>
                        </div>
                        <a href="/" class="btn btn-outline-secondary w-100 mt-4 py-2 fw-bold" style="border-radius: 10px;">Quay lại trang chủ</a>
                    </div>
                }
                else
                {
                    @if (Model.YeuCauBanToChuc == 3)
                    {
                        <!-- Trạng thái bị từ chối -->
                        <div class="alert alert-warning border-0 mb-4 small">
                            <h5 class="alert-heading fw-bold"><i class="fas fa-circle-xmark me-1"></i> Yêu cầu trước đó bị từ chối</h5>
                            <p class="mb-0">Lý do từ chối: <strong>@Model.LyDoTuChoiBTC</strong></p>
                            <p class="mb-0 text-muted mt-1">Bạn có thể điều chỉnh lại thông tin và gửi lại yêu cầu mới bên dưới.</p>
                        </div>
                    }

                    <form method="post" asp-controller="Account" asp-action="GuiYeuCauBanToChuc">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Email xác minh</label>
                            <div class="input-group">
                                <input type="email" class="form-control py-2" value="@Model.Email" readonly />
                                <span class="input-group-text text-success bg-white"><i class="fas fa-circle-check me-1"></i>Đã xác minh</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Người đại diện <span class="text-danger">*</span></label>
                                <input type="text" class="form-control py-2" name="hoTen" value="@Model.HoTen" minlength="2" maxlength="100" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control py-2" name="sdt" value="@(Model.SdtBanToChuc ?? Model.SoDienThoai)" placeholder="Ví dụ: 0987654321" pattern="0(3|5|7|8|9)[0-9]{8}" maxlength="10" required />
                            </div>
                            <div class="col-md-7">
                                <label class="form-label fw-semibold text-dark">Tên Ban tổ chức <span class="text-danger">*</span></label>
                                <input type="text" class="form-control py-2" name="tenToChuc" value="@Model.TenToChuc" minlength="2" maxlength="150" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold text-dark">Loại chủ thể <span class="text-danger">*</span></label>
                                <select class="form-select py-2" name="loaiChuTheBTC" required>
                                    <option value="">Chọn loại</option>
                                    @if (Model.LoaiChuTheBTC == 0)
                                    {
                                        <option value="0" selected>Cá nhân</option>
                                    }
                                    else
                                    {
                                        <option value="0">Cá nhân</option>
                                    }
                                    @if (Model.LoaiChuTheBTC == 1)
                                    {
                                        <option value="1" selected>Doanh nghiệp / đơn vị</option>
                                    }
                                    else
                                    {
                                        <option value="1">Doanh nghiệp / đơn vị</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Giới thiệu hoạt động tổ chức <span class="text-danger">*</span></label>
                                <textarea class="form-control" name="moTaYeuCauBTC" rows="4" minlength="30" maxlength="1000" placeholder="Loại sự kiện dự kiến tổ chức, kinh nghiệm hoặc quy mô hoạt động" required>@Model.MoTaYeuCauBTC</textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="daDongYDieuKhoanBTC" value="true" id="termsBTC" required @(Model.DaDongYDieuKhoanBTC ? "checked" : "") />
                                    <label class="form-check-label" for="termsBTC">Tôi cam kết thông tin chính xác và đồng ý điều khoản tổ chức sự kiện.</label>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mt-3" style="border-radius: 10px; background: var(--primary); border: none; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);">
                            <i class="fas fa-paper-plane me-1"></i> Gửi yêu cầu duyệt
                        </button>
                        
                        <a href="/" class="btn btn-outline-secondary w-100 py-2 fw-bold mt-2" style="border-radius: 10px;">Hủy bỏ</a>
                    </form>
                }
            </div>

        </div>
    </div>
</div>
