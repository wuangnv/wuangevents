@model MaGiamGia

@{
    // GET lấy một MaGiamGia thuộc sự kiện của BTC; form POST lưu chỉnh sửa.
    // Controller kiểm tra loại giảm, giá trị, ngày và quyền sở hữu trước UPDATE.
    Layout = "~/Views/Shared/_OrganizerSimpleLayout.cshtml";
    ViewData["Title"] = "Sửa mã giảm giá";
}

<style>
.edit-coupon-form {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.05);
    overflow: hidden;
    max-width: 760px;
}
.edit-coupon-header {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: #fff;
    padding: 20px 24px;
}
.edit-coupon-header h1 { font-size: 1.25rem; font-weight: 700; margin: 0; }
.edit-coupon-header p { font-size: 0.85rem; opacity: 0.85; margin: 4px 0 0; }
.edit-coupon-body { padding: 28px 24px; }
.form-label-custom { font-size: .8rem; font-weight: 700; color: #374151; margin-bottom: 4px; }
</style>

<!-- Breadcrumb -->
<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-controller="Organizer" asp-action="MaGiamGia" asp-route-suKienId="@Model.SuKienId" class="btn btn-sm btn-light border text-secondary" style="border-radius:8px;">
        <i class="fas fa-arrow-left me-1"></i> Quay lại
    </a>
    <span class="text-muted small">/</span>
    <span class="text-muted small">Chỉnh sửa mã @Model.MaCode</span>
</div>

<div class="edit-coupon-form">
    <div class="edit-coupon-header">
        <h1><i class="fas fa-pen-to-square me-2"></i>Chỉnh sửa mã giảm giá</h1>
    </div>
    <div class="edit-coupon-body">
        <form method="post" asp-controller="Organizer" asp-action="ChinhSuaMaGiamGia">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SuKienId" />
            
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label-custom">Mã Code <span class="text-danger">*</span></label>
                    <input class="form-control text-uppercase font-monospace fw-bold" asp-for="MaCode" placeholder="VD: SUMMER30" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Mô tả</label>
                    <input class="form-control" asp-for="MoTa" placeholder="Giảm giá sự kiện..." />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label-custom">Loại giảm giá</label>
                    <select class="form-select" asp-for="LoaiGiamGia">
                        <option value="0">Phần trăm (%)</option>
                        <option value="1">Số tiền (₫)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Giá trị giảm <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="GiaTri" type="number" min="1" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom">Giảm tối đa (₫)</label>
                    <input class="form-control" asp-for="GiamToiDa" type="number" min="0" placeholder="Bỏ trống nếu không giới hạn" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label-custom">Giá trị đơn tối thiểu (₫)</label>
                    <input class="form-control" asp-for="DonToiThieu" type="number" min="0" placeholder="0" />
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Tổng lượt sử dụng <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="SoLuongTong" type="number" min="@Model.SoLuongDaDung" required />
                    <span class="text-muted small" style="font-size:0.72rem;">Đã dùng: @Model.SoLuongDaDung lượt</span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label-custom">Thời gian bắt đầu</label>
                    <input class="form-control" name="NgayBatDau" type="datetime-local" 
                           value="@(Model.NgayBatDau.ToString("yyyy-MM-ddTHH:mm"))" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom">Thời gian kết thúc</label>
                    <input class="form-control" name="NgayKetThuc" type="datetime-local" 
                           value="@(Model.NgayKetThuc.ToString("yyyy-MM-ddTHH:mm"))" required />
                </div>
            </div>

            <div class="mb-4 form-check ms-1">
                <input class="form-check-input" asp-for="TrangThai" style="cursor: pointer;" />
                <label class="form-check-label fw-bold text-dark" asp-for="TrangThai" style="cursor: pointer; font-size: 0.85rem;">
                    Kích hoạt hoạt động mã này
                </label>
            </div>

            <div class="d-flex gap-2 border-top pt-4">
                <button class="btn btn-success fw-bold px-4 py-2" type="submit" style="border-radius: 8px;">
                    <i class="fas fa-save me-1"></i> Lưu thay đổi
                </button>
                <a class="btn btn-outline-secondary px-4 py-2" asp-controller="Organizer" asp-action="MaGiamGia" asp-route-suKienId="@Model.SuKienId" style="border-radius: 8px;">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>
