@model SuKien
@{
    // GET ChinhSuaSuKien(id) trả SuKien + danh mục/loại vé/hồ sơ qua ViewBag.
    // Form multipart POST cùng tên để cập nhật dữ liệu và có thể upload ảnh.
    Layout = "~/Views/Shared/_OrganizerSimpleLayout.cshtml";
    ViewData["Title"] = "Sửa sự kiện";
    var danhMucs = ViewBag.DanhMucs as List<DanhMuc> ?? new List<DanhMuc>();
    var currentLoaiVes = ViewBag.LoaiVes as List<LoaiVe> ?? new();
    var currentHoSo = ViewBag.Profile as NguoiDung;
    bool coTheChinhSua = Model.TrangThai is 0 or 1 or 2 or 7;
    bool daKhoaCauHinhVe = ViewBag.SoDonHang > 0 || Model.CoSoDoChoNgoi;
}

<style>
    /* Premium Editor Styles */
    .portal-card {
        background: #ffffff;
        border: 1px solid #ede9fe;
        border-radius: 12px;
        box-shadow: 0 10px 15px -3px rgba(124, 58, 237, 0.05);
        margin-bottom: 2rem;
    }
    .portal-card-header {
        border-bottom: 1px solid #f5f3ff;
        padding: 1.25rem 1.5rem;
        background: #faf8ff;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }
    .portal-card-header h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #7c3aed;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .portal-card-body {
        padding: 1.5rem;
    }
    .form-label {
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.4rem;
        font-size: 0.9rem;
    }
    .form-control, .form-select {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
        outline: none;
    }

    /* Switch type buttons */
    .btn-group-toggle .btn {
        padding: 0.6rem 1.5rem;
        font-weight: 600;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #64748b;
        transition: all 0.2s ease;
    }
    .btn-group-toggle .btn.active {
        background: #7c3aed;
        color: #ffffff;
        border-color: #7c3aed;
        box-shadow: 0 4px 6px -1px rgba(124, 58, 237, 0.2);
    }

    /* Preview box style */
    .preview-box {
        aspect-ratio: 16/9;
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-weight: 600;
        overflow: hidden;
        position: relative;
        margin-bottom: 1rem;
        transition: all 0.2s ease;
    }
    .preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .preview-thumbnail {
        width: 120px;
        height: 120px;
        border-radius: 8px;
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        overflow: hidden;
        position: relative;
    }
    .preview-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Tickets Dynamic List */
    .ticket-card {
        background: #fafafa;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        position: relative;
        transition: border-color 0.2s ease;
    }
    .ticket-card:hover {
        border-color: #c084fc;
    }
    .remove-ticket-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        color: #ef4444;
        background: none;
        border: none;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
        transition: transform 0.2s ease;
    }
    .remove-ticket-btn:hover {
        transform: scale(1.15);
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div class="portal-page-title">
        <span class="portal-kicker"><i class="fas fa-pen"></i> Chỉnh sửa</span>
        <h1>Sửa thông tin sự kiện</h1>
    </div>
    <a class="btn btn-outline-secondary" href="/Organizer/ChiTietSuKien/@Model.Id">
        <i class="fas fa-arrow-left me-1"></i> Quay lại chi tiết
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">@TempData["Error"]</div>
}
@if (!coTheChinhSua)
{
    <div class="alert alert-warning mb-4">Hãy tạm dừng bán vé trước khi sửa thông tin sự kiện.</div>
}

<form method="post" action="/Organizer/ChinhSuaSuKien/@Model.Id" id="editForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <fieldset disabled="@(!coTheChinhSua)" style="border:0;padding:0;margin:0;min-width:0;width:100%;">

    <div class="row">
        <!-- LEFT COLUMN: Content details & Locations -->
        <div class="col-lg-8">
            <!-- Card 1: Basic Info -->
            <div class="portal-card">
                <div class="portal-card-header">
                    <h2><i class="fas fa-info-circle"></i> Thông tin cơ bản</h2>
                </div>
                <div class="portal-card-body">
                    <div class="mb-3">
                        <label class="form-label">Tên sự kiện <span class="text-danger">*</span></label>
                        <input class="form-control" name="tenSuKien" id="tenSuKien" value="@Model.TenSuKien" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                            <select class="form-select" name="danhMucId" required>
                                @foreach (var item in danhMucs)
                                {
                                    <option value="@item.Id" selected="@(item.Id == Model.DanhMucId)">@item.TenDanhMuc</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Hình thức sự kiện <span class="text-danger">*</span></label>
                            <div class="btn-group w-100 btn-group-toggle" role="group">
                                <button type="button" class="btn @(Model.LoaiSuKien == 0 ? "active" : "") w-50" id="btnOffline" onclick="setEventType(0)">Offline (Trực tiếp)</button>
                                <button type="button" class="btn @(Model.LoaiSuKien == 1 ? "active" : "") w-50" id="btnOnline" onclick="setEventType(1)">Online (Trực tuyến)</button>
                            </div>
                            <input type="hidden" name="loaiSuKien" id="loaiSuKien" value="@Model.LoaiSuKien" />
                        </div>
                    </div>

                    <!-- Offline Fields -->
                    <div id="offlineSection" class="p-3 bg-light rounded border mb-3" style="display: @(Model.LoaiSuKien == 0 ? "block" : "none");">
                        <h3 class="h6 font-weight-bold text-dark mb-3"><i class="fas fa-map-marker-alt text-primary me-1"></i>Địa điểm tổ chức</h3>
                        <div class="mb-3">
                            <label class="form-label">Tên địa điểm <span class="text-danger">*</span></label>
                            <input class="form-control" name="tenDiaDiem" id="tenDiaDiem" value="@Model.TenDiaDiem" placeholder="Ví dụ: Hội trường A, Nhà văn hóa..." />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select class="form-select" name="tinhThanh" id="tinhThanh" onchange="updateDistricts()">
                                    <option value="">Chọn Tỉnh / Thành phố</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Quận / Huyện <span class="text-danger">*</span></label>
                                <select class="form-select" id="quanHuyenSelect" onchange="updateWards()">
                                    <option value="">Chọn Quận / Huyện</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Phường / Xã</label>
                                <select class="form-select" id="phuongXaSelect" onchange="combineAddress()">
                                    <option value="">Chọn Phường / Xã</option>
                                </select>
                            </div>
                            <input type="hidden" name="quanHuyenPhuongXa" id="quanHuyenPhuongXa" value="@Model.QuanHuyenDiaDiem" />
                        </div>
                        <div>
                            <label class="form-label">Số nhà, tên đường <span class="text-danger">*</span></label>
                            <input class="form-control" name="soNhaDuong" id="soNhaDuong" value="@Model.DiaChiDiaDiem" placeholder="Ví dụ: 123 Nguyễn Văn Cừ" />
                        </div>
                    </div>

                    <!-- Online Fields -->
                    <div id="onlineSection" class="p-3 bg-light rounded border mb-3" style="display: @(Model.LoaiSuKien == 1 ? "block" : "none");">
                        <h3 class="h6 font-weight-bold text-dark mb-3"><i class="fas fa-video text-success me-1"></i>Đường dẫn trực tuyến</h3>
                        <div>
                            <label class="form-label">Link Zoom/Google Meet/Livestream <span class="text-danger">*</span></label>
                            <input class="form-control" name="linkOnline" id="linkOnline" value="@Model.LinkOnline" placeholder="https://zoom.us/j/..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả ngắn sự kiện</label>
                        <textarea class="form-control" name="moTaNgan" rows="2">@Model.MoTaNgan</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mô tả chi tiết</label>
                        <textarea class="form-control" name="moTaChiTiet" rows="6">@Model.MoTaChiTiet</textarea>
                    </div>
                </div>
            </div>

            <!-- Card 2: Ticket Classes -->
            <div class="portal-card">
                <div class="portal-card-header d-flex justify-content-between align-items-center">
                    <h2><i class="fas fa-ticket-alt"></i> Phân loại vé bán</h2>
                    @if (daKhoaCauHinhVe)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Sự kiện đã phát sinh đơn hàng, không thể thêm vé tại đây"><i class="fas fa-plus me-1"></i>Thêm loại vé (Bị khóa)</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTicketRow()"><i class="fas fa-plus me-1"></i>Thêm loại vé</button>
                    }
                </div>
                <div class="portal-card-body" id="ticketRowsContainer">
                    @if (daKhoaCauHinhVe)
                    {
                        <div class="alert alert-warning mb-3 d-flex align-items-center gap-2" style="border-radius: 8px;">
                            <i class="fas fa-triangle-exclamation fs-5"></i>
                            <div>
                                <strong>Cấu hình vé đã bị khóa:</strong> @if (Model.CoSoDoChoNgoi) { <text>Sơ đồ ghế đang gắn với các loại vé này.</text> } else { <text>Sự kiện đã có <strong>@ViewBag.SoDonHang đơn hàng</strong>.</text> } Hãy quản lý từng loại vé tại mục <a href="/Organizer/LoaiVe?suKienId=@Model.Id" class="fw-bold text-decoration-none text-warning">Quản lý loại vé</a>.
                            </div>
                        </div>
                    }
                    @if (currentLoaiVes.Count == 0)
                    {
                        <div class="ticket-card" id="ticket-row-0">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Tên loại vé <span class="text-danger">*</span></label>
                                    <input class="form-control" name="tenLoaiVe" placeholder="Vé thường, Vé VIP..." required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Giá vé (VND) <span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" name="giaVe" min="0" value="0" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Số lượng tổng <span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" name="soLuongVe" min="1" value="100" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Giới hạn mỗi đơn <span class="text-danger">*</span></label>
                                    <input class="form-control" type="number" name="gioiHanMoiDon" min="1" value="10" required />
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        for (int i = 0; i < currentLoaiVes.Count; i++)
                        {
                            var ticket = currentLoaiVes[i];
                            <div class="ticket-card" id="ticket-row-@i">
                                @if (i > 0 && !daKhoaCauHinhVe)
                                {
                                    <button type="button" class="remove-ticket-btn" onclick="removeTicketRow(@i)"><i class="fas fa-trash-alt"></i></button>
                                }
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Tên loại vé <span class="text-danger">*</span></label>
                                        <input class="form-control" name="tenLoaiVe" value="@ticket.TenLoaiVe" placeholder="Vé thường, Vé VIP..." required @(daKhoaCauHinhVe ? "readonly" : "") />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Giá vé (VND) <span class="text-danger">*</span></label>
                                        <input class="form-control" type="number" name="giaVe" value="@Convert.ToInt64(ticket.GiaBan)" min="0" required @(daKhoaCauHinhVe ? "readonly" : "") />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Số lượng tổng <span class="text-danger">*</span></label>
                                        <input class="form-control" type="number" name="soLuongVe" value="@ticket.SoLuongTong" min="1" required @(daKhoaCauHinhVe ? "readonly" : "") />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Giới hạn mỗi đơn <span class="text-danger">*</span></label>
                                        <input class="form-control" type="number" name="gioiHanMoiDon" value="@ticket.GioiHanMoiDon" min="1" required @(daKhoaCauHinhVe ? "readonly" : "") />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Timeline, Images, Organizer Info -->
        <div class="col-lg-4">
            <!-- Card 3: Timeline Settings -->
            <div class="portal-card">
                <div class="portal-card-header">
                    <h2><i class="fas fa-clock"></i> Cài đặt Thời gian</h2>
                </div>
                <div class="portal-card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Bắt đầu sự kiện <span class="text-danger">*</span></label>
                            <input class="form-control" type="datetime-local" name="ngayBatDau" id="ngayBatDau" value="@Model.NgayBatDau.ToString("yyyy-MM-ddTHH:mm")" required onchange="onStartDateChange()" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Kết thúc sự kiện <span class="text-danger">*</span></label>
                            <input class="form-control" type="datetime-local" name="ngayKetThuc" id="ngayKetThuc" value="@Model.NgayKetThuc.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span class="text-muted small d-block mt-1"><i class="fas fa-circle-info text-primary me-1"></i>Sự kiện có thể diễn ra vài tiếng cùng ngày.</span>
                        </div>
                        <div class="col-12 offline-checkin-field">
                            <label class="form-label">Mở check-in (Tùy chọn)</label>
                            <input class="form-control" type="datetime-local" name="batDauCheckIn" id="batDauCheckIn" value="@(Model.BatDauCheckIn.HasValue ? Model.BatDauCheckIn.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span class="text-muted small">Mặc định là 1 tiếng trước khi sự kiện bắt đầu.</span>
                        </div>
                        <div class="col-12 offline-checkin-field">
                            <label class="form-label">Đóng check-in (Tùy chọn)</label>
                            <input class="form-control" type="datetime-local" name="ketThucCheckIn" id="ketThucCheckIn" value="@(Model.KetThucCheckIn.HasValue ? Model.KetThucCheckIn.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span class="text-muted small">Mặc định là khi sự kiện kết thúc.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 4: Event Visuals -->
            <div class="portal-card">
                <div class="portal-card-header">
                    <h2><i class="fas fa-images"></i> Ảnh sự kiện</h2>
                </div>
                <div class="portal-card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tải ảnh bìa mới (16:9)</label>
                        <div class="preview-box mb-2" id="bannerPreviewContainer" style="height: 140px;">
                            @if (!string.IsNullOrWhiteSpace(Model.AnhBia))
                            {
                                <img src="@Model.AnhBia" alt="Banner" style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">Chưa tải ảnh lên</span>
                            }
                        </div>
                        <input type="file" name="fileAnhBia" id="fileAnhBiaInput" class="form-control mb-2" accept="image/*" onchange="previewUploadImage(this, 'bannerPreviewContainer')" />
                        <input class="form-control" name="anhBia" id="anhBiaInput" value="@Model.AnhBia" oninput="previewImage('anhBiaInput', 'bannerPreviewContainer')" placeholder="Hoặc nhập liên kết URL ảnh bìa" />
                    </div>

                    <div>
                        <label class="form-label fw-bold">Ảnh Thumbnail đại diện (1:1)</label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="preview-thumbnail" id="thumbnailPreviewContainer" style="width: 70px; height: 70px; flex-shrink:0;">
                                @if (!string.IsNullOrWhiteSpace(Model.AnhThumbnail))
                                {
                                    <img src="@Model.AnhThumbnail" alt="Thumbnail" style="width:100%; height:100%; object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">1:1</span>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <input type="file" name="fileAnhThumbnail" id="fileAnhThumbnailInput" class="form-control mb-2" accept="image/*" onchange="previewUploadImage(this, 'thumbnailPreviewContainer')" />
                                <input class="form-control" name="anhThumbnail" id="anhThumbnailInput" value="@Model.AnhThumbnail" oninput="previewImage('anhThumbnailInput', 'thumbnailPreviewContainer')" placeholder="URL ảnh đại diện" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 5: Organizer Info -->
            <div class="portal-card">
                <div class="portal-card-header">
                    <h2><i class="fas fa-user-tie"></i> Ban tổ chức</h2>
                </div>
                <div class="portal-card-body">
                    <div class="mb-3">
                        <label class="form-label">Tên nhà tổ chức <span class="text-danger">*</span></label>
                        <input class="form-control" name="tenToChuc" value="@(currentHoSo?.HoTen ?? "")" required />
                    </div>
                    <div>
                        <label class="form-label">Mô tả về ban tổ chức</label>
                        <textarea class="form-control" name="moTaToChuc" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM ACTIONS -->
    <div class="portal-card">
        <div class="portal-card-body d-flex justify-content-between align-items-center">
            <a class="btn btn-outline-secondary px-4 py-2" href="/Organizer/ChiTietSuKien/@Model.Id">
                <i class="fas fa-xmark me-1"></i> Hủy bỏ
            </a>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary px-4 py-2" name="submitAction" value="draft">
                    <i class="fas fa-floppy-disk me-1"></i> Lưu bản nháp
                </button>
                <button type="submit" class="btn btn-success px-4 py-2" name="submitAction" value="submit" onclick="return validationFinal()">
                    <i class="fas fa-paper-plane me-1"></i> Lưu và gửi duyệt
                </button>
            </div>
        </div>
    </div>
    </fieldset>
</form>

<script>
    // Load Vietnam provinces dynamically from provinces.open-api.vn
    let vietnamDivisions = [];
    const selectedCity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThanhPhoDiaDiem ?? ""));
    const selectedDistrict = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuanHuyenDiaDiem?.Split(',').Last()?.Trim() ?? ""));
    const selectedWard = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuanHuyenDiaDiem?.Split(',').First()?.Trim() ?? ""));

    document.addEventListener("DOMContentLoaded", async function() {
        const citySelect = document.getElementById("tinhThanh");
        
        // Initial min setup for dates
        const startInput = document.getElementById("ngayBatDau");
        const endInput = document.getElementById("ngayKetThuc");
        if (startInput && startInput.value) {
            endInput.min = startInput.value;
        }

        try {
            const response = await fetch("https://provinces.open-api.vn/api/?depth=2");
            vietnamDivisions = await response.json();
            
            vietnamDivisions.forEach(province => {
                const opt = document.createElement("option");
                let cleanName = province.name.replace(/^(Tỉnh|Thành phố)\s+/i, '');
                opt.value = cleanName;
                opt.dataset.code = province.code;
                opt.textContent = province.name;
                if (cleanName === selectedCity) {
                    opt.selected = true;
                }
                citySelect.appendChild(opt);
            });
        } catch (e) {
            console.error("Lỗi khi tải danh sách tỉnh thành: ", e);
            const fallback = ["Hồ Chí Minh", "Hà Nội", "Đà Nẵng", "Cần Thơ", "Hải Phòng", "Bình Dương", "Đồng Nai", "Khánh Hòa", "Lâm Đồng", "Thừa Thiên Huế"];
            fallback.forEach(city => {
                const opt = document.createElement("option");
                opt.value = city;
                opt.textContent = city;
                if (city === selectedCity) {
                    opt.selected = true;
                }
                citySelect.appendChild(opt);
            });
        }

        if (selectedCity) {
            updateDistricts(selectedDistrict, selectedWard);
        }
    });

    async function updateDistricts(preselectedDistrict = "", preselectedWard = "") {
        const citySelect = document.getElementById("tinhThanh");
        const districtSelect = document.getElementById("quanHuyenSelect");
        const wardSelect = document.getElementById("phuongXaSelect");
        const selectedCity = citySelect.value;
        const selectedOpt = citySelect.options[citySelect.selectedIndex];
        const provinceCode = selectedOpt ? selectedOpt.dataset.code : null;

        districtSelect.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
        wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
        document.getElementById("quanHuyenPhuongXa").value = "";

        if (provinceCode && vietnamDivisions.length > 0) {
            const provinceObj = vietnamDivisions.find(p => p.code == provinceCode);
            if (provinceObj && provinceObj.districts) {
                provinceObj.districts.forEach(dist => {
                    const opt = document.createElement("option");
                    opt.value = dist.name;
                    opt.dataset.code = dist.code;
                    opt.textContent = dist.name;
                    if (dist.name === preselectedDistrict) {
                        opt.selected = true;
                    }
                    districtSelect.appendChild(opt);
                });
            }
        } else {
            const fallbackDistricts = {
                "Hồ Chí Minh": ["Quận 1", "Quận 3", "Quận 5", "Quận 10", "Quận Bình Thạnh", "Thành phố Thủ Đức"],
                "Hà Nội": ["Quận Hoàn Kiếm", "Quận Ba Đình", "Quận Cầu Giấy", "Quận Đống Đa", "Quận Hai Bà Trưng"],
                "Đà Nẵng": ["Quận Hải Châu", "Quận Thanh Khê", "Quận Sơn Trà", "Quận Ngũ Hành Sơn"]
            };
            const list = fallbackDistricts[selectedCity] || [];
            list.forEach(dist => {
                const opt = document.createElement("option");
                opt.value = dist;
                opt.textContent = dist;
                if (dist === preselectedDistrict) {
                    opt.selected = true;
                }
                districtSelect.appendChild(opt);
            });
        }

        if (districtSelect.value) {
            await updateWards(preselectedWard);
        }
    }

    async function updateWards(preselectedWard = "") {
        const districtSelect = document.getElementById("quanHuyenSelect");
        const wardSelect = document.getElementById("phuongXaSelect");
        const selectedOpt = districtSelect.options[districtSelect.selectedIndex];
        const districtCode = selectedOpt ? selectedOpt.dataset.code : null;

        wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
        document.getElementById("quanHuyenPhuongXa").value = "";

        if (districtCode) {
            try {
                const response = await fetch(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`);
                const data = await response.json();
                if (data && data.wards) {
                    data.wards.forEach(ward => {
                        const opt = document.createElement("option");
                        opt.value = ward.name;
                        opt.textContent = ward.name;
                        if (ward.name === preselectedWard) {
                            opt.selected = true;
                        }
                        wardSelect.appendChild(opt);
                    });
                }
            } catch (e) {
                console.error("Lỗi khi tải danh sách phường xã: ", e);
            }
        }
        
        if (wardSelect.children.length <= 1) {
            const opt = document.createElement("option");
            opt.value = "Phường trung tâm";
            opt.textContent = "Phường trung tâm";
            if ("Phường trung tâm" === preselectedWard) {
                opt.selected = true;
            }
            wardSelect.appendChild(opt);
        }
        combineAddress();
    }

    function combineAddress() {
        const districtSelect = document.getElementById("quanHuyenSelect");
        const wardSelect = document.getElementById("phuongXaSelect");
        const hiddenInput = document.getElementById("quanHuyenPhuongXa");
        
        hiddenInput.value = districtSelect.value
            ? (wardSelect.value ? `${wardSelect.value}, ${districtSelect.value}` : districtSelect.value)
            : "";
    }

    // Toggle event type between Offline (0) and Online (1)
    function setEventType(type) {
        document.getElementById("loaiSuKien").value = type;
        const btnOffline = document.getElementById("btnOffline");
        const btnOnline = document.getElementById("btnOnline");
        const offlineSec = document.getElementById("offlineSection");
        const onlineSec = document.getElementById("onlineSection");
        const checkinFields = document.querySelectorAll(".offline-checkin-field");

        if (type === 0) {
            btnOffline.classList.add("active");
            btnOnline.classList.remove("active");
            offlineSec.style.display = "block";
            onlineSec.style.display = "none";
            document.getElementById("tenDiaDiem").setAttribute("required", "required");
            document.getElementById("tinhThanh").setAttribute("required", "required");
            document.getElementById("quanHuyenSelect").setAttribute("required", "required");
            document.getElementById("phuongXaSelect").removeAttribute("required");
            document.getElementById("soNhaDuong").setAttribute("required", "required");
            document.getElementById("linkOnline").removeAttribute("required");
            checkinFields.forEach(field => field.style.display = "block");
        } else {
            btnOffline.classList.remove("active");
            btnOnline.classList.add("active");
            offlineSec.style.display = "none";
            onlineSec.style.display = "block";
            document.getElementById("tenDiaDiem").removeAttribute("required");
            document.getElementById("tinhThanh").removeAttribute("required");
            document.getElementById("quanHuyenSelect").removeAttribute("required");
            document.getElementById("phuongXaSelect").removeAttribute("required");
            document.getElementById("soNhaDuong").removeAttribute("required");
            document.getElementById("linkOnline").setAttribute("required", "required");
            checkinFields.forEach(field => field.style.display = "none");
            document.getElementById("batDauCheckIn").value = "";
            document.getElementById("ketThucCheckIn").value = "";
        }
    }

    // Image URL Previewer
    function previewImage(inputId, previewId) {
        const url = document.getElementById(inputId).value;
        const container = document.getElementById(previewId);
        container.replaceChildren();
        if (url && (url.startsWith("http://") || url.startsWith("https://") || url.startsWith("/"))) {
            const image = document.createElement('img');
            image.src = url;
            image.alt = 'Xem trước ảnh bìa';
            image.style.cssText = 'max-width:100%;max-height:100%;object-fit:cover';
            image.onerror = () => { container.textContent = 'Đường dẫn ảnh không hợp lệ'; };
            container.appendChild(image);
        } else {
            container.textContent = 'Xem trước';
        }
    }

    // Image Upload Previewer
    function previewUploadImage(input, previewId) {
        const container = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const image = document.createElement('img');
                image.src = e.target.result;
                image.alt = 'Xem trước ảnh bìa';
                image.style.cssText = 'max-width:100%;max-height:100%;object-fit:cover';
                container.replaceChildren(image);
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            container.textContent = 'Chưa tải ảnh lên';
        }
    }

    // Dynamic Ticket categories adding/deleting
    let ticketIndex = @currentLoaiVes.Count;
    if (ticketIndex === 0) ticketIndex = 1;

    function addTicketRow() {
        const container = document.getElementById("ticketRowsContainer");
        const card = document.createElement("div");
        card.className = "ticket-card";
        card.id = `ticket-row-${ticketIndex}`;
        card.innerHTML = `
            <button type="button" class="remove-ticket-btn" onclick="removeTicketRow(${ticketIndex})"><i class="fas fa-trash-alt"></i></button>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Tên loại vé <span class="text-danger">*</span></label>
                    <input class="form-control" name="tenLoaiVe" placeholder="Vé thường, Vé VIP..." required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Giá vé (VND) <span class="text-danger">*</span></label>
                    <input class="form-control" type="number" name="giaVe" min="0" value="0" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Số lượng tổng <span class="text-danger">*</span></label>
                    <input class="form-control" type="number" name="soLuongVe" min="1" value="100" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Giới hạn mỗi đơn <span class="text-danger">*</span></label>
                    <input class="form-control" type="number" name="gioiHanMoiDon" min="1" value="10" required />
                </div>
            </div>
        `;
        container.appendChild(card);
        ticketIndex++;
    }

    function removeTicketRow(idx) {
        const row = document.getElementById(`ticket-row-${idx}`);
        if (row) row.remove();
    }

    function onStartDateChange() {
        const startInput = document.getElementById("ngayBatDau");
        const endInput = document.getElementById("ngayKetThuc");
        
        if (startInput.value) {
            // Set min attribute for endInput to match startInput value
            endInput.min = startInput.value;
            
            // If end time is empty or before start time, automatically set it to start time + 2 hours
            if (!endInput.value || new Date(endInput.value) <= new Date(startInput.value)) {
                const startDate = new Date(startInput.value);
                const endDate = new Date(startDate.getTime() + 2 * 60 * 60 * 1000); // add 2 hours
                
                // Format back to yyyy-MM-ddTHH:mm in local time
                const tzOffset = endDate.getTimezoneOffset() * 60000;
                const localISOTime = (new Date(endDate.getTime() - tzOffset)).toISOString().slice(0, 16);
                endInput.value = localISOTime;
            }
        }
    }

    function validationFinal() {
        const form = document.getElementById("editForm");
        const inputs = form.querySelectorAll("[required]");
        let valid = true;

        inputs.forEach(input => {
            // Check if element is visible and empty
            if (input.offsetParent !== null && !input.value.trim()) {
                input.classList.add("is-invalid");
                valid = false;
            } else {
                input.classList.remove("is-invalid");
            }
        });

        if (!valid) {
            WuangUI.toast("Vui lòng điền đầy đủ các thông tin bắt buộc trước khi lưu.", "error");
            return false;
        }

        // Validate dates client-side
        const startVal = document.getElementById("ngayBatDau").value;
        const endVal = document.getElementById("ngayKetThuc").value;
        if (startVal && endVal) {
            if (new Date(endVal) <= new Date(startVal)) {
                WuangUI.toast("Thời gian kết thúc sự kiện phải diễn ra sau thời gian bắt đầu.", "error");
                document.getElementById("ngayKetThuc").classList.add("is-invalid");
                return false;
            } else {
                document.getElementById("ngayKetThuc").classList.remove("is-invalid");
            }
        }

        return true;
    }
</script>
