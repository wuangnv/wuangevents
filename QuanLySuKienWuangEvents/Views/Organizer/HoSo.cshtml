@model NguoiDung

@{
    // LƯU Ý: OrganizerController.HoSo() hiện đã vô hiệu hóa và redirect Index.
    // File View này hiện không được render; form POST cũng chưa có action xử lý.
    Layout = "~/Views/Shared/_OrganizerSimpleLayout.cshtml";
    ViewData["Title"] = "Tài khoản thanh toán";
}

<div class="portal-page-title mb-4">
    <span class="portal-kicker"><i class="fas fa-building"></i> Hồ sơ</span>
    <h1>Tài khoản thanh toán</h1>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-xl-7">
            <div class="portal-card h-100">
                <div class="portal-card-header">
                    <h2>Thông tin liên hệ</h2>
                </div>
                <div class="portal-card-body">
                    <div class="mb-3">
                        <label class="form-label">Tên hiển thị / Tên tổ chức</label>
                        <input class="form-control" name="hoTen" value="@Model.HoTen" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại liên hệ</label>
                        <input class="form-control" name="soDienThoai" value="@Model.SoDienThoai" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email tài khoản</label>
                        <input class="form-control" value="@Model.Email" readonly disabled style="background-color: #f3f4f6;" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-5">
            <div class="portal-card">
                <div class="portal-card-header">
                    <h2>Tài khoản ngân hàng</h2>
                </div>
                <div class="portal-card-body">
                    <div class="mb-3">
                        <label class="form-label">Tên ngân hàng</label>
                        <input class="form-control" name="tenNganHang" value="@Model.TenNganHang" placeholder="Ví dụ: Vietcombank, Techcombank..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số tài khoản</label>
                        <input class="form-control" name="soTaiKhoan" value="@Model.SoTaiKhoan" placeholder="Nhập số tài khoản ngân hàng" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Chủ tài khoản</label>
                        <input class="form-control" name="chuTaiKhoan" value="@Model.ChuTaiKhoan" placeholder="Viết hoa không dấu" />
                    </div>
                    <button class="btn btn-success w-100" type="submit">
                        <i class="fas fa-save me-1"></i> Cập nhật hồ sơ
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
