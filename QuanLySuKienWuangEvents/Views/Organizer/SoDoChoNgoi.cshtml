<main class="seat-admin">
    @if (isLocked) { <div class="alert-x alert-error"><i class="fas fa-lock me-2"></i>Sự kiện đang khóa nghiệp vụ hoặc đã kết thúc; không thể thay đổi sơ đồ.</div> }
    @if (TempData["Error"] != null) { <div class="alert-x alert-error"><i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]</div> }
    @if (TempData["Message"] != null) { <div class="alert-x alert-ok"><i class="fas fa-circle-check me-2"></i>@TempData["Message"]</div> }

    <div class="hero-seat"><div><h1><i class="fas fa-chair me-2"></i>Sơ đồ chỗ ngồi</h1><p>@ViewBag.TenSuKien</p></div>
        @if(Model.Id != 0){<form method="post" action="/Organizer/XoaSoDo" data-confirm="Xóa toàn bộ sơ đồ ghế của sự kiện?" data-confirm-title="Xóa sơ đồ ghế" data-confirm-button="Xóa sơ đồ">@Html.AntiForgeryToken()<input type="hidden" name="suKienId" value="@suKienId" /><button class="danger-light" disabled="@(isLocked || dangGiu > 0 || daBan > 0)" title="Không thể xóa khi đã có đơn/vé" type="submit"><i class="fas fa-trash me-1"></i>Xóa sơ đồ</button></form>}
    </div>

    @if (Model.Id != 0)
    {
        <div class="stats"><div class="stat"><strong>@soTrong</strong><span>Ghế trống</span></div><div class="stat"><strong style="color:#d97706">@dangGiu</strong><span>Đang giữ</span></div><div class="stat"><strong style="color:#dc2626">@daBan</strong><span>Đã bán</span></div><div class="stat"><strong style="color:#64748b">@daKhoa</strong><span>Đã khóa</span></div></div>
        <section class="map-box"><div class="map-scroll">
            <div class="saved-layout saved-@boCucDaLuu">
                @{
                    bool coToaDoCanvas = Model.SanKhauX is >= 1 and <= 9 && Model.SanKhauY is >= 1 and <= 12;
                    int sanKhauX = coToaDoCanvas ? Model.SanKhauX!.Value : 5;
                    int sanKhauY = coToaDoCanvas ? Model.SanKhauY!.Value : 1;
                    string nhanSanKhau = boCucDaLuu == "cinema" ? "MÀN HÌNH" : "SÂN KHẤU";
                }
                <div class="saved-stage" style="grid-column:@sanKhauX / span 4;grid-row:@sanKhauY">@nhanSanKhau</div>
                @foreach (var zone in cacKhuVuc)
                {
                    var zoneRows = ghe.GroupBy(x => x.HangGheId)
                        .Where(row => khuVucTheoHang.GetValueOrDefault(row.Key)?.Id == zone.Id)
                        .ToList();
                    int soGheMoiHang = zoneRows.Select(row => row.Count()).DefaultIfEmpty(1).Max();
                    int soHangKhu = zoneRows.Count;
                    int zoneRong = Math.Clamp((int)Math.Ceiling(soGheMoiHang / 3d), 1, 12);
                    int zoneCao = Math.Clamp((int)Math.Ceiling(soHangKhu / 2d), 1, 12);
                    int zoneColumn = coToaDoCanvas && zone.ViTriX is >= 1 and <= 12
                        ? zone.ViTriX.Value : ((zone.ThuTu - 1) % 3) * 4 + 1;
                    int zoneRow = coToaDoCanvas && zone.ViTriY is >= 1 and <= 12
                        ? zone.ViTriY.Value : ((zone.ThuTu - 1) / 3) * 5 + 3;
                    <section class="saved-zone" style="--saved-zone-color:@(zone.MauSac ?? "#7c3aed");--zone-column:@zoneColumn;--zone-row:@zoneRow;--zone-span-x:@zoneRong;--zone-span-y:@zoneCao">
                        <div class="saved-zone-title">@zone.TenKhuVuc</div>
                        <div class="saved-zone-scroll">
                            @foreach (var row in zoneRows)
                            {
                                <div class="seat-row"><span class="row-label">@hang.GetValueOrDefault(row.Key)</span>@foreach(var seat in row){
                                    string cls=seat.TrangThai==1?"seat-btn seat-held":seat.TrangThai==2?"seat-btn seat-sold":seat.TrangThai==3?"seat-btn seat-locked":"seat-btn";
                                    bool disabled=isLocked || seat.TrangThai is 1 or 2;
                                    <form method="post" action="/Organizer/DoiTrangThaiGhe" style="margin:0">@Html.AntiForgeryToken()<input type="hidden" name="suKienId" value="@suKienId" /><input type="hidden" name="seatId" value="@seat.Id" /><button class="@cls" type="@(disabled?"button":"submit")" disabled="@disabled" title="@(seat.TrangThai==0?"Bấm để khóa":seat.TrangThai==3?"Bấm để mở khóa":seat.TrangThai==1?"Đang được khách giữ":"Đã bán")">@seat.SoGhe</button></form>
                                }</div>
                            }
                        </div>
                    </section>
                }
            </div>
            <div class="legend"><span><i style="background:#f5f3ff;border:1px solid #c4b5fd"></i>Trống</span><span><i style="background:#fef3c7;border:1px solid #f59e0b"></i>Đang giữ</span><span><i style="background:#fee2e2;border:1px solid #fca5a5"></i>Đã bán</span><span><i style="background:#e2e8f0;border:1px solid #cbd5e1"></i>Đã khóa</span></div>
        </section>
    }
    else if (!loaiVes.Any())
    {
        <div class="alert-x alert-error">Vui lòng <a href="/Organizer/LoaiVe?suKienId=@suKienId">tạo loại vé</a> trước khi thiết lập sơ đồ.</div>
    }
    else
    {
        <section class="builder">
            <div class="builder-head"><div><h2>Mẫu bố trí</h2></div></div>
            <div class="template-grid">
                <button type="button" class="seat-template active" data-template="auditorium" onclick="applyTemplate('auditorium')"><span class="template-preview preview-auditorium"><i></i><i></i><i></i></span><span><strong>Hội nghị / hội trường</strong><small>Ba khối ghế và lối đi giữa</small></span></button>
                <button type="button" class="seat-template" data-template="theatre" onclick="applyTemplate('theatre')"><span class="template-preview preview-theatre"><i></i><i></i><i></i></span><span><strong>Nhà hát</strong><small>Tầng trệt, hai cánh, ban công</small></span></button>
                <button type="button" class="seat-template" data-template="cinema" onclick="applyTemplate('cinema')"><span class="template-preview preview-cinema"><i></i><i></i><i></i></span><span><strong>Rạp chiếu phim</strong><small>Màn hình, VIP trung tâm, hàng sau</small></span></button>
                <button type="button" class="seat-template" data-template="concert" onclick="applyTemplate('concert')"><span class="template-preview preview-concert"><i></i><i></i><i></i></span><span><strong>Concert có ghế ngồi</strong><small>VIP gần sân khấu, CAT hai bên</small></span></button>
                <button type="button" class="seat-template" data-template="custom" onclick="applyCustomLayout()"><span class="template-preview preview-custom">+</span><span><strong>Tùy chỉnh</strong><small>Tự vẽ bố cục ghế</small></span></button>
            </div>
            <div class="layout-preview">
                <div class="layout-preview-head"><div class="layout-preview-title-wrap"><div class="layout-preview-title">Bố trí sơ đồ</div><span id="mapSummary" class="map-summary"><i class="fas fa-chair"></i>0 ghế</span></div><div class="map-zoom-controls" aria-label="Thu phóng sơ đồ"><button type="button" id="zoomOut" title="Thu nhỏ" aria-label="Thu nhỏ">−</button><output id="zoomValue">100%</output><button type="button" id="zoomIn" title="Phóng to" aria-label="Phóng to">+</button></div></div>
                <div class="map-design-surface"><div id="previewZones" class="preview-zones layout-auditorium"></div></div>
                <div id="mapTicketLegend" class="map-ticket-legend"></div>
                <div id="templateCustomize" class="template-customize"><span><i class="fas fa-lock me-1"></i>Mẫu chuẩn</span><button type="button" id="cloneTemplate"><i class="fas fa-copy me-1"></i>Dùng làm bản tùy chỉnh</button></div>
            </div>
            <form method="post" action="/Organizer/TaoSoDo" id="mapForm">
                @Html.AntiForgeryToken()<input type="hidden" name="suKienId" value="@suKienId" /><input type="hidden" name="loaiSoDo" id="mapType" value="auditorium" /><input type="hidden" name="sanKhauX" id="stageX" value="5" /><input type="hidden" name="sanKhauY" id="stageY" value="1" />
                <div class="field mb-3" style="max-width:460px"><label>Tên sơ đồ</label><input id="mapName" name="tenSoDo" value="Hội trường - @ViewBag.TenSuKien" maxlength="200" required /></div>
                <div class="draw-toolbar" id="drawToolbar"><div class="field"><label>Loại vé đang vẽ</label><select id="drawingTicket"></select></div><div class="tool-group"><button type="button" class="tool-btn select-tool" id="selectTool"><i class="fas fa-arrow-pointer me-1"></i>Chọn khu</button><button type="button" class="tool-btn active" id="drawTool"><i class="fas fa-pen-ruler me-1"></i>Vẽ khu ghế</button><button type="button" class="tool-btn" id="stageTool"><i class="fas fa-arrows-up-down-left-right me-1"></i>Đặt sân khấu</button></div></div>
                <div id="zoneInspector" class="zone-inspector" hidden></div>
                <div class="zone-list-title" id="zoneListTitle" hidden><span>Danh sách khu vực</span><span id="zoneCount"></span></div><div id="zoneList" class="zone-list"></div>
                <div class="builder-actions"><button type="button" class="add-zone" onclick="addZone()"><i class="fas fa-plus me-1"></i>Thêm khu vực</button><button type="submit" class="save-map" disabled="@isLocked"><i class="fas fa-save me-1"></i>Tạo sơ đồ</button></div>
            </form>
            <div class="none-box"><span><strong>Hình thức bán vé</strong></span><form method="post" action="/Organizer/TaoSoDo">@Html.AntiForgeryToken()<input type="hidden" name="suKienId" value="@suKienId" /><input type="hidden" name="tenSoDo" value="Không dùng sơ đồ" /><input type="hidden" name="loaiSoDo" value="none" /><button type="submit" disabled="@isLocked">Bán vé không chọn ghế</button></form></div>
        </section>
    }
</main>

@if(Model.Id == 0 && loaiVes.Any()){
@section Scripts {
<script>
const ticketTypes=@Html.Raw(loaiVeJson);
const eventName=@Html.Raw(tenSuKienJson);
const dragDropEditorEnabled=@(suDungKeoTha ? "true" : "false");
const canvasColumns=12, canvasRows=12, stageWidth=4;
let zones=[], stage={x:5,y:1}, stagePlacementMode=false, activeTool='draw', previewZoom=1, selectedZoneIndex=-1;
const seatTemplates={auditorium:{label:'Hội nghị / hội trường'},theatre:{label:'Nhà hát'},cinema:{label:'Rạp chiếu phim'},concert:{label:'Concert có ghế ngồi'}};
const ticketById=id=>ticketTypes.find(ticket=>Number(ticket.id)===Number(id));
const zoneWidth=zone=>Math.max(1,Math.min(canvasColumns,Math.ceil(Number(zone.cols)/3)));
const zoneHeight=zone=>Math.max(1,Math.min(canvasRows,Math.ceil(Number(zone.rows)/2)));
const zoneCapacity=zone=>Number(zone.rows)*Number(zone.cols);
const usedSeats=ticketId=>zones.filter(zone=>Number(zone.ticketId)===Number(ticketId)).reduce((sum,zone)=>sum+zoneCapacity(zone),0);
const overlap=(a,b)=>a.x<=b.x+b.w-1&&a.x+a.w-1>=b.x&&a.y<=b.y+b.h-1&&a.y+a.h-1>=b.y;
function fitZone(name,ticket,x,y,w,h,allocated){
    const available=Number(ticket.total)-(allocated.get(ticket.id)||0);if(available<1)return null;
    const maxCols=w*3,maxRows=h*2,capacity=Math.min(available,maxCols*maxRows);
    const idealCols=Math.round(Math.sqrt(capacity*maxCols/maxRows));
    const cols=Math.max(1,Math.min(maxCols,idealCols));
    const rows=Math.max(1,Math.min(maxRows,Math.floor(capacity/cols)));
    const zone={name,ticketId:ticket.id,rows,cols,color:ticket.color||'#7c3aed',x,y};
    allocated.set(ticket.id,(allocated.get(ticket.id)||0)+zoneCapacity(zone));
    return zone;
}
function canvasPosition(event){const rect=document.getElementById('previewZones').getBoundingClientRect();return {x:Math.max(1,Math.min(canvasColumns,Math.floor((event.clientX-rect.left)/rect.width*canvasColumns)+1)),y:Math.max(1,Math.min(canvasRows,Math.floor((event.clientY-rect.top)/rect.height*canvasRows)+1))};}
function isFree(x,y,w,h,ignoreIndex=-1,ignoreStage=false){
    if(x<1||y<1||x+w-1>canvasColumns||y+h-1>canvasRows)return false;
    if(!ignoreStage&&overlap({x,y,w,h},{x:stage.x,y:stage.y,w:stageWidth,h:1}))return false;
    return !zones.some((zone,index)=>index!==ignoreIndex&&overlap({x,y,w,h},{x:Number(zone.x),y:Number(zone.y),w:zoneWidth(zone),h:zoneHeight(zone)}));
}
function isFreeInTemplate(result,x,y,w,h){
    if(x<1||y<1||x+w-1>canvasColumns||y+h-1>canvasRows)return false;
    if(overlap({x,y,w,h},{x:stage.x,y:stage.y,w:stageWidth,h:1}))return false;
    return !result.some(zone=>overlap({x,y,w,h},{x:Number(zone.x),y:Number(zone.y),w:zoneWidth(zone),h:zoneHeight(zone)}));
}
function fillTicketChoices(){const select=document.getElementById('drawingTicket');select.innerHTML='';ticketTypes.forEach(ticket=>{const option=document.createElement('option');option.value=ticket.id;option.textContent=ticket.name+' · '+new Intl.NumberFormat('vi-VN').format(ticket.price)+'đ';select.appendChild(option);});}
function templateZone(result,allocated,name,ticket,x,y,w,h){if(!ticket||result.length>=20)return;const zone=fitZone(name+' · '+ticket.name,ticket,x,y,w,h,allocated);if(zone&&isFreeInTemplate(result,zone.x,zone.y,zoneWidth(zone),zoneHeight(zone)))result.push(zone);}
function buildPreset(key){
    const tickets=[...ticketTypes].sort((a,b)=>Number(b.price)-Number(a.price));
    const premium=tickets[0],upper=tickets[1]||premium,middle=tickets[2]||upper,standard=tickets[tickets.length-1]||premium,sweetbox=tickets.find(ticket=>/(sweet|cặp|doi|đôi)/i.test(ticket.name))||middle,allocated=new Map(),result=[];
    if(!premium)return result;
    if(key==='auditorium'){
        templateZone(result,allocated,'Khối A - trái',standard,1,4,3,6);templateZone(result,allocated,'Khối B - trung tâm',premium,5,4,4,4);templateZone(result,allocated,'Khối C - phải',upper,10,4,3,6);templateZone(result,allocated,'Khối ghế phía sau',middle,4,11,6,2);
    }else if(key==='theatre'){
        templateZone(result,allocated,'Tầng trệt - trung tâm',premium,5,3,4,3);templateZone(result,allocated,'Tầng trệt - trái',upper,1,7,3,3);templateZone(result,allocated,'Tầng trệt - phải',middle,10,7,3,3);templateZone(result,allocated,'Ban công',standard,4,11,6,2);
    }else if(key==='cinema'){
        templateZone(result,allocated,'Ghế thường - gần màn hình',standard,2,3,10,2);templateZone(result,allocated,'Ghế VIP - trung tâm',premium,4,6,6,3);templateZone(result,allocated,'Hàng ghế sau - trái',upper,2,10,5,3);templateZone(result,allocated,'Hàng ghế sau - phải',sweetbox,7,10,5,3);
    }else if(key==='concert'){
        templateZone(result,allocated,'Khu SVIP / VIP - trung tâm',premium,4,3,6,3);templateZone(result,allocated,'Khu CAT A - trái',upper,1,7,3,3);templateZone(result,allocated,'Khu CAT B - phải',middle,10,7,3,3);templateZone(result,allocated,'Khán đài phía sau',standard,4,11,6,2);
    }
    return result;
}
function applyTemplate(key){
    const template=seatTemplates[key]||seatTemplates.auditorium;stage={x:5,y:1};zones=buildPreset(key);selectedZoneIndex=-1;activeTool='draw';document.getElementById('mapType').value=key;document.getElementById('mapName').value=template.label+' - '+eventName;document.querySelectorAll('.seat-template').forEach(button=>button.classList.toggle('active',button.dataset.template===key));renderZones();
}
function applyCustomLayout(){stage={x:5,y:1};zones=[];selectedZoneIndex=-1;activeTool='draw';document.getElementById('mapType').value='custom';document.getElementById('mapName').value='Sơ đồ tùy chỉnh - '+eventName;document.querySelectorAll('.seat-template').forEach(button=>button.classList.toggle('active',button.dataset.template==='custom'));renderZones();}
function cloneTemplateToCustom(){
    if(document.getElementById('mapType').value==='custom')return;
    zones=zones.map(zone=>({...zone,name:(zone.name||'Khu vực').split(' · ')[0]}));
    selectedZoneIndex=zones.length?0:-1;activeTool='select';document.getElementById('mapType').value='custom';document.getElementById('mapName').value='Bản tùy chỉnh - '+eventName;
    document.querySelectorAll('.seat-template').forEach(button=>button.classList.toggle('active',button.dataset.template==='custom'));
    renderZones();WuangUI.toast('Đã tạo bản tùy chỉnh từ mẫu đã chọn.', 'success');
}
function addZone(){
    const ticket=ticketById(document.getElementById('drawingTicket').value)||ticketTypes[0];
    if(usedSeats(ticket.id)>=Number(ticket.total)){WuangUI.toast(`Loại vé ${ticket.name} không còn ghế để bố trí.`, 'error');return;}
    const allocated=new Map([[ticket.id,usedSeats(ticket.id)]]);
    for(let y=1;y<=canvasRows-1;y++)for(let x=1;x<=canvasColumns-2;x++)if(isFree(x,y,3,2)){const zone=fitZone('Khu vực '+(zones.length+1),ticket,x,y,3,2,allocated);if(zone){zones.push(zone);selectedZoneIndex=zones.length-1;renderZones();return;}}
    WuangUI.toast('Không còn khoảng trống cho khu ghế mới.', 'error');
}
function removeZone(index){zones.splice(index,1);selectedZoneIndex=zones.length?Math.min(index,zones.length-1):-1;renderZones();}
function updateZone(index,key,value){
    const zone=zones[index];if(!zone)return;
    if(key==='ticketId'){
        const ticket=ticketById(value),capacity=zoneCapacity(zone),others=zones.filter((item,itemIndex)=>itemIndex!==index&&Number(item.ticketId)===Number(value)).reduce((sum,item)=>sum+zoneCapacity(item),0);
        if(!ticket||others+capacity>Number(ticket.total)){WuangUI.toast('Loại vé được chọn không còn đủ số lượng để gán cho khu này.', 'error');return;}
        zone.ticketId=Number(value);zone.color=ticket.color||'#7c3aed';
    }else zone[key]=value;
    renderZones();
}
function setZoneDimensions(index,rows,cols){
    const zone=zones[index],ticket=zone&&ticketById(zone.ticketId);if(!zone||!ticket)return;
    rows=Math.max(1,Math.min(canvasRows*2,Number(rows)));cols=Math.max(1,Math.min(canvasColumns*3,Number(cols)));
    const width=Math.ceil(cols/3),height=Math.ceil(rows/2),x=Math.min(Number(zone.x),canvasColumns-width+1),y=Math.min(Number(zone.y),canvasRows-height+1);
    const others=zones.filter((item,itemIndex)=>itemIndex!==index&&Number(item.ticketId)===Number(zone.ticketId)).reduce((sum,item)=>sum+zoneCapacity(item),0);
    if(others+rows*cols>Number(ticket.total)){WuangUI.toast(`Loại vé ${ticket.name} không đủ số lượng cho kích thước này.`, 'error');return;}
    if(!isFree(x,y,width,height,index)){WuangUI.toast('Kích thước mới đang chồng lên sân khấu hoặc khu khác.', 'error');return;}
    zone.rows=rows;zone.cols=cols;zone.x=x;zone.y=y;selectedZoneIndex=index;renderZones();
}
function duplicateSelectedZone(){
    const source=zones[selectedZoneIndex],ticket=source&&ticketById(source.ticketId);if(!source||!ticket)return;
    const width=zoneWidth(source),height=zoneHeight(source),capacity=zoneCapacity(source);
    if(usedSeats(source.ticketId)+capacity>Number(ticket.total)){WuangUI.toast(`Loại vé ${ticket.name} không còn đủ ghế để nhân bản khu vực.`, 'error');return;}
    for(let y=1;y<=canvasRows-height+1;y++)for(let x=1;x<=canvasColumns-width+1;x++)if(isFree(x,y,width,height)){
        zones.push({...source,name:source.name+' (bản sao)',x,y});selectedZoneIndex=zones.length-1;renderZones();return;
    }
    WuangUI.toast('Không còn khoảng trống để nhân bản khu vực.', 'error');
}
function createPreviewZone(zone,index,editable){
    const block=document.createElement('div');block.className='preview-zone'+(index===selectedZoneIndex?' selected-zone':'');block.style.setProperty('--preview-color',zone.color);block.style.gridColumn=zone.x+' / span '+zoneWidth(zone);block.style.gridRow=zone.y+' / span '+zoneHeight(zone);
    if(editable){
        const handle=document.createElement('span');handle.className='drag-handle';handle.innerHTML='<i class="fas fa-arrows-up-down-left-right"></i>';block.append(handle);
        const resize=document.createElement('button');resize.type='button';resize.className='resize-handle';resize.title='Kéo để đổi kích thước';resize.setAttribute('aria-label','Kéo để đổi kích thước khu vực');resize.innerHTML='<i class="fas fa-up-right-and-down-left-from-center"></i>';block.append(resize);
        bindPointerMove(block,(x,y)=>moveZoneTo(index,x,y),()=>{selectedZoneIndex=index;});bindResize(resize,index);
    }
    const name=document.createElement('strong');name.className='preview-zone-name';name.textContent=zone.name;
    const seats=document.createElement('div');seats.className='mini-seat-grid';const visualRows=Math.min(6,Math.max(1,Number(zone.rows))),visualCols=Math.min(12,Math.max(1,Number(zone.cols)));seats.style.setProperty('--mini-cols',visualCols);
    for(let row=0;row<visualRows;row++)for(let col=0;col<visualCols;col++){const seat=document.createElement('i');seat.className='mini-seat';seats.appendChild(seat);}
    const size=document.createElement('small');size.textContent=zoneCapacity(zone)+' ghế';block.append(name,seats,size);return block;
}
function stageTitle(){return document.getElementById('mapType').value==='cinema'?'MÀN HÌNH':'SÂN KHẤU';}
function createStage(editable){const block=document.createElement('div');block.className='preview-stage';block.style.gridColumn=stage.x+' / span '+stageWidth;block.style.gridRow=stage.y;block.innerHTML=(editable?'<i class="fas fa-arrows-up-down-left-right"></i> ':'')+stageTitle();if(editable)bindPointerMove(block,(x,y)=>moveStageTo(x,y));return block;}
function bindPointerMove(element,onDrop,onStart){element.addEventListener('pointerdown',event=>{if(event.button!==0||event.target.closest('.resize-handle'))return;event.preventDefault();event.stopPropagation();const startX=event.clientX,startY=event.clientY;onStart?.();element.classList.add('dragging');const finish=up=>{document.removeEventListener('pointerup',finish);element.classList.remove('dragging');if(Math.hypot(up.clientX-startX,up.clientY-startY)<8){if(onStart)renderZones();return;}const point=canvasPosition(up);onDrop(point.x,point.y);};document.addEventListener('pointerup',finish);});}
function bindResize(handle,index){handle.addEventListener('pointerdown',event=>{if(event.button!==0)return;event.preventDefault();event.stopPropagation();const finish=up=>{document.removeEventListener('pointerup',finish);const zone=zones[index];if(!zone)return;const point=canvasPosition(up);setZoneDimensions(index,Math.max(1,(point.y-Number(zone.y)+1)*2),Math.max(1,(point.x-Number(zone.x)+1)*3));};document.addEventListener('pointerup',finish);});}
function moveZoneTo(index,x,y){const zone=zones[index],w=zoneWidth(zone),h=zoneHeight(zone);x=Math.min(x,canvasColumns-w+1);y=Math.min(y,canvasRows-h+1);if(!isFree(x,y,w,h,index)){WuangUI.toast('Vị trí này đang được sử dụng.', 'error');return;}zone.x=x;zone.y=y;selectedZoneIndex=index;renderZones();}
function moveStageTo(x,y){x=Math.min(x,canvasColumns-stageWidth+1);if(!isFree(x,y,stageWidth,1,-1,true)){WuangUI.toast('Sân khấu không được chồng lên khu ghế.', 'error');return;}stage={x,y};setActiveTool('select',false);renderZones();}
function drawZone(start,end){const x=Math.min(start.x,end.x),y=Math.min(start.y,end.y),w=Math.abs(start.x-end.x)+1,h=Math.abs(start.y-end.y)+1;if(!isFree(x,y,w,h)){WuangUI.toast('Vùng này đang chồng lên sân khấu hoặc khu ghế khác.', 'error');return;}const ticket=ticketById(document.getElementById('drawingTicket').value)||ticketTypes[0],capacity=w*h*6;if(usedSeats(ticket.id)+capacity>Number(ticket.total)){WuangUI.toast(`Loại vé ${ticket.name} chỉ còn ${Math.max(0,Number(ticket.total)-usedSeats(ticket.id))} ghế để bố trí.`, 'error');return;}zones.push({name:'Khu vực '+(zones.length+1),ticketId:ticket.id,rows:h*2,cols:w*3,color:ticket.color||'#7c3aed',x,y});selectedZoneIndex=zones.length-1;setActiveTool('select',false);renderZones();}
function renderPreview(){
    const preview=document.getElementById('previewZones');preview.innerHTML='';document.getElementById('stageX').value=stage.x;document.getElementById('stageY').value=stage.y;
    const editable=document.getElementById('mapType').value==='custom';
    preview.style.zoom=String(previewZoom);
    if(!dragDropEditorEnabled){preview.className='preview-zones layout-'+document.getElementById('mapType').value;zones.forEach((zone,index)=>preview.appendChild(createPreviewZone(zone,index,editable)));return;}
    preview.className='preview-zones drag-layout'+(editable?' custom-tool-'+activeTool:' template-locked');
    for(let y=1;y<=canvasRows;y++)for(let x=1;x<=canvasColumns;x++){const slot=document.createElement('div');slot.className='drop-slot';slot.style.gridColumn=x;slot.style.gridRow=y;preview.appendChild(slot);}
    preview.appendChild(createStage(editable));zones.forEach((zone,index)=>preview.appendChild(createPreviewZone(zone,index,editable)));
    preview.onpointerdown=editable?event=>{if(!event.target.closest('.drop-slot'))return;const start=canvasPosition(event);if(stagePlacementMode){moveStageTo(start.x,start.y);return;}if(activeTool!=='draw')return;preview.classList.add('drawing');const finish=up=>{document.removeEventListener('pointerup',finish);preview.classList.remove('drawing');drawZone(start,canvasPosition(up));};document.addEventListener('pointerup',finish);}:null;
}
function hiddenInput(parent,name,value){const input=document.createElement('input');input.type='hidden';input.name=name;input.value=value;parent.appendChild(input);}
function renderZones(){
    const list=document.getElementById('zoneList');list.innerHTML='';
    const editable=document.getElementById('mapType').value==='custom';if(!editable){activeTool='draw';selectedZoneIndex=-1;}if(selectedZoneIndex>=zones.length)selectedZoneIndex=zones.length-1;
    stagePlacementMode=activeTool==='stage';document.getElementById('drawToolbar').hidden=!editable;document.querySelector('.add-zone').hidden=!editable;document.getElementById('zoneListTitle').hidden=!editable;document.getElementById('zoneCount').textContent=zones.length+' khu';syncEditorChrome();renderZoneInspector(editable);
    zones.forEach((zone,index)=>{
        const ticket=ticketById(zone.ticketId),card=document.createElement('div');card.className='zone-card'+(editable?'':' template-zone-card')+(index===selectedZoneIndex?' selected-card':'');card.style.setProperty('--zone-color',zone.color);
        const head=document.createElement('div');head.className='zone-head';const title=document.createElement('strong');title.textContent=editable?(zone.name||'Khu vực '+(index+1)):zone.name;const caption=document.createElement('span');caption.className='zone-capacity';caption.textContent=(ticket?.name||'Loại vé')+' · '+zoneCapacity(zone)+' ghế';head.append(title,caption);card.append(head);
        if(editable)card.onclick=()=>{selectedZoneIndex=index;setActiveTool('select',false);renderZones();};
        hiddenInput(card,'zoneTen',zone.name);hiddenInput(card,'zoneLoaiVeId',zone.ticketId);hiddenInput(card,'zoneSoHang',zone.rows);hiddenInput(card,'zoneSoGheMoiHang',zone.cols);hiddenInput(card,'zoneMauSac',zone.color);hiddenInput(card,'zoneViTriX',zone.x);hiddenInput(card,'zoneViTriY',zone.y);list.appendChild(card);
    });
    const total=zones.reduce((sum,zone)=>sum+zoneCapacity(zone),0),summary=document.getElementById('mapSummary');summary.innerHTML='<i class="fas fa-chair"></i>'+total+' ghế · '+zones.length+' khu';renderMapLegend();renderPreview();
}
function renderZoneInspector(editable){
    const inspector=document.getElementById('zoneInspector');inspector.innerHTML='';
    if(!editable||!zones.length){inspector.hidden=true;return;}
    if(selectedZoneIndex<0)selectedZoneIndex=0;const index=selectedZoneIndex,zone=zones[index],ticket=ticketById(zone.ticketId);inspector.hidden=false;
    const head=document.createElement('div');head.className='zone-inspector-head';const heading=document.createElement('strong');heading.textContent='Khu đang chỉnh: '+(zone.name||'Khu vực '+(index+1));const capacity=document.createElement('span');capacity.textContent=zoneCapacity(zone)+' ghế · '+(ticket?.name||'');head.append(heading,capacity);
    const grid=document.createElement('div');grid.className='zone-inspector-grid';
    const nameInput=document.createElement('input');nameInput.value=zone.name;nameInput.maxLength=100;nameInput.required=true;nameInput.addEventListener('change',event=>updateZone(index,'name',event.target.value.trim()||'Khu vực '+(index+1)));grid.append(wrap('Tên khu vực',nameInput));
    const ticketSelect=document.createElement('select');ticketTypes.forEach(item=>{const option=document.createElement('option');option.value=item.id;option.textContent=item.name+' · '+new Intl.NumberFormat('vi-VN').format(item.price)+'đ';option.selected=Number(item.id)===Number(zone.ticketId);ticketSelect.append(option);});ticketSelect.addEventListener('change',event=>updateZone(index,'ticketId',event.target.value));grid.append(wrap('Loại vé',ticketSelect));
    const actions=document.createElement('div');actions.className='inspector-actions';const duplicate=document.createElement('button');duplicate.type='button';duplicate.className='duplicate-zone';duplicate.innerHTML='<i class="fas fa-copy me-1"></i>Nhân bản';duplicate.onclick=duplicateSelectedZone;const remove=document.createElement('button');remove.type='button';remove.className='remove-selected-zone';remove.innerHTML='<i class="fas fa-trash me-1"></i>Xóa khu';remove.onclick=()=>removeZone(index);actions.append(duplicate,remove);grid.append(actions);
    const rows=makeStepper('Hàng ghế',zone.rows,value=>setZoneDimensions(index,value,zone.cols));const cols=makeStepper('Ghế mỗi hàng',zone.cols,value=>setZoneDimensions(index,zone.rows,value));const steps=document.createElement('div');steps.className='designer-mode';steps.append(rows,cols);inspector.append(head,grid,steps);
}
function makeStepper(label,value,change){const field=document.createElement('div');field.className='field';const labelNode=document.createElement('label');labelNode.textContent=label;const control=document.createElement('div');control.className='zone-stepper';const decrease=document.createElement('button');decrease.type='button';decrease.textContent='−';decrease.setAttribute('aria-label','Giảm '+label);decrease.onclick=()=>change(Number(value)-1);const display=document.createElement('strong');display.textContent=value;const increase=document.createElement('button');increase.type='button';increase.textContent='+';increase.setAttribute('aria-label','Tăng '+label);increase.onclick=()=>change(Number(value)+1);control.append(decrease,display,increase);field.append(labelNode,control);return field;}
function wrap(label,input){const div=document.createElement('div');div.className='field';const lab=document.createElement('label');lab.textContent=label;div.append(lab,input);return div;}
function textField(label,name,value,onchange){const input=document.createElement('input');input.name=name;input.value=value;input.required=true;input.maxLength=100;input.oninput=e=>onchange(e.target.value);return wrap(label,input);}
function selectField(label,name,value,onchange){const select=document.createElement('select');select.name=name;ticketTypes.forEach(ticket=>{const option=document.createElement('option');option.value=ticket.id;option.textContent=ticket.name+' ('+new Intl.NumberFormat('vi-VN').format(ticket.price)+'đ · '+ticket.total+' vé)';option.selected=ticket.id===Number(value);select.appendChild(option);});select.onchange=e=>onchange(e.target.value);return wrap(label,select);}
function syncEditorChrome(){
    const editable=document.getElementById('mapType').value==='custom';
    document.getElementById('templateCustomize').hidden=editable;
    document.getElementById('selectTool').classList.toggle('active',activeTool==='select');
    document.getElementById('drawTool').classList.toggle('active',activeTool==='draw');
    document.getElementById('stageTool').classList.toggle('active',activeTool==='stage');
}
function setActiveTool(tool,shouldRender=true){activeTool=tool;stagePlacementMode=tool==='stage';syncEditorChrome();if(shouldRender)renderPreview();}
function renderMapLegend(){
    const legend=document.getElementById('mapTicketLegend');legend.innerHTML='';
    ticketTypes.forEach(ticket=>{const item=document.createElement('span');item.className='map-ticket-key';item.style.setProperty('--ticket-color',ticket.color||'#7c3aed');item.innerHTML='<i></i>'+ticket.name+' · '+new Intl.NumberFormat('vi-VN').format(ticket.price)+'đ';legend.appendChild(item);});
}
function setPreviewZoom(value){previewZoom=Math.max(.7,Math.min(1.3,value));document.getElementById('zoomValue').textContent=Math.round(previewZoom*100)+'%';document.getElementById('previewZones').style.zoom=String(previewZoom);}
document.getElementById('selectTool').addEventListener('click',()=>setActiveTool('select'));
document.getElementById('drawTool').addEventListener('click',()=>setActiveTool('draw'));
document.getElementById('stageTool').addEventListener('click',()=>setActiveTool(activeTool==='stage'?'draw':'stage'));
document.getElementById('cloneTemplate').addEventListener('click',cloneTemplateToCustom);
document.getElementById('zoomOut').addEventListener('click',()=>setPreviewZoom(previewZoom-.1));
document.getElementById('zoomIn').addEventListener('click',()=>setPreviewZoom(previewZoom+.1));
document.getElementById('mapForm').addEventListener('submit',event=>{const use=new Map();let total=0;if(!zones.length){event.preventDefault();WuangUI.toast('Hãy tạo ít nhất một khu ghế.', 'error');return;}for(const zone of zones){const count=zoneCapacity(zone);total+=count;use.set(Number(zone.ticketId),(use.get(Number(zone.ticketId))||0)+count);if(!isFree(Number(zone.x),Number(zone.y),zoneWidth(zone),zoneHeight(zone),zones.indexOf(zone))){event.preventDefault();WuangUI.toast('Có khu ghế chồng lên nhau hoặc lên sân khấu.', 'error');return;}}if(total>5000){event.preventDefault();WuangUI.toast('Một sơ đồ được tối đa 5.000 ghế.', 'error');return;}for(const [id,count] of use){const ticket=ticketById(id);if(!ticket||count>ticket.total){event.preventDefault();WuangUI.toast(`Loại vé ${ticket?.name||id} chỉ có ${ticket?.total||0} vé nhưng đang được gán ${count} ghế.`, 'error');return;}}});
fillTicketChoices();applyTemplate('auditorium');
</script>
}}
