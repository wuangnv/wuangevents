function addBanquetTable() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const tableNo = zones.filter(z => z.type === 'banquet').length + 1;
    const z = makeZone('Bàn ' + String(tableNo).padStart(2, '0'), t.id, 'banquet', 1, 10,
        80 + ((tableNo - 1) % 5) * 180, 180 + Math.floor((tableNo - 1) / 5) * 120, t.color || '#c2410c');
    z.prefix = 'B' + String(tableNo).padStart(2, '0');
