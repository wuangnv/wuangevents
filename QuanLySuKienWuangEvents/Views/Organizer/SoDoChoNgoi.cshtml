                    <div class="props-tab-bar">
                        <button class="props-tab active" onclick="switchPropsTab('zone',this)">Khu vực</button>
                        <button class="props-tab" onclick="switchPropsTab('seats',this)" id="tabSeats">Hàng &amp; Ghế</button>
