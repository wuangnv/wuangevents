</main>

@section Scripts {
<script src="https://unpkg.com/konva@9/konva.min.js"></script>
<script>
const EVENT_ID = '@suKienId';
const TICKET_TYPES = @Html.Raw(loaiVeJson);
const EVENT_NAME = @Html.Raw(tenSuKienJson);
const STUDIO_DRAFT_KEY = `wuangevents:seat-map-draft:${EVENT_ID}`;
const SKIP_LETTERS = new Set(['I','O','Q','V','U']);
const GRID = 20; // snap grid px
const MAP_WIDTH = 1200, MAP_HEIGHT = 800;
const SEAT_W = 28, SEAT_H = 24, SEAT_GAP = 4;
const ROW_LABEL_W = 26, ROW_GAP = 6;
const ZONE_PAD = 12, ZONE_HEADER_H = 32;

let currentPreset = 'workshop';
let zones = []; // Array of zone objects
let selectedZoneId = null;
let undoStack = [], redoStack = [];
let konvaStage, konvaLayer, konvaBgLayer;
let stageGroup = null;
let stageConfig = { x: 400, y: 36, width: 400, height: 64, title: 'BỤC DIỄN GIẢ / MÀN HÌNH' };

function saveStudioDraft() {
    if (!document.getElementById('studioForm')) return;
    try {
        sessionStorage.setItem(STUDIO_DRAFT_KEY, JSON.stringify({
            version: 1,
            preset: currentPreset,
            name: document.getElementById('tenSoDoField')?.value || '',
            stage: stageConfig,
            zones: zones.map(z => ({
                id: z.id, name: z.name, ticketId: z.ticketId, type: z.type,
                rows: z.rows, cols: z.cols, seatCount: z.seatCount, capacity: z.capacity,
                color: z.color, x: z.x, y: z.y, prefix: z.prefix,
                numScheme: z.numScheme, startNum: z.startNum, skipLetters: z.skipLetters
            }))
        }));
    } catch { /* Private mode/storage full: saving still proceeds normally. */ }
}

function restoreStudioDraft() {
    try {
        const raw = sessionStorage.getItem(STUDIO_DRAFT_KEY);
        if (!raw) return false;
        const draft = JSON.parse(raw);
        if (!Array.isArray(draft.zones) || !draft.zones.length) return false;
        currentPreset = draft.preset || 'custom';
        stageConfig = { ...stageConfig, ...(draft.stage || {}) };
        zones = draft.zones.map(draftZone => {
            const z = makeZone(
                draftZone.name || 'Khu vực', draftZone.ticketId, draftZone.type || 'seated',
                draftZone.rows || 5, draftZone.cols || 10, draftZone.x || 0, draftZone.y || 0,
                draftZone.color, draftZone.capacity || 200
            );
            Object.assign(z, {
                id: draftZone.id || nextZoneId(),
                seatCount: draftZone.seatCount ?? (draftZone.rows * draftZone.cols),
                prefix: draftZone.prefix || '', numScheme: draftZone.numScheme || 'ltr',
                startNum: draftZone.startNum || 1, skipLetters: draftZone.skipLetters || 'yes'
            });
            normalizeSeatedZone(z);
            keepZoneInsideCanvas(z);
            return z;
        });
        document.querySelectorAll('.preset-btn').forEach(button =>
            button.classList.toggle('active', button.dataset.preset === currentPreset));
        document.getElementById('loaiSoDoInput').value = currentPreset;
        document.getElementById('tenSoDoField').value = draft.name || ('Sơ đồ - ' + EVENT_NAME);
        renderCanvas();
        selectZone(zones[0].id);
        requestAnimationFrame(konvaFitView);
        if (typeof WuangUI !== 'undefined') WuangUI.toast('Đã khôi phục cấu hình sơ đồ trước đó.', 'info');
        return true;
    } catch {
        sessionStorage.removeItem(STUDIO_DRAFT_KEY);
        return false;
    }
}

// ─── Init Konva Stage ──────────────────────────────────────────────────────
function initKonva() {
    const container = document.getElementById('konva-container');
    konvaStage = new Konva.Stage({ container: 'konva-container', width: container.clientWidth, height: container.clientHeight });
    konvaBgLayer = new Konva.Layer();
    konvaLayer  = new Konva.Layer();
    konvaStage.add(konvaBgLayer);
    konvaStage.add(konvaLayer);

    drawDotGrid();
    konvaStage.on('wheel', handleWheel);
    konvaStage.on('mousedown touchstart', handlePanStart);
    konvaStage.on('mousemove touchmove', handlePanMove);
    konvaStage.on('mouseup touchend', handlePanEnd);
    konvaStage.on('click tap', e => { if (e.target === konvaStage || e.target.hasName('bg-rect')) deselectZone(); });

    window.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !e.shiftKey) { e.preventDefault(); undoAction(); }
        if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.key === 'z' && e.shiftKey))) { e.preventDefault(); redoAction(); }
    });

    // Canvas logic is 1200 × 800, but the available screen width varies.
    // Recalculate the view rather than leaving the right part of the map cropped.
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            if (!container.clientWidth || !container.clientHeight) return;
            konvaStage.size({ width: container.clientWidth, height: container.clientHeight });
            drawDotGrid();
            konvaFitView();
        }, 120);
    });
}

function drawDotGrid() {
    konvaBgLayer.destroyChildren();
    const bgRect = new Konva.Rect({ x: 0, y: 0, width: MAP_WIDTH, height: MAP_HEIGHT, fill: '#f8fafc', name: 'bg-rect' });
    konvaBgLayer.add(bgRect);
    for (let x = GRID; x < MAP_WIDTH; x += GRID) {
        for (let y = GRID; y < MAP_HEIGHT; y += GRID) {
            konvaBgLayer.add(new Konva.Circle({ x, y, radius: 1, fill: '#cbd5e1', opacity: 0.5 }));
        }
    }
    konvaBgLayer.batchDraw();
}

// ─── Pan handling ────────────────────────────────────────────────────────────
let isPanning = false, panStart = { x: 0, y: 0 }, panOrigin = { x: 0, y: 0 };
function handlePanStart(e) {
    if (e.target !== konvaStage && !e.target.hasName('bg-rect')) return;
    isPanning = true;
    panStart = konvaStage.getPointerPosition();
    panOrigin = { x: konvaLayer.x(), y: konvaLayer.y() };
}
function handlePanMove(e) {
    if (!isPanning) return;
    const pos = konvaStage.getPointerPosition();
    konvaLayer.x(panOrigin.x + pos.x - panStart.x);
    konvaLayer.y(panOrigin.y + pos.y - panStart.y);
    konvaBgLayer.position(konvaLayer.position());
    konvaLayer.batchDraw(); konvaBgLayer.batchDraw();
}
function handlePanEnd() { isPanning = false; }

function applyKonvaTransform(scale, x, y) {
    konvaLayer.scale({ x: scale, y: scale });
    konvaLayer.position({ x, y });
    konvaBgLayer.scale({ x: scale, y: scale });
    konvaBgLayer.position({ x, y });
    konvaLayer.batchDraw();
    konvaBgLayer.batchDraw();
    document.getElementById('konvaZoomLbl').textContent = Math.round(scale * 100) + '%';
}

function getFitScale() {
    const padding = 28;
    return Math.max(0.35, Math.min(
        1,
        (konvaStage.width() - padding * 2) / MAP_WIDTH,
        (konvaStage.height() - padding * 2) / MAP_HEIGHT
    ));
}

// ─── Wheel Zoom ──────────────────────────────────────────────────────────────
function handleWheel(e) {
    e.evt.preventDefault();
    const scaleBy = 1.08;
    const oldScale = konvaLayer.scaleX();
    const pointer = konvaStage.getPointerPosition();
    const mousePointTo = { x: (pointer.x - konvaLayer.x()) / oldScale, y: (pointer.y - konvaLayer.y()) / oldScale };
    const newScale = e.evt.deltaY < 0 ? oldScale * scaleBy : oldScale / scaleBy;
    const clamped = Math.min(Math.max(newScale, 0.3), 3);
    applyKonvaTransform(
        clamped,
        pointer.x - mousePointTo.x * clamped,
        pointer.y - mousePointTo.y * clamped
    );
}
function konvaZoom(delta) {
    const sc = Math.min(Math.max(konvaLayer.scaleX() + delta, 0.3), 3);
    const center = { x: konvaStage.width() / 2, y: konvaStage.height() / 2 };
    const logicalCenter = {
        x: (center.x - konvaLayer.x()) / konvaLayer.scaleX(),
        y: (center.y - konvaLayer.y()) / konvaLayer.scaleY()
    };
    applyKonvaTransform(sc, center.x - logicalCenter.x * sc, center.y - logicalCenter.y * sc);
}
function konvaFitView() {
    const scale = getFitScale();
    applyKonvaTransform(
        scale,
        Math.max(12, Math.round((konvaStage.width() - MAP_WIDTH * scale) / 2)),
        Math.max(12, Math.round((konvaStage.height() - MAP_HEIGHT * scale) / 2))
    );
}

// ─── Preset Config ────────────────────────────────────────────────────────────
function getTicketById(id) { return TICKET_TYPES.find(t => Number(t.id) === Number(id)) || TICKET_TYPES[0]; }
function activeTicketTypes() {
    return TICKET_TYPES.filter(ticket => ticket.enabled !== false && Number(ticket.total || 0) > 0);
}
function nextZoneId() { return Date.now() + Math.random(); }

function makeRowLabel(idx, skipLetters) {
    const SKIP = new Set(['I','O','Q','V','U']);
    let chars = [];
    for (let c = 65; c <= 90; c++) {
        const ch = String.fromCharCode(c);
        if (!skipLetters || !SKIP.has(ch)) chars.push(ch);
    }
    let result = '', n = idx + 1;
    while (n > 0) { n--; result = chars[n % chars.length] + result; n = Math.floor(n / chars.length); }
    return result;
}

function ticketAt(index) {
    const tickets = activeTicketTypes();
    return tickets[index % tickets.length] || TICKET_TYPES[index % TICKET_TYPES.length];
}

const MAX_SEATED_SEATS_PER_ZONE = 600;

function getZoneCapacity(z) {
    return z.type === 'ga'
        ? Math.max(0, Number(z.capacity || 0))
        : Math.max(0, Number(z.seatCount ?? (z.rows * z.cols) ?? 0));
}

// Tổng số ghế là nguồn dữ liệu chính. Số hàng chỉ quyết định cách dàn ghế;
// hàng cuối tự ngắn hơn khi cần để số ghế luôn đúng tuyệt đối.
function normalizeSeatedZone(z) {
    if (z.type !== 'seated') return;
    const total = Math.max(1, Math.min(MAX_SEATED_SEATS_PER_ZONE, Number(z.seatCount ?? (z.rows * z.cols) ?? 1)));
    const minRows = Math.ceil(total / 30);
    z.rows = Math.max(minRows, Math.min(20, Number(z.rows || minRows)));
    z.cols = Math.ceil(total / z.rows);
    z.seatCount = total;
}

function seatsInRow(z, rowIndex) {
    return Math.max(0, Math.min(z.cols, getZoneCapacity(z) - rowIndex * z.cols));
}

// Mỗi mẫu tự phân bổ chính xác tổng vé của từng loại vào các khu đã có.
// Nhờ vậy người tổ chức không phải tự cộng số hàng × số cột để tránh thiếu/thừa ghế.
function fitPresetCapacities(items) {
    const activeTickets = activeTicketTypes();
    if (!activeTickets.length) return [];

    // Mẫu tùy chỉnh có thể chỉ khởi đầu bằng một khu. Tạo thêm khu tối thiểu
    // để không có loại vé đang bán nào bị bỏ sót khi bấm “Tự cân”.
    while (items.length < activeTickets.length && items.length < 30) {
        const ticket = activeTickets[items.length];
        items.push(makeZone(
            `Khu ${ticket.name}`,
            ticket.id,
            'seated',
            5,
            10,
            60 + (items.length % 3) * 360,
            180 + Math.floor(items.length / 3) * 260,
            ticket.color
        ));
    }

    // Bảo đảm mọi loại vé đang bán đều xuất hiện trên sơ đồ.
    items.forEach((item, index) => {
        const ticket = getTicketById(item.ticketId);
        if (!ticket || ticket.enabled === false) item.ticketId = activeTickets[index % activeTickets.length].id;
    });
    activeTickets.forEach((ticket, index) => {
        if (!items.some(item => Number(item.ticketId) === Number(ticket.id))) {
            items[index % items.length].ticketId = ticket.id;
        }
    });

    const grouped = new Map();
    items.forEach(item => {
        const group = grouped.get(item.ticketId) || [];
        group.push(item); grouped.set(item.ticketId, group);
    });
    grouped.forEach((itemsForTicket, ticketId) => {
        const ticket = getTicketById(ticketId);
        const total = Math.max(0, Number(ticket?.total || 0));
        const requiredZones = Math.ceil(total / MAX_SEATED_SEATS_PER_ZONE);
        while (itemsForTicket.length < requiredZones && items.length < 30) {
            const source = itemsForTicket[itemsForTicket.length % Math.max(1, itemsForTicket.length)];
            const extra = makeZone(
                `${ticket.name} - khu ${itemsForTicket.length + 1}`,
                ticketId,
                'seated',
                10,
                10,
                60 + (items.length % 3) * 380,
                520 + Math.floor(items.length / 3) * 160,
                source?.color || ticket.color
            );
            items.push(extra);
            itemsForTicket.push(extra);
        }
        const allocatableTotal = Math.min(total, itemsForTicket.length * MAX_SEATED_SEATS_PER_ZONE);
        const weights = itemsForTicket.map(item => Math.max(1, getZoneCapacity(item)));
        const weightSum = weights.reduce((sum, value) => sum + value, 0);
        const allocations = weights.map(value => Math.floor(allocatableTotal * value / weightSum));
        let remaining = allocatableTotal - allocations.reduce((sum, value) => sum + value, 0);
        let cursor = 0;
        while (remaining > 0) {
            if (allocations[cursor] < MAX_SEATED_SEATS_PER_ZONE) {
                allocations[cursor]++;
                remaining--;
            }
            cursor = (cursor + 1) % allocations.length;
        }
        itemsForTicket.forEach((item, index) => {
            if (item.type === 'ga') item.capacity = allocations[index];
            else {
                item.seatCount = allocations[index];
                normalizeSeatedZone(item);
            }
        });
    });
    const fittedItems = items.filter(item => item.type === 'ga' ? item.capacity > 0 : item.seatCount > 0);
    layoutPresetZones(currentPreset, fittedItems);
    reflowZonesWhenNeeded(fittedItems);
    return fittedItems;
}

// Khi số vé thực tế làm một khu rộng hơn mẫu ban đầu, tự sắp lại theo hàng/cột
// để không có khu nào chồng lên nhau, vượt canvas hoặc nằm quá xa nhau.
function reflowZonesWhenNeeded(items) {
    if (!items.length) return;
    // Bàn tiệc đã có vị trí không gian cố định quanh lối đi; không được tự dồn lại thành lưới.
    if (items.some(z => z.type === 'banquet')) return;

    const isOutside = z => {
        const { w, h } = calcZoneSize(z);
        return z.x < 0 || z.y < 0 || z.x + w > MAP_WIDTH || z.y + h > MAP_HEIGHT;
    };
    const isOverlapping = (a, b) => {
        const sa = calcZoneSize(a), sb = calcZoneSize(b);
        return a.x < b.x + sb.w + 10 && a.x + sa.w + 10 > b.x &&
               a.y < b.y + sb.h + 10 && a.y + sa.h + 10 > b.y;
    };
    const needsReflow = items.some(isOutside) || items.some((item, index) =>
        items.slice(index + 1).some(other => isOverlapping(item, other)));
    if (!needsReflow) return;

    // Mỗi khu tối đa 15 ghế một hàng khi tự xếp lại. Kích thước này vừa cho hai
    // khu đứng cạnh nhau trên canvas 1.200px, đồng thời không kéo sơ đồ quá cao.
    const targetCols = items.length <= 2 ? 24 : 15;
    items.forEach(z => {
        if (z.type !== 'seated') return;
        z.rows = Math.max(1, Math.min(20, Math.ceil(getZoneCapacity(z) / targetCols)));
        normalizeSeatedZone(z);
    });

    const gap = 32;
    const padding = 36;
    let x = padding;
    let y = Math.max(padding, stageConfig.y + stageConfig.height + 42);
    let rowHeight = 0;

    items.forEach(z => {
        let size = calcZoneSize(z);
        if (x + size.w > MAP_WIDTH - padding && x > padding) {
            x = padding;
            y += rowHeight + gap;
            rowHeight = 0;
        }

        // Nếu chiều cao chưa phù hợp, dàn nhiều hàng hơn để khu hẹp và thấp vừa canvas.
        if (y + size.h > MAP_HEIGHT - padding && z.type === 'seated') {
            z.rows = 20;
            normalizeSeatedZone(z);
            size = calcZoneSize(z);
            if (x + size.w > MAP_WIDTH - padding && x > padding) {
                x = padding;
                y += rowHeight + gap;
                rowHeight = 0;
            }
        }
        z.x = x;
        z.y = y;
        keepZoneInsideCanvas(z);
        x += size.w + gap;
        rowHeight = Math.max(rowHeight, size.h);
    });
}

function placeZone(z, x, y) {
    z.x = Math.round(x / GRID) * GRID;
    z.y = Math.round(y / GRID) * GRID;
}

function centerZone(z, y) {
    const size = calcZoneSize(z);
    placeZone(z, (MAP_WIDTH - size.w) / 2, y);
}

// Mỗi preset mô phỏng một không gian thực tế. Sân khấu là mốc căn giữa,
// còn khối ghế luôn giữ đúng vai trò (VIP gần sân khấu, khán đài ở các phía).
function layoutPresetZones(preset, items) {
    if (!items.length || preset === 'gala') return;
    const side = 30;
    if (preset === 'workshop' || preset === 'concert') {
        const [vip, left, right] = items;
        if (vip) centerZone(vip, stageConfig.y + stageConfig.height + 38);
        if (left) placeZone(left, 190, 400);
        if (right) placeZone(right, MAP_WIDTH - 190 - calcZoneSize(right).w, 400);
        return;
    }
    if (preset === 'auditorium') {
        const [vip, left, center, right] = items;
        if (vip) centerZone(vip, stageConfig.y + stageConfig.height + 30);
        if (left) placeZone(left, side, 380);
        if (center) centerZone(center, 380);
        if (right) placeZone(right, MAP_WIDTH - side - calcZoneSize(right).w, 380);
        return;
    }
    if (preset === 'arena') {
        const [north, west, east, southLeft, southRight] = items;
        if (north) centerZone(north, 40);
        if (west) placeZone(west, 70, 230);
        if (east) placeZone(east, MAP_WIDTH - 70 - calcZoneSize(east).w, 230);
        if (southLeft) placeZone(southLeft, 210, 560);
        if (southRight) placeZone(southRight, MAP_WIDTH - 210 - calcZoneSize(southRight).w, 560);
        return;
    }
    const top = stageConfig.y + stageConfig.height + 42;
    items.forEach((item, index) => placeZone(item, 60 + (index % 3) * 390, top + Math.floor(index / 3) * 270));
}

function buildGalaTables() {
    stageConfig = { x: 380, y: 36, width: 440, height: 76, title: 'SÂN KHẤU / KHU VỰC TRUNG TÂM' };
    const result = [];
    let tableNumber = 1;
    activeTicketTypes().forEach(ticket => {
        let remaining = Number(ticket.total || 0);
        while (remaining > 0 && result.length < 30) {
            const seats = Math.min(10, remaining);
            const label = String(tableNumber).padStart(2, '0');
            const table = makeZone(`Bàn ${label}`, ticket.id, 'banquet', 1, seats, 0, 0, ticket.color);
            table.prefix = `B${label}`;
            result.push(table);
            remaining -= seats;
            tableNumber++;
        }
    });
    // Tối đa 30 bàn × 10 ghế = 300 chỗ: đúng quy mô tiệc gala của mẫu này.
    if (activeTicketTypes().reduce((sum, ticket) => sum + Number(ticket.total || 0), 0) > 300 && typeof WuangUI !== 'undefined') {
        WuangUI.toast('Mẫu Gala hiển thị tối đa 300 ghế. Với sự kiện lớn hơn, hãy chọn Tự thiết kế.', 'warning');
    }
    const topSlots = [180, 350, 520, 690, 860];
    const lowerX = [50, 225, 400, 650, 825]; // khoảng giữa là lối đi chính
    result.forEach((table, index) => {
        if (index < topSlots.length) placeZone(table, topSlots[index], 155);
        else {
            const slot = index - topSlots.length;
            placeZone(table, lowerX[slot % lowerX.length], 300 + Math.floor(slot / lowerX.length) * 100);
        }
    });
    return result;
}

// Các mẫu là điểm khởi đầu có cấu trúc không gian rõ ràng; số ghế vẫn tự cân
// đúng theo tổng vé của từng loại để khi lưu không xảy ra thiếu hoặc vượt ghế.
function buildPresetZones(preset) {
    if (!TICKET_TYPES.length) return [];
    if (preset === 'gala') return buildGalaTables();
    const zone = (name, ticketIndex, rows, cols, x, y, color) => {
        const ticket = ticketAt(ticketIndex);
        return makeZone(name, ticket.id, 'seated', rows, cols, x, y, color || ticket.color);
    };
    let result;
    if (preset === 'workshop') {
        stageConfig = { x: 400, y: 36, width: 400, height: 64, title: 'BỤC DIỄN GIẢ / MÀN HÌNH' };
        result = [
            zone('Hàng đầu / khách mời', 0, 5, 10, 415, 140),
            zone('Lớp học bên trái', 1, 10, 10, 190, 400),
            zone('Lớp học bên phải', 1, 10, 10, 640, 400)
        ];
    } else if (preset === 'auditorium') {
        stageConfig = { x: 350, y: 36, width: 500, height: 76, title: 'SÂN KHẤU / MÀN HÌNH' };
        result = [
            zone('Khu VIP phía trước', 0, 5, 10, 415, 145),
            zone('Khối ghế trái', 1, 8, 10, 30, 380),
            zone('Khối ghế giữa', 1, 8, 10, 415, 380),
            zone('Khối ghế phải', 1, 8, 10, 800, 380)
        ];
    } else if (preset === 'concert') {
        stageConfig = { x: 320, y: 36, width: 560, height: 82, title: 'SÂN KHẤU BIỂU DIỄN' };
        result = [
            zone('Khu VIP sát sân khấu', 0, 5, 10, 415, 155),
            zone('Khu vé thường trái', 1, 10, 10, 190, 400),
            zone('Khu vé thường phải', 1, 10, 10, 640, 400)
        ];
    } else if (preset === 'arena') {
        stageConfig = { x: 350, y: 300, width: 500, height: 180, title: 'SÀN THI ĐẤU / SÂN KHẤU 360°' };
        result = [
            zone('Khán đài Bắc - VIP', 0, 5, 10, 415, 40),
            zone('Khán đài Tây', 1, 10, 5, 70, 230),
            zone('Khán đài Đông', 1, 10, 5, 946, 230),
            zone('Khán đài Nam trái', 1, 5, 10, 210, 560),
            zone('Khán đài Nam phải', 1, 5, 10, 620, 560)
        ];
    } else {
        stageConfig = { x: 440, y: 36, width: 320, height: 48, title: 'SÂN KHẤU' };
        result = activeTicketTypes().slice(0, 6).map((ticket, index) =>
            makeZone('Khu ' + ticket.name, ticket.id, 'seated', 5, 10,
                60 + (index % 3) * 390, 155 + Math.floor(index / 3) * 300, ticket.color));
    }
    return fitPresetCapacities(result);
}

function makeZone(name, ticketId, type, rows, cols, x, y, color, capacity = 200) {
    const t = getTicketById(ticketId);
    const isGA = type === 'ga', isBanquet = type === 'banquet';
    const banquetSeats = Math.max(2, Math.min(12, Number(cols || rows || 10)));
    const zone = {
        id: nextZoneId(),
        name,
        ticketId: Number(ticketId),
        type, // 'seated' | 'ga' | 'banquet'
        rows: isGA ? 0 : isBanquet ? 1 : Math.max(1, rows),
        cols: isGA ? 0 : isBanquet ? banquetSeats : Math.max(1, cols),
        seatCount: isGA ? 0 : isBanquet ? banquetSeats : Math.max(1, rows * cols),
        capacity: isGA ? capacity : 0,
        color: color || t.color || '#4f46e5',
        x: Math.max(0, x),
        y: Math.max(0, y),
        prefix: '',
        numScheme: 'ltr',
        startNum: 1,
        skipLetters: 'yes',
        group: null
    };
    normalizeSeatedZone(zone);
    return zone;
}

// ─── Render Canvas ───────────────────────────────────────────────────────────
function renderCanvas() {
    konvaLayer.destroyChildren();

    // Draw Stage
    const stW = stageConfig.width || 320, stH = stageConfig.height || 48;
    const stageG = new Konva.Group({ x: stageConfig.x, y: stageConfig.y, draggable: true });
    stageG.add(new Konva.Rect({ width: stW, height: stH, fill: '#1e1b4b', cornerRadius: 10, shadowColor: 'rgba(30,27,75,.25)', shadowBlur: 12, shadowOffsetY: 4 }));
    stageG.add(new Konva.Text({ x: 0, y: 0, width: stW, height: stH, text: stageConfig.title, fill: '#fff', fontSize: 11, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', align: 'center', verticalAlign: 'middle', letterSpacing: 2 }));
    konvaLayer.add(stageG);
    stageGroup = stageG;
    stageG.on('dragend', () => {
        pushUndo();
        const x = Math.max(0, Math.min(MAP_WIDTH - stW, Math.round(stageG.x() / GRID) * GRID));
        const y = Math.max(0, Math.min(MAP_HEIGHT - stH, Math.round(stageG.y() / GRID) * GRID));
        stageG.position({ x, y });
        stageConfig.x = x; stageConfig.y = y;
        konvaLayer.batchDraw();
    });

    // Draw zones
    zones.forEach(z => renderZone(z));
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

function calcZoneSize(z) {
    if (z.type === 'ga') return { w: 240, h: 130 };
    if (z.type === 'banquet') return { w: 150, h: 100 };
    const cols = Math.max(1, z.cols);
    const rows = Math.max(1, z.rows);
    const w = ZONE_PAD * 2 + ROW_LABEL_W + cols * (SEAT_W + SEAT_GAP);
    const h = ZONE_PAD + ZONE_HEADER_H + rows * (SEAT_H + ROW_GAP) + ZONE_PAD;
    return { w: Math.max(w, 140), h: Math.max(h, 80) };
}

// Khi người dùng tăng số hàng/cột, khu có thể rộng hơn vị trí cũ.
// Luôn kéo nó trở lại phần bản vẽ hợp lệ để không phát sinh lỗi lúc lưu.
function keepZoneInsideCanvas(z) {
    const { w, h } = calcZoneSize(z);
    z.x = Math.max(0, Math.min(MAP_WIDTH - w, Math.round(Number(z.x || 0) / GRID) * GRID));
    z.y = Math.max(0, Math.min(MAP_HEIGHT - h, Math.round(Number(z.y || 0) / GRID) * GRID));
}

function renderZone(z) {
    if (z.group) z.group.destroy();
    const { w, h } = calcZoneSize(z);
    const grp = new Konva.Group({ x: z.x, y: z.y, draggable: true });
    z.group = grp;

    // Zone background rect
    const fill = hexToRgba(z.color, 0.06);
    const bg = new Konva.Rect({ width: w, height: h, fill, stroke: z.color, strokeWidth: z.id === selectedZoneId ? 2.5 : 1.5, cornerRadius: 12, shadowColor: 'rgba(0,0,0,.06)', shadowBlur: 8, shadowOffsetY: 2 });
    if (z.type === 'ga') {
        bg.fillPriority('linear-gradient'); // we'll use pattern
        bg.fill('#fafafa');
        const pat = new Konva.Line({ points: [0,0, w,h, 0,2*h, -w,h], closed: true, fill: 'none', stroke: '#e2e8f0', strokeWidth: 1, visible: false });
        grp.add(pat);
        // Hatch lines for GA
        for (let i = -h; i < w + h; i += 16) {
            grp.add(new Konva.Line({ points: [i, 0, i + h, h], stroke: '#e2e8f0', strokeWidth: 1, listening: false }));
        }
    }
    grp.add(bg);

    const ticket = getTicketById(z.ticketId);
    if (z.type === 'banquet') {
        // Bàn tiệc vẫn là các ghế thật trong CSDL; hình tròn chỉ là cách trực quan hóa.
        bg.fill('rgba(255,255,255,.01)');
        bg.shadowBlur(0);
        const tableCore = new Konva.Ellipse({ x: w / 2, y: h / 2 + 2, radiusX: 30, radiusY: 20, fill: hexToRgba(z.color, .14), stroke: z.color, strokeWidth: 1.5 });
        const tableText = new Konva.Text({ x: w / 2 - 25, y: h / 2 - 4, width: 50, text: 'BÀN', align: 'center', fill: z.color, fontSize: 9, fontStyle: 'bold', listening: false });
        const title = new Konva.Text({ x: 0, y: 2, width: w, text: z.name, align: 'center', fill: z.color, fontSize: 10, fontStyle: 'bold', ellipsis: true, listening: false });
        grp.add(tableCore, tableText, title);
        const count = getZoneCapacity(z);
        for (let index = 0; index < count; index++) {
            const angle = -Math.PI / 2 + (Math.PI * 2 * index / Math.max(1, count));
            const sx = w / 2 + Math.cos(angle) * 53 - 8;
            const sy = h / 2 + 2 + Math.sin(angle) * 35 - 6;
            grp.add(new Konva.Rect({ x: sx, y: sy, width: 16, height: 12, fill: '#fff', stroke: z.color, strokeWidth: 1, cornerRadius: 4, listening: false }));
            grp.add(new Konva.Text({ x: sx, y: sy + 1, width: 16, text: String(index + 1), fill: z.color, fontSize: 5.8, fontStyle: 'bold', align: 'center', listening: false }));
        }
        grp.add(new Konva.Text({ x: 0, y: h - 13, width: w, text: `${ticket.name} · ${count} ghế`, align: 'center', fill: '#64748b', fontSize: 7.5, listening: false }));
    } else {
        // Zone header bar
        const headerBg = new Konva.Rect({ x: 0, y: 0, width: w, height: ZONE_HEADER_H, fill: hexToRgba(z.color, 0.1), cornerRadius: [12, 12, 0, 0] });
        grp.add(headerBg);
        const zoneName = new Konva.Text({ x: 10, y: 8, text: z.name, fill: z.color, fontSize: 11, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', width: w - 20, ellipsis: true });
        const zoneTicket = new Konva.Text({ x: 10, y: 20, text: (z.type === 'ga' ? '🧍 GA · ' : '') + ticket.name, fill: '#64748b', fontSize: 9.5, fontFamily: 'Inter,system-ui,sans-serif', width: w - 20, ellipsis: true });
        grp.add(zoneName, zoneTicket);

        if (z.type === 'ga') {
            const gaIcon = new Konva.Text({ x: 0, y: 36, width: w, height: h - 36, text: `${z.capacity || 100} người`, fill: z.color, fontSize: 14, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', align: 'center', verticalAlign: 'middle' });
            grp.add(gaIcon);
        } else {
            // Hàng cuối có thể ngắn hơn để tổng ghế đúng bằng cấu hình của khu vực.
            for (let r = 0; r < z.rows; r++) {
                const rowLabel = makeRowLabel(r, z.skipLetters === 'yes');
                const rowLabelTxt = new Konva.Text({ x: ZONE_PAD, y: ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP) + (SEAT_H - 10) / 2, text: rowLabel, fill: '#94a3b8', fontSize: 9, fontStyle: 'bold', fontFamily: 'Inter,system-ui', width: ROW_LABEL_W, align: 'center', listening: false });
                grp.add(rowLabelTxt);
                const seatsThisRow = seatsInRow(z, r);
                for (let c = 0; c < seatsThisRow; c++) {
                    const sx = ZONE_PAD + ROW_LABEL_W + c * (SEAT_W + SEAT_GAP);
                    const sy = ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP);
                    const seatRect = new Konva.Rect({ x: sx, y: sy, width: SEAT_W, height: SEAT_H, fill: hexToRgba(z.color, 0.1), stroke: z.color, strokeWidth: 1, cornerRadius: 5, listening: false });
                    const numScheme = z.numScheme || 'ltr';
                    let seatNum;
                    if (numScheme === 'rtl') seatNum = z.startNum + (seatsThisRow - 1 - c);
                    else if (numScheme === 'odd') seatNum = z.startNum + c * 2;
                    else if (numScheme === 'even') seatNum = (z.startNum || 2) + c * 2;
                    else seatNum = z.startNum + c;
                    const seatTxt = new Konva.Text({ x: sx, y: sy, width: SEAT_W, height: SEAT_H, text: String(seatNum), fill: z.color, fontSize: 8, fontStyle: 'bold', fontFamily: 'Inter', align: 'center', verticalAlign: 'middle', listening: false });
                    grp.add(seatRect, seatTxt);
                }
            }
        }
    }

    // Delete button (X) at top-right corner
    const delCircle = new Konva.Circle({ x: w - 10, y: 10, radius: 9, fill: '#fee2e2', opacity: 0 });
    const delTxt = new Konva.Text({ x: w - 18, y: 2, text: '✕', fill: '#dc2626', fontSize: 12, fontStyle: 'bold', opacity: 0 });
    grp.add(delCircle, delTxt);
    grp.on('mouseenter', () => { delCircle.opacity(1); delTxt.opacity(1); bg.shadowBlur(14); konvaLayer.batchDraw(); });
    grp.on('mouseleave', () => { delCircle.opacity(0); delTxt.opacity(0); bg.shadowBlur(8); konvaLayer.batchDraw(); });
    delCircle.on('click tap', e => { e.cancelBubble = true; removeZone(z.id); });
    delTxt.on('click tap', e => { e.cancelBubble = true; removeZone(z.id); });

    // Click to select
    grp.on('click tap', e => { if (e.target === delCircle || e.target === delTxt) return; selectZone(z.id); });

    // Drag end → update coords + push undo
    grp.on('dragend', () => {
        pushUndo();
        let nx = Math.round(grp.x() / GRID) * GRID;
        let ny = Math.round(grp.y() / GRID) * GRID;
        nx = Math.max(0, Math.min(MAP_WIDTH - w, nx));
        ny = Math.max(0, Math.min(MAP_HEIGHT - h, ny));
        grp.position({ x: nx, y: ny });
        z.x = nx; z.y = ny;
        konvaLayer.batchDraw();
    });

    konvaLayer.add(grp);
    return grp;
}

function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return `rgba(${r},${g},${b},${alpha})`;
}

// ─── Zone CRUD ────────────────────────────────────────────────────────────────
function selectZone(id) {
    selectedZoneId = id;
    const z = zones.find(z => z.id === id);
    if (!z) return;
    document.getElementById('propsPlaceholder').style.display = 'none';
    document.getElementById('propsContent').style.display = '';
    document.getElementById('propsZoneTitle').textContent = z.name;
    document.getElementById('propsZoneColorDot').style.background = z.color;
    document.getElementById('pName').value = z.name;
    document.getElementById('pTicket').value = z.ticketId;
    document.getElementById('pColor').value = z.color;
    document.getElementById('pRows').value = z.rows || 1;
    document.getElementById('pSeatCount').value = getZoneCapacity(z) || 1;
    document.getElementById('pCols').value = z.cols || 1;
    document.getElementById('pPrefix').value = z.prefix || '';
    document.getElementById('pNumScheme').value = z.numScheme || 'ltr';
    document.getElementById('pStartNum').value = z.startNum || 1;
    document.getElementById('pSkipLetters').value = z.skipLetters || 'yes';
    document.getElementById('pGaCap').value = z.capacity || 200;
    setZoneTypeUI(z.type);
    document.getElementById('tabSeats').style.opacity = z.type === 'ga' ? '0.4' : '1';
    updateCapTab(z);
    // Re-render to show selection highlight
    zones.forEach(zz => { if (zz.group) zz.group.findOne('Rect').strokeWidth(1.5); });
    if (z.group) z.group.findOne('Rect').strokeWidth(2.5);
    konvaLayer.batchDraw();
}

function deselectZone() {
    selectedZoneId = null;
    document.getElementById('propsPlaceholder').style.display = '';
    document.getElementById('propsContent').style.display = 'none';
    zones.forEach(z => { if (z.group) z.group.findOne('Rect')?.strokeWidth(1.5); });
    konvaLayer.batchDraw();
}

function updateSelectedZone(field, value) {
    const z = zones.find(z => z.id === selectedZoneId);
    if (!z) return;
    pushUndo();
    if (field === 'name') { z.name = value; document.getElementById('propsZoneTitle').textContent = value; }
    else if (field === 'ticketId') z.ticketId = Number(value);
    else if (field === 'color') { z.color = value; document.getElementById('propsZoneColorDot').style.background = value; }
    else if (field === 'rows') z.rows = Math.max(1, Math.min(20, Number(value)));
    else if (field === 'seatCount') {
        z.seatCount = z.type === 'banquet'
            ? Math.max(2, Math.min(12, Number(value)))
            : Math.max(1, Math.min(MAX_SEATED_SEATS_PER_ZONE, Number(value)));
        if (z.type === 'banquet') { z.rows = 1; z.cols = z.seatCount; }
    }
    else if (field === 'prefix') z.prefix = value;
    else if (field === 'numScheme') z.numScheme = value;
    else if (field === 'startNum') z.startNum = Math.max(1, Number(value));
    else if (field === 'skipLetters') z.skipLetters = value;
    else if (field === 'capacity') z.capacity = Math.max(1, Number(value));
    normalizeSeatedZone(z);
    if (z.type !== 'ga') {
        document.getElementById('pRows').value = z.rows;
        document.getElementById('pCols').value = z.cols;
        document.getElementById('pSeatCount').value = z.seatCount;
    }
    keepZoneInsideCanvas(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateCapTab(z);
    updateSbZoneList();
}

function setZoneType(type) {
    const z = zones.find(z => z.id === selectedZoneId);
    if (!z) return;
    pushUndo();
    z.type = type;
    setZoneTypeUI(type);
    if (type === 'ga') { z.rows = 0; z.cols = 0; z.seatCount = 0; z.capacity = z.capacity || 200; }
    else if (type === 'banquet') {
        z.rows = 1;
        z.seatCount = Math.max(2, Math.min(12, Number(z.seatCount || 8)));
        z.cols = z.seatCount;
        z.capacity = 0;
        if (!z.prefix) z.prefix = 'B' + String(zones.filter(item => item.type === 'banquet').indexOf(z) + 1).padStart(2, '0');
    } else {
        z.rows = z.rows || 5;
        z.seatCount = z.seatCount || 50;
        normalizeSeatedZone(z);
    }
    keepZoneInsideCanvas(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

function setZoneTypeUI(type) {
    document.getElementById('ztSeated').classList.toggle('active', type === 'seated');
    document.getElementById('ztBanquet').classList.toggle('active', type === 'banquet');
    document.getElementById('ztGA').classList.toggle('active', type === 'ga');
    document.getElementById('gaCapField').style.display = type === 'ga' ? '' : 'none';
    const banquet = type === 'banquet';
    document.getElementById('pSeatCountLabel').textContent = banquet ? 'Ghế tại bàn' : 'Tổng số ghế';
    document.getElementById('pSeatCount').min = banquet ? '2' : '1';
    document.getElementById('pSeatCount').max = banquet ? '12' : String(MAX_SEATED_SEATS_PER_ZONE);
    ['pRowsField','pColsField','pNumSchemeField','pStartNumField','pSkipLettersField'].forEach(id => {
        document.getElementById(id).style.display = banquet ? 'none' : '';
    });
    document.getElementById('pPrefixField').querySelector('label').textContent = banquet ? 'Mã bàn' : 'Tiền tố tên hàng';
    document.getElementById('pPrefix').placeholder = banquet ? 'Vd: B01' : 'Bỏ trống = A, B, C...';
}

function addSeatedZone() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const z = makeZone('Khu vực ' + (zones.length + 1), t.id, 'seated', 5, 10, 20 + zones.length * 50, 120 + zones.length * 30, t.color || '#4f46e5');
    keepZoneInsideCanvas(z);
    zones.push(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
    selectZone(z.id);
}

function addGAZone() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const z = makeZone('Khu đứng (GA) ' + (zones.length + 1), t.id, 'ga', 0, 0, 20 + zones.length * 40, 100 + zones.length * 20, t.color || '#f59e0b', 300);
    keepZoneInsideCanvas(z);
    zones.push(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
    selectZone(z.id);
