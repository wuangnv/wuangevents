@model SoDoChoNgoi
@using System.Text.Json
@inject IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_OrganizerSimpleLayout.cshtml";
    ViewData["Title"] = "Sơ đồ chỗ ngồi";
    var suKienId = (Guid)ViewBag.SuKienId;
    var loaiVes = ViewBag.LoaiVes as List<LoaiVe> ?? new();
    var ghe = ViewBag.Ghe as List<ChoNgoi> ?? new();
    var hang = ViewBag.Hang as Dictionary<int, string> ?? new();
    var khuVucTheoHang = ViewBag.KhuVucTheoHang as Dictionary<int, KhuVuc> ?? new();
    var cacKhuVuc = khuVucTheoHang.Values.GroupBy(x => x.Id).Select(x => x.First()).OrderBy(x => x.ThuTu).ToList();
    var cacBoCuc = new[] { "auditorium", "theatre", "cinema", "arena", "custom" };
    string boCucDaLuu = cacBoCuc.Contains(Model.LoaiSoDo) ? Model.LoaiSoDo : "custom";
    int soTrong = ghe.Count(x => x.TrangThai == 0), dangGiu = ghe.Count(x => x.TrangThai == 1);
    int daBan = ghe.Count(x => x.TrangThai == 2), daKhoa = ghe.Count(x => x.TrangThai == 3);
    bool isExpired = ViewBag.NgayKetThucSuKien != null && VietnamTime.Now > (DateTime)ViewBag.NgayKetThucSuKien;
    bool isLocked = ViewBag.TrangThaiSuKien is not (0 or 2 or 7) || isExpired;
    string loaiVeJson = JsonSerializer.Serialize(loaiVes.Select(x => new { id = x.Id, name = x.TenLoaiVe, price = x.GiaBan, total = x.SoLuongTong, color = x.MauSac ?? "#4f46e5" }));
    string tenSuKienJson = JsonSerializer.Serialize((string?)ViewBag.TenSuKien ?? "");
}

@section Styles {
<style>
/* ===== VENUE SEATING STUDIO — 100% LIGHT THEME ===== */
*{box-sizing:border-box}
.seat-admin { max-width: 1440px; margin: 0 auto; padding: 20px 16px 80px; }

/* Hero Bar */
.hero-bar{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:18px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px;box-shadow:0 2px 6px rgba(0,0,0,.03)}
.hero-bar h1{font-size:1.35rem;font-weight:850;color:#1e1b4b;margin:0 0 3px}
.hero-bar p{margin:0;color:#64748b;font-size:.84rem}
.btn-del{border:1px solid #fecaca;background:#fff1f2;color:#dc2626;border-radius:10px;padding:7px 14px;font-weight:750;font-size:.82rem;transition:.15s;cursor:pointer}
.btn-del:hover:not(:disabled){background:#fee2e2}
.btn-del:disabled{opacity:.45;cursor:not-allowed}

/* Alerts */
.alert-box{border-radius:12px;padding:11px 16px;margin-bottom:14px;font-weight:650;font-size:.85rem;display:flex;align-items:center;gap:8px}
.alert-box.error{background:#fff1f2;border:1px solid #fecdd3;color:#be123c}
.alert-box.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#047857}

/* Stats Bar */
.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.stat-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px 18px;text-align:center;box-shadow:0 2px 4px rgba(0,0,0,.02)}
.stat-card strong{display:block;font-size:1.55rem;color:#1e1b4b;font-weight:850}
.stat-card span{font-size:.75rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.04em}

/* ====== SAVED MAP VIEW ====== */
.saved-map-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:20px;margin-bottom:20px;box-shadow:0 4px 14px rgba(0,0,0,.03)}
.saved-map-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #f1f5f9}
.saved-map-title{font-size:1rem;font-weight:850;color:#1e1b4b;margin:0;display:flex;align-items:center;gap:8px}
.saved-map-tools{display:flex;align-items:center;gap:6px}
.tool-btn{width:32px;height:32px;border:1px solid #cbd5e1;background:#fff;border-radius:8px;color:#334155;font-weight:850;font-size:.88rem;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;justify-content:center}
.tool-btn:hover{background:#f8fafc;border-color:#94a3b8}
.zoom-lbl{font-size:.78rem;font-weight:750;color:#64748b;min-width:42px;text-align:center}
.map-viewport{overflow:auto;padding:16px 8px;background:#fafbfc;border:1px solid #e2e8f0;border-radius:14px}

/* Stage header (organizer view) */
.org-stage-hdr{text-align:center;margin-bottom:20px}
.org-stage-lbl{display:inline-block;background:#1e1b4b;color:#fff;padding:8px 40px;border-radius:0 0 40% 40%/0 0 20px 20px;font-size:.75rem;font-weight:850;letter-spacing:2px;text-transform:uppercase;box-shadow:0 4px 14px rgba(30,27,75,.2)}
.org-stage-line{height:3px;background:linear-gradient(to right,transparent 5%,#e2e8f0 30%,#e2e8f0 70%,transparent 95%);margin-top:4px;border-radius:2px}

/* Zone flex layout */
.zone-stage-wrapper{display:flex;flex-direction:column;gap:16px;min-width:700px}
.zone-row-grp{display:flex;justify-content:center;align-items:flex-start;gap:12px;flex-wrap:nowrap}
.zone-row-grp.spread{justify-content:space-between}

/* Zone box */
.zone-box{background:#fff;border:1.5px solid var(--zcolor,#4f46e5);border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.04);flex-shrink:0}
.zone-box.ga-zone{}
.zone-header{padding:8px 14px 6px;background:color-mix(in srgb,var(--zcolor,#4f46e5) 9%,#fff);border-bottom:1px solid color-mix(in srgb,var(--zcolor,#4f46e5) 18%,#fff);display:flex;justify-content:space-between;align-items:center;gap:8px}
.zone-name{font-size:.78rem;font-weight:850;color:var(--zcolor,#4f46e5);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}
.zone-ticket{font-size:.7rem;font-weight:850;color:#fff;background:var(--zcolor,#4f46e5);padding:2px 8px;border-radius:999px;white-space:nowrap;flex-shrink:0}
.rows-wrap{padding:10px 12px 12px}
.seat-row{display:flex;align-items:center;gap:3px;margin-bottom:3px;justify-content:center}
.row-label{width:20px;text-align:right;font-size:.67rem;font-weight:850;color:#94a3b8;flex-shrink:0;margin-right:3px}

/* Professional seat button (chair-back style) */
.cseat{
    width:28px;height:24px;
    border-radius:6px 6px 3px 3px;
    border:1.5px solid var(--zcolor,#4f46e5);
    background:color-mix(in srgb,var(--zcolor,#4f46e5) 8%,#fff);
    color:var(--zcolor,#4f46e5);
    font-size:.58rem;font-weight:850;
    display:inline-flex;align-items:center;justify-content:center;
    cursor:pointer;transition:all .12s ease;
    user-select:none;outline:none;flex-shrink:0;
    box-shadow:0 -2px 0 0 color-mix(in srgb,var(--zcolor,#4f46e5) 30%,#fff) inset;
}
.cseat:hover:not(:disabled){background:var(--zcolor,#4f46e5);color:#fff;transform:translateY(-2px);box-shadow:0 4px 10px rgba(0,0,0,.12),0 -2px 0 0 color-mix(in srgb,var(--zcolor,#4f46e5) 60%,#000) inset;}
.cseat.held{background:#fef3c7;border-color:#f59e0b;color:#92400e;cursor:not-allowed;box-shadow:0 -2px 0 0 #f59e0b inset;}
.cseat.sold{background:#fee2e2;border-color:#fca5a5;color:#b91c1c;cursor:not-allowed;box-shadow:0 -2px 0 0 #fca5a5 inset;}
.cseat.locked{background:#f1f5f9;border-color:#dde2ec;color:#c1cad8;box-shadow:0 -2px 0 0 #dde2ec inset;}
.cseat.toggling{opacity:.4;pointer-events:none}

/* GA zone seats area */
.ga-info-box{padding:18px 20px;text-align:center;background:repeating-linear-gradient(45deg,#fafafa,#fafafa 8px,#f1f5f9 8px,#f1f5f9 16px)}
.ga-info-lbl{font-size:.84rem;font-weight:850;color:var(--zcolor,#4f46e5)}
.ga-info-sub{font-size:.72rem;color:#64748b;margin-top:3px}

.legend-bar{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;border-top:1px solid #f1f5f9;margin-top:14px;padding-top:12px;font-size:.77rem;color:#64748b;font-weight:650}
.legend-bar span{display:flex;align-items:center;gap:5px}
.legend-box{width:20px;height:17px;border-radius:4px 4px 2px 2px;display:inline-block;border:1.5px solid}

/* ====== STUDIO BUILDER ====== */
.studio-layout{display:grid;grid-template-columns:260px 1fr 300px;gap:16px;align-items:start}
.studio-sidebar{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.03)}
.studio-canvas-area{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.03);min-width:0}
.studio-props{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.03)}

/* Sidebar */
.sb-section-title{font-size:.78rem;font-weight:850;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin:0 0 10px}
.preset-list{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}
.preset-btn{border:1.5px solid #e2e8f0;border-radius:12px;padding:10px 12px;background:#fff;cursor:pointer;transition:.15s;text-align:left;display:flex;align-items:center;gap:10px}
.preset-btn:hover{border-color:#94a3b8;background:#fafafa}
.preset-btn.active{border:2px solid #4f46e5;background:#f5f7ff}
.preset-icon{width:32px;height:32px;border-radius:8px;background:#f1f5f9;color:#4f46e5;font-size:.9rem;display:grid;place-items:center;flex-shrink:0}
.preset-btn.active .preset-icon{background:#4f46e5;color:#fff}
.preset-btn .ptxt strong{display:block;font-size:.8rem;color:#1e1b4b;font-weight:800}
.preset-btn .ptxt small{font-size:.68rem;color:#64748b;line-height:1.3}
.sb-divider{border:0;border-top:1px solid #f1f5f9;margin:14px 0}
.sb-btn-add{width:100%;border:1.5px dashed #4f46e5;background:#f5f7ff;color:#4f46e5;border-radius:10px;padding:9px;font-weight:800;font-size:.8rem;cursor:pointer;margin-bottom:6px;display:flex;align-items:center;justify-content:center;gap:6px}
.sb-btn-add:hover{background:#e0e7ff}
.sb-zone-list{display:flex;flex-direction:column;gap:6px;max-height:220px;overflow-y:auto}
.sb-zone-item{padding:8px 10px;border-radius:10px;border-left:4px solid var(--zc,#4f46e5);background:#f8fafc;cursor:pointer;font-size:.78rem;display:flex;justify-content:space-between;align-items:center}
.sb-zone-item.selected{background:#e0e7ff;border-left-color:#4f46e5}
.sb-zone-item:hover{background:#f1f5f9}
.sb-zone-name{font-weight:750;color:#1e1b4b}
.sb-zone-del{border:0;background:0;color:#ef4444;font-size:.82rem;cursor:pointer;padding:0 4px}

/* Canvas */
.canvas-hud{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #f1f5f9}
.canvas-hud-title{font-size:.88rem;font-weight:850;color:#1e1b4b;display:flex;align-items:center;gap:6px}
.canvas-hud-tools{display:flex;align-items:center;gap:5px}
.pill-stat{background:#f1f5f9;color:#475569;font-size:.72rem;font-weight:750;padding:4px 10px;border-radius:999px;border:1px solid #e2e8f0}
#konva-container{border:1px solid #e2e8f0;border-radius:14px;background:#f8fafc;overflow:hidden;cursor:grab;height:520px}
#konva-container:active{cursor:grabbing}

/* Properties Panel */
.props-placeholder{text-align:center;padding:40px 20px;color:#94a3b8}
.props-placeholder i{font-size:2rem;display:block;margin-bottom:8px}
.props-placeholder p{font-size:.82rem;margin:0}
.props-zone-title{font-size:.95rem;font-weight:850;color:#1e1b4b;margin:0 0 14px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;gap:8px}
.props-zone-color{width:14px;height:14px;border-radius:50%;display:inline-block;flex-shrink:0}
.props-tab-bar{display:flex;gap:4px;margin-bottom:14px}
.props-tab{flex:1;padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;font-size:.75rem;font-weight:800;color:#64748b;cursor:pointer;transition:.15s;text-align:center}
.props-tab.active{border-color:#4f46e5;background:#f5f7ff;color:#4f46e5}
.props-body{display:flex;flex-direction:column;gap:10px}
.props-body.hidden{display:none}
.pf label{display:block;font-size:.72rem;font-weight:750;color:#64748b;margin-bottom:4px}
.pf input,.pf select{width:100%;border:1px solid #cbd5e1;border-radius:8px;padding:7px 10px;font-size:.82rem;font-weight:650;color:#1e293b}
.pf input:focus,.pf select:focus{border-color:#4f46e5;outline:none;box-shadow:0 0 0 2px rgba(79,70,229,.12)}
.pf-grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cap-bar{margin-top:4px;padding:7px 10px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0;font-size:.73rem}
.cap-bar.ok{background:#ecfdf5;border-color:#a7f3d0;color:#047857}
.cap-bar.warn{background:#fff1f2;border-color:#fecdd3;color:#be123c}
.zone-type-switch{display:flex;gap:6px;margin-bottom:2px}
.zt-btn{flex:1;padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.77rem;font-weight:800;cursor:pointer;text-align:center;transition:.15s}
.zt-btn.active{border-color:#4f46e5;background:#f5f7ff;color:#4f46e5}

/* Canvas Export/Import */
.canvas-io-bar{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #f1f5f9}
.io-btn{border:1px solid #cbd5e1;background:#fff;color:#475569;border-radius:8px;padding:6px 12px;font-size:.78rem;font-weight:750;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.io-btn:hover{background:#f8fafc;border-color:#94a3b8}

/* Form Submit Bar */
.studio-submit-bar{display:flex;justify-content:space-between;align-items:center;padding-top:14px;border-top:1px solid #f1f5f9;margin-top:14px;gap:12px}
.btn-save-map{border:0;background:#4f46e5;color:#fff;border-radius:10px;padding:11px 22px;font-weight:850;font-size:.88rem;cursor:pointer;transition:.15s}
.btn-save-map:hover:not(:disabled){background:#4338ca}
.btn-save-map:disabled{opacity:.45;cursor:not-allowed}
.btn-no-seat{border:1px solid #94a3b8;background:#fff;color:#475569;border-radius:8px;padding:8px 14px;font-weight:750;font-size:.78rem;cursor:pointer}

/* No ticket type fallback */
.no-loaive-box{background:#fff1f2;border:1px solid #fecdd3;color:#be123c;border-radius:12px;padding:14px 18px;font-weight:650;font-size:.86rem}

@@media(max-width:1200px){.studio-layout{grid-template-columns:1fr 1fr}}
@@media(max-width:800px){.studio-layout{grid-template-columns:1fr}.studio-props{order:3}.stats-bar{grid-template-columns:repeat(2,1fr)}}
</style>
}

<main class="seat-admin">
    @if (isLocked)
    {
        <div class="alert-box error"><i class="fas fa-lock"></i> Sự kiện đang khóa nghiệp vụ hoặc đã kết thúc; không thể thay đổi sơ đồ.</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-box error"><i class="fas fa-circle-exclamation"></i> @TempData["Error"]</div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert-box success"><i class="fas fa-circle-check"></i> @TempData["Message"]</div>
    }

    <div class="hero-bar">
        <div>
            <h1><i class="fas fa-chair me-2 text-primary"></i>Sơ đồ chỗ ngồi</h1>
            <p>@ViewBag.TenSuKien</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            @if (Model.Id != 0)
            {
                <a href="/Organizer/ExportSoDo?suKienId=@suKienId" class="io-btn" title="Xuất sơ đồ ra file JSON">
                    <i class="fas fa-download"></i> Xuất JSON
                </a>
                <form method="post" action="/Organizer/XoaSoDo" data-confirm="Xóa toàn bộ sơ đồ ghế của sự kiện?" data-confirm-title="Xóa sơ đồ ghế" data-confirm-button="Xóa sơ đồ" style="margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suKienId" value="@suKienId" />
                    <button class="btn-del" disabled="@(isLocked || dangGiu > 0 || daBan > 0)" type="submit">
                        <i class="fas fa-trash me-1"></i>Xóa sơ đồ
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Id != 0)
    {
        <!-- ====== PHÂN HỆ QUẢN TRỊ SƠ ĐỒ ĐÃ TẠO ====== -->
        <div class="stats-bar">
            <div class="stat-card"><strong>@soTrong</strong><span>Ghế trống</span></div>
            <div class="stat-card"><strong style="color:#d97706">@dangGiu</strong><span>Đang giữ chỗ</span></div>
            <div class="stat-card"><strong style="color:#dc2626">@daBan</strong><span>Đã thanh toán</span></div>
            <div class="stat-card"><strong style="color:#64748b">@daKhoa</strong><span>Tạm khóa</span></div>
        </div>

        <div class="saved-map-card">
            <div class="saved-map-header">
                <h3 class="saved-map-title"><i class="fas fa-map text-primary"></i>Bản vẽ không gian 2D: @Model.TenSoDo</h3>
                <div class="saved-map-tools">
                    <button class="tool-btn" onclick="adjZ(-0.1)" title="Thu nhỏ">−</button>
                    <span class="zoom-lbl" id="zoomLbl">100%</span>
                    <button class="tool-btn" onclick="adjZ(0.1)" title="Phóng to">+</button>
                    <button class="tool-btn" onclick="resetZ()" title="Đặt lại"><i class="fas fa-rotate-left"></i></button>
                </div>
            </div>

            <div class="map-viewport">
                @{
                    string sTitle = boCucDaLuu == "cinema" ? "MÀN HÌNH CHIẾU CHÍNH" : boCucDaLuu == "arena" ? "SÀN ĐẤU TRUNG TÂM / ARENA" : "SÂN KHẤU CHÍNH / MAIN STAGE";
                    const int ZONES_PER_ROW = 3;
                    var zoneList = cacKhuVuc.ToList();
                    var zoneGroups = Enumerable.Range(0, (int)Math.Ceiling(zoneList.Count / (double)ZONES_PER_ROW))
                        .Select(i => zoneList.Skip(i * ZONES_PER_ROW).Take(ZONES_PER_ROW).ToList())
                        .ToList();
                }
                <!-- Stage header -->
                <div class="org-stage-hdr">
                    <div class="org-stage-lbl">@sTitle</div>
                    <div class="org-stage-line"></div>
                </div>

                <div class="zone-stage-wrapper" id="savedGrid" style="transition:transform .2s;transform-origin:top center">
                    @foreach (var group in zoneGroups)
                    {
                        <div class="zone-row-grp @(group.Count > 1 ? "spread" : "")">
                            @foreach (var zone in group)
                            {
                                var zoneRows = ghe.GroupBy(x => x.HangGheId)
                                    .Where(row => khuVucTheoHang.GetValueOrDefault(row.Key)?.Id == zone.Id)
                                    .OrderBy(row => row.Key)
                                    .ToList();
                                string zc = zone.MauSac ?? "#4f46e5";
                                bool isGaZone = zoneRows.Count == 1 && zoneRows.Any() && hang.GetValueOrDefault(zoneRows.First().Key) == "GA";
                                var ve = loaiVes.FirstOrDefault(v => v.Id == zone.LoaiVeId);

                                <div class="zone-box @(isGaZone ? "ga-zone" : "")" style="--zcolor:@zc">
                                    <div class="zone-header">
                                        <span class="zone-name">@zone.TenKhuVuc</span>
                                        <span class="zone-ticket">@(ve?.TenLoaiVe ?? "Loại vé")</span>
                                    </div>
                                    @if (isGaZone)
                                    {
                                        <div class="ga-info-box" style="--zcolor:@zc">
                                            <div class="ga-info-lbl"><i class="fas fa-person-walking me-1"></i>Khu đứng (GA)</div>
                                            <div class="ga-info-sub">Sức chứa @(zoneRows.Sum(r => r.Count())) người · @(ve?.TenLoaiVe)</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rows-wrap">
                                            @foreach (var row in zoneRows)
                                            {
                                                var seatsInRow = row.ToList();
                                                <div class="seat-row">
                                                    <span class="row-label">@hang.GetValueOrDefault(row.Key)</span>
                                                    @foreach (var seat in seatsInRow)
                                                    {
                                                        string cls = seat.TrangThai == 1 ? "cseat held" : seat.TrangThai == 2 ? "cseat sold" : seat.TrangThai == 3 ? "cseat locked" : "cseat";
                                                        bool dis = isLocked || seat.TrangThai is 1 or 2;
                                                        string tip = seat.TrangThai == 0 ? "Khóa ghế này" : seat.TrangThai == 3 ? "Mở khóa ghế này" : seat.TrangThai == 1 ? "Đang giữ" : "Đã bán";
                                                        <button type="button" class="@cls" id="sb-@seat.Id" data-sid="@seat.Id" disabled="@dis" title="@tip" onclick="seatToggle(@seat.Id)" style="--zcolor:@zc">@seat.SoGhe</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="legend-bar">
                <span><span class="legend-box" style="background:color-mix(in srgb,#4f46e5 8%,#fff);border-color:#4f46e5"></span>Trống (Nhấp để Khóa)</span>
                <span><span class="legend-box" style="background:#fef3c7;border-color:#f59e0b"></span>Đang giữ chỗ</span>
                <span><span class="legend-box" style="background:#fee2e2;border-color:#fca5a5"></span>Đã bán</span>
                <span><span class="legend-box" style="background:#f1f5f9;border-color:#dde2ec"></span>Tạm khóa (Nhấp để Mở)</span>
            </div>
        </div>

    }
    else if (!loaiVes.Any())
    {
        <div class="no-loaive-box"><i class="fas fa-triangle-exclamation me-2"></i>Chưa có loại vé nào. Vui lòng <a href="/Organizer/LoaiVe?suKienId=@suKienId" class="fw-bold ms-1 text-decoration-underline">Tạo loại vé</a> trước khi thiết lập sơ đồ chỗ ngồi.</div>
    }
    else
    {
        <!-- ====== PHÂN HỆ STUDIO THIẾT KẾ SƠ ĐỒ (KONVA.JS) ====== -->
        <div class="studio-layout">
            <!-- SIDEBAR TRÁI -->
            <div class="studio-sidebar">
                <p class="sb-section-title">Mẫu địa điểm</p>
                <div class="preset-list" id="presetList">
                    <button class="preset-btn active" data-preset="concert" onclick="selectPreset('concert')">
                        <span class="preset-icon"><i class="fas fa-music"></i></span>
                        <span class="ptxt"><strong>Live Concert / SVĐ</strong><small>Mỹ Đình, Phú Thọ, SECC</small></span>
                    </button>
                    <button class="preset-btn" data-preset="theatre" onclick="selectPreset('theatre')">
                        <span class="preset-icon"><i class="fas fa-masks-theater"></i></span>
                        <span class="ptxt"><strong>Nhà hát &amp; Hòa nhạc</strong><small>Hòa Bình, Bến Thành, Nhà hát Lớn</small></span>
                    </button>
                    <button class="preset-btn" data-preset="auditorium" onclick="selectPreset('auditorium')">
                        <span class="preset-icon"><i class="fas fa-landmark"></i></span>
                        <span class="ptxt"><strong>Trung tâm Hội nghị</strong><small>NCC, GEM Center, White Palace</small></span>
                    </button>
                    <button class="preset-btn" data-preset="arena" onclick="selectPreset('arena')">
                        <span class="preset-icon"><i class="fas fa-trophy"></i></span>
                        <span class="ptxt"><strong>Sân vận động 4 hướng</strong><small>Nhà thi đấu Arena 360°</small></span>
                    </button>
                    <button class="preset-btn" data-preset="custom" onclick="selectPreset('custom')">
                        <span class="preset-icon"><i class="fas fa-sliders"></i></span>
                        <span class="ptxt"><strong>Tùy chỉnh tự do</strong><small>Canvas tự do</small></span>
                    </button>
                </div>
                <hr class="sb-divider">
                <p class="sb-section-title">Khu vực trong sơ đồ</p>
                <button class="sb-btn-add" onclick="addSeatedZone()"><i class="fas fa-chair"></i> Thêm khu ghế ngồi</button>
                <button class="sb-btn-add" onclick="addGAZone()" style="background:#fff8f0;border-color:#f59e0b;color:#d97706;margin-top:0"><i class="fas fa-person-walking"></i> Thêm khu đứng (GA)</button>
                <div class="sb-zone-list" id="sbZoneList"></div>
                <hr class="sb-divider">
                <div class="canvas-io-bar" style="margin-top:0;padding-top:0;border:0;flex-wrap:wrap">
                    <label class="io-btn" style="cursor:pointer"><i class="fas fa-upload"></i> Nhập JSON <input type="file" id="importFileInput" accept=".json" style="display:none" onchange="importBlueprintFile(this)"></label>
                </div>
            </div>

            <!-- CANVAS GIỮA (Konva.js) -->
            <div class="studio-canvas-area">
                <div class="canvas-hud">
                    <span class="canvas-hud-title"><i class="fas fa-drafting-compass text-primary"></i>&nbsp;Bản vẽ Studio 2D</span>
                    <div class="canvas-hud-tools">
                        <span class="pill-stat" id="totalStatPill">0 ghế · 0 khu</span>
                        <button class="tool-btn" onclick="konvaZoom(-0.2)" title="Thu nhỏ">−</button>
                        <span class="zoom-lbl" id="konvaZoomLbl">100%</span>
                        <button class="tool-btn" onclick="konvaZoom(0.2)" title="Phóng to">+</button>
                        <button class="tool-btn" onclick="konvaFitView()" title="Fit to screen"><i class="fas fa-compress-arrows-alt"></i></button>
                        <button class="tool-btn" onclick="undoAction()" title="Undo (Ctrl+Z)" id="undoBtn"><i class="fas fa-rotate-left"></i></button>
                        <button class="tool-btn" onclick="redoAction()" title="Redo (Ctrl+Y)" id="redoBtn"><i class="fas fa-rotate-right"></i></button>
                    </div>
                </div>
                <div id="konva-container"></div>

                <form method="post" action="/Organizer/TaoSoDo" id="studioForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suKienId" value="@suKienId" />
                    <input type="hidden" name="loaiSoDo" id="loaiSoDoInput" value="arena" />
                    <input type="hidden" name="sanKhauX" id="skXInput" value="5" />
                    <input type="hidden" name="sanKhauY" id="skYInput" value="1" />
                    <input type="hidden" name="tenSoDo" id="tenSoDoInput" value="" />
                    <div id="hiddenZoneInputs"></div>

                    <div class="studio-submit-bar">
                        <div style="display:flex;align-items:center;gap:10px">
                            <div class="pf" style="margin:0">
                                <label style="font-size:.72rem;font-weight:750;color:#64748b;display:block;margin-bottom:3px">Tên sơ đồ *</label>
                                <input type="text" id="tenSoDoField" placeholder="Vd: Sơ đồ Concert 2026" style="border:1px solid #cbd5e1;border-radius:8px;padding:7px 12px;font-size:.84rem;font-weight:650;color:#1e293b;width:280px" maxlength="200" />
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px">
                            <button type="button" class="btn-no-seat" disabled="@isLocked" onclick="submitNoSeatMap()">Bán vé không chọn ghế</button>
                            <button type="button" class="btn-save-map" disabled="@isLocked" onclick="submitStudioForm()">
                                <i class="fas fa-check-circle me-1"></i>Lưu sơ đồ
                            </button>
                        </div>
                    </div>
                </form>

                <form method="post" action="/Organizer/TaoSoDo" style="display:none" id="noSeatForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suKienId" value="@suKienId" />
                    <input type="hidden" name="tenSoDo" value="Không dùng sơ đồ" />
                    <input type="hidden" name="loaiSoDo" value="none" />
                </form>
            </div>

            <!-- PROPERTIES PANEL PHẢI -->
            <div class="studio-props" id="propsPanel">
                <div class="props-placeholder" id="propsPlaceholder">
                    <i class="fas fa-mouse-pointer"></i>
                    <p>Nhấp vào một khu vực trên bản vẽ để chỉnh sửa thuộc tính</p>
                </div>
                <div id="propsContent" style="display:none">
                    <h4 class="props-zone-title">
                        <span class="props-zone-color" id="propsZoneColorDot"></span>
                        <span id="propsZoneTitle">Khu vực</span>
                    </h4>
                    <div class="props-tab-bar">
                        <button class="props-tab active" onclick="switchPropsTab('zone',this)">Khu vực</button>
                        <button class="props-tab" onclick="switchPropsTab('seats',this)" id="tabSeats">Hàng &amp; Ghế</button>
                        <button class="props-tab" onclick="switchPropsTab('cap',this)">Sức chứa</button>
                    </div>

                    <!-- Tab Khu vực -->
                    <div class="props-body" id="tabBodyZone">
                        <div class="pf"><label>Tên khu vực</label><input type="text" id="pName" placeholder="Vd: Khu VIP A" oninput="updateSelectedZone('name',this.value)" /></div>
                        <div class="pf"><label>Loại vé</label>
                            <select id="pTicket" onchange="updateSelectedZone('ticketId',this.value)">
                                @foreach (var ve in loaiVes)
                                {
                                    <option value="@ve.Id">@ve.TenLoaiVe (@ve.GiaBan.ToString("N0")đ · @ve.SoLuongTong vé)</option>
                                }
                            </select>
                        </div>
                        <div class="pf"><label>Màu sắc</label><input type="color" id="pColor" oninput="updateSelectedZone('color',this.value)" /></div>
                        <div class="pf">
                            <label>Kiểu khu vực</label>
                            <div class="zone-type-switch">
                                <button class="zt-btn active" id="ztSeated" onclick="setZoneType('seated')"><i class="fas fa-chair me-1"></i>Ghế ngồi</button>
                                <button class="zt-btn" id="ztGA" onclick="setZoneType('ga')"><i class="fas fa-person-walking me-1"></i>Khu đứng (GA)</button>
                            </div>
                        </div>
                        <div class="pf" id="gaCapField" style="display:none">
                            <label>Sức chứa tối đa (người)</label>
                            <input type="number" id="pGaCap" min="1" max="10000" placeholder="Vd: 500" oninput="updateSelectedZone('capacity',this.value)" />
                        </div>
                    </div>

                    <!-- Tab Hàng & Ghế -->
                    <div class="props-body hidden" id="tabBodySeats">
                        <div class="pf-grid2">
                            <div class="pf"><label>Số hàng</label><input type="number" id="pRows" min="1" max="50" oninput="updateSelectedZone('rows',this.value)" /></div>
                            <div class="pf"><label>Ghế / hàng</label><input type="number" id="pCols" min="1" max="60" oninput="updateSelectedZone('cols',this.value)" /></div>
                        </div>
                        <div class="pf"><label>Tiền tố tên hàng</label><input type="text" id="pPrefix" maxlength="10" placeholder="Bỏ trống = A, B, C..." oninput="updateSelectedZone('prefix',this.value)" /></div>
                        <div class="pf">
                            <label>Kiểu đánh số ghế</label>
                            <select id="pNumScheme" onchange="updateSelectedZone('numScheme',this.value)">
                                <option value="ltr">Liên tục Trái → Phải (1, 2, 3...)</option>
                                <option value="rtl">Liên tục Phải → Trái (N...2, 1)</option>
                                <option value="odd">Lẻ (1, 3, 5...)</option>
                                <option value="even">Chẵn (2, 4, 6...)</option>
                            </select>
                        </div>
                        <div class="pf"><label>Số ghế bắt đầu</label><input type="number" id="pStartNum" min="1" max="999" value="1" oninput="updateSelectedZone('startNum',this.value)" /></div>
                        <div class="pf">
                            <label>Bỏ qua chữ dễ nhầm (I, O, Q)</label>
                            <select id="pSkipLetters" onchange="updateSelectedZone('skipLetters',this.value)">
                                <option value="yes">Có (Chuẩn quốc tế)</option>
                                <option value="no">Không</option>
                            </select>
                        </div>
                    </div>

                    <!-- Tab Sức chứa -->
                    <div class="props-body hidden" id="tabBodyCap">
                        <div id="capDetails" style="font-size:.82rem;color:#475569;line-height:1.6"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</main>

@section Scripts {
<script src="https://unpkg.com/konva@9/konva.min.js"></script>
<script>
const EVENT_ID = '@suKienId';
const TICKET_TYPES = @Html.Raw(loaiVeJson);
const EVENT_NAME = @Html.Raw(tenSuKienJson);
const SKIP_LETTERS = new Set(['I','O','Q','V','U']);
const GRID = 20; // snap grid px
const SEAT_W = 28, SEAT_H = 24, SEAT_GAP = 4;
const ROW_LABEL_W = 26, ROW_GAP = 6;
const ZONE_PAD = 12, ZONE_HEADER_H = 32;

let currentPreset = 'concert';
let zones = []; // Array of zone objects
let selectedZoneId = null;
let undoStack = [], redoStack = [];
let konvaStage, konvaLayer, konvaBgLayer;
let stageGroup = null;
let stageConfig = { x: 5, y: 1, title: 'SÂN KHẤU CHÍNH / MAIN STAGE' };

// ─── Init Konva Stage ──────────────────────────────────────────────────────
function initKonva() {
    const container = document.getElementById('konva-container');
    konvaStage = new Konva.Stage({ container: 'konva-container', width: container.clientWidth, height: 520 });
    konvaBgLayer = new Konva.Layer();
    konvaLayer  = new Konva.Layer();
    konvaStage.add(konvaBgLayer);
    konvaStage.add(konvaLayer);

    drawDotGrid();
    konvaStage.on('wheel', handleWheel);
    konvaStage.on('mousedown touchstart', handlePanStart);
    konvaStage.on('mousemove touchmove', handlePanMove);
    konvaStage.on('mouseup touchend', handlePanEnd);
    konvaStage.on('click tap', e => { if (e.target === konvaStage || e.target.hasName('bg-rect')) deselectZone(); });

    window.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !e.shiftKey) { e.preventDefault(); undoAction(); }
        if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.key === 'z' && e.shiftKey))) { e.preventDefault(); redoAction(); }
    });
}

function drawDotGrid() {
    konvaBgLayer.destroyChildren();
    const w = konvaStage.width(), h = konvaStage.height();
    const bgRect = new Konva.Rect({ x: 0, y: 0, width: w, height: h, fill: '#f8fafc', name: 'bg-rect' });
    konvaBgLayer.add(bgRect);
    for (let x = GRID; x < w * 3; x += GRID) {
        for (let y = GRID; y < h * 3; y += GRID) {
            konvaBgLayer.add(new Konva.Circle({ x, y, radius: 1, fill: '#cbd5e1', opacity: 0.5 }));
        }
    }
    konvaBgLayer.batchDraw();
}

// ─── Pan handling ────────────────────────────────────────────────────────────
let isPanning = false, panStart = { x: 0, y: 0 }, panOrigin = { x: 0, y: 0 };
function handlePanStart(e) {
    if (e.target !== konvaStage && !e.target.hasName('bg-rect')) return;
    isPanning = true;
    panStart = konvaStage.getPointerPosition();
    panOrigin = { x: konvaLayer.x(), y: konvaLayer.y() };
}
function handlePanMove(e) {
    if (!isPanning) return;
    const pos = konvaStage.getPointerPosition();
    konvaLayer.x(panOrigin.x + pos.x - panStart.x);
    konvaLayer.y(panOrigin.y + pos.y - panStart.y);
    konvaLayer.batchDraw();
}
function handlePanEnd() { isPanning = false; }

// ─── Wheel Zoom ──────────────────────────────────────────────────────────────
function handleWheel(e) {
    e.evt.preventDefault();
    const scaleBy = 1.08;
    const oldScale = konvaLayer.scaleX();
    const pointer = konvaStage.getPointerPosition();
    const mousePointTo = { x: (pointer.x - konvaLayer.x()) / oldScale, y: (pointer.y - konvaLayer.y()) / oldScale };
    const newScale = e.evt.deltaY < 0 ? oldScale * scaleBy : oldScale / scaleBy;
    const clamped = Math.min(Math.max(newScale, 0.3), 3);
    konvaLayer.scale({ x: clamped, y: clamped });
    konvaLayer.x(pointer.x - mousePointTo.x * clamped);
    konvaLayer.y(pointer.y - mousePointTo.y * clamped);
    konvaLayer.batchDraw();
    document.getElementById('konvaZoomLbl').textContent = Math.round(clamped * 100) + '%';
}
function konvaZoom(delta) {
    const sc = Math.min(Math.max(konvaLayer.scaleX() + delta, 0.3), 3);
    konvaLayer.scale({ x: sc, y: sc }); konvaLayer.batchDraw();
    document.getElementById('konvaZoomLbl').textContent = Math.round(sc * 100) + '%';
}
function konvaFitView() {
    konvaLayer.scale({ x: 1, y: 1 }); konvaLayer.position({ x: 20, y: 20 }); konvaLayer.batchDraw();
    document.getElementById('konvaZoomLbl').textContent = '100%';
}

// ─── Preset Config ────────────────────────────────────────────────────────────
function getTicketById(id) { return TICKET_TYPES.find(t => Number(t.id) === Number(id)) || TICKET_TYPES[0]; }
function nextZoneId() { return Date.now() + Math.random(); }

function makeRowLabel(idx, skipLetters) {
    const SKIP = new Set(['I','O','Q','V','U']);
    let chars = [];
    for (let c = 65; c <= 90; c++) {
        const ch = String.fromCharCode(c);
        if (!skipLetters || !SKIP.has(ch)) chars.push(ch);
    }
    let result = '', n = idx + 1;
    while (n > 0) { n--; result = chars[n % chars.length] + result; n = Math.floor(n / chars.length); }
    return result;
}

function calcBestGrid(total, maxRows = 10, maxCols = 14) {
    if (total <= 0) return { rows: 1, cols: 1 };
    let best = { rows: 1, cols: Math.min(total, maxCols), diff: Infinity };
    for (let r = 1; r <= maxRows; r++) {
        const c = Math.floor(total / r);
        if (c < 1 || c > maxCols) continue;
        if (r * c <= total) {
            const diff = Math.abs(c - r * 1.8);
            if (diff < best.diff) best = { rows: r, cols: c, diff };
        }
    }
    return { rows: best.rows, cols: best.cols };
}

function buildPresetZones(preset) {
    if (!TICKET_TYPES.length) return [];
    const sorted = [...TICKET_TYPES].sort((a, b) => b.price - a.price);
    const vip = sorted[0], upper = sorted.length > 1 ? sorted[1] : sorted[0];
    const std = sorted[sorted.length - 1];
    let result = [];

    if (preset === 'concert') {
        stageConfig = { x: 60, y: 50, title: 'SÂN KHẤU CHÍNH / MAIN STAGE' };
        const vipG = calcBestGrid(Math.min(vip.total, 80), 6, 12);
        result.push(makeZone('Khu SVIP / Fanzone (Chính diện)', vip.id, 'seated', vipG.rows, vipG.cols, 220, 200, vip.color || '#7c3aed'));
        const catG = calcBestGrid(Math.floor(upper.total / 2), 6, 8);
        result.push(makeZone('Khán đài CAT 1 (Cánh trái)', upper.id, 'seated', catG.rows, catG.cols, 30, 200, upper.color || '#4f46e5'));
        result.push(makeZone('Khán đài CAT 2 (Cánh phải)', upper.id, 'seated', catG.rows, catG.cols, 460, 200, upper.color || '#4f46e5'));
        const stdG = calcBestGrid(Math.min(std.total, 120), 5, 20);
        result.push(makeZone('Khán đài CAT 3 (Phía sau)', std.id, 'seated', stdG.rows, stdG.cols, 60, 440, std.color || '#0284c7'));

    } else if (preset === 'theatre') {
        stageConfig = { x: 180, y: 40, title: 'SÂN KHẤU VÒM / THEATRE STAGE' };
        const vipG = calcBestGrid(Math.min(vip.total, 60), 6, 12);
        result.push(makeZone('Tầng trệt VIP (Orchestra)', vip.id, 'seated', vipG.rows, vipG.cols, 220, 190, vip.color || '#dc2626'));
        const wingG = calcBestGrid(Math.floor(upper.total / 2), 5, 8);
        result.push(makeZone('Cánh gà trái (Left Box)', upper.id, 'seated', wingG.rows, wingG.cols, 30, 190, upper.color || '#d97706'));
        result.push(makeZone('Cánh gà phải (Right Box)', upper.id, 'seated', wingG.rows, wingG.cols, 460, 190, upper.color || '#d97706'));
        const balG = calcBestGrid(Math.min(std.total, 80), 5, 18);
        result.push(makeZone('Tầng lầu / Ban công', std.id, 'seated', balG.rows, balG.cols, 70, 430, std.color || '#059669'));

    } else if (preset === 'auditorium') {
        stageConfig = { x: 200, y: 40, title: 'SÂN KHẤU DIỄN GIẢ / MÀN HÌNH LED' };
        const sideG = calcBestGrid(Math.floor(std.total / 2), 8, 8);
        const cenG  = calcBestGrid(Math.min(vip.total, 80), 8, 10);
        result.push(makeZone('Dãy cánh trái (Block A)', std.id, 'seated', sideG.rows, sideG.cols, 20, 200, std.color || '#0284c7'));
        result.push(makeZone('Dãy giữa VIP (Block VIP)', vip.id, 'seated', cenG.rows, cenG.cols, 200, 200, vip.color || '#7c3aed'));
        result.push(makeZone('Dãy cánh phải (Block B)', std.id, 'seated', sideG.rows, sideG.cols, 460, 200, std.color || '#0284c7'));

    } else if (preset === 'arena') {
        stageConfig = { x: 180, y: 260, title: 'SÀN ĐẤU TRUNG TÂM / ARENA CENTER' };
        const aG = calcBestGrid(Math.min(vip.total, 60), 4, 12);
        const bG = calcBestGrid(Math.min(upper.total, 60), 4, 12);
        const sG = calcBestGrid(Math.floor(std.total / 2), 6, 6);
        result.push(makeZone('Khán đài A (VIP Bắc)', vip.id, 'seated', aG.rows, aG.cols, 150, 50, vip.color || '#7c3aed'));
        result.push(makeZone('Khán đài B (Khán đài Nam)', upper.id, 'seated', bG.rows, bG.cols, 150, 460, upper.color || '#4f46e5'));
        result.push(makeZone('Khán đài C (Cánh Tây)', std.id, 'seated', sG.rows, sG.cols, 20, 220, std.color || '#059669'));
        result.push(makeZone('Khán đài D (Cánh Đông)', std.id, 'seated', sG.rows, sG.cols, 480, 220, std.color || '#059669'));

    } else {
        stageConfig = { x: 200, y: 30, title: 'SÂN KHẤU CHÍNH / MAIN STAGE' };
        TICKET_TYPES.forEach((t, i) => {
            const g = calcBestGrid(Math.min(t.total, 40), 5, 8);
            result.push(makeZone('Khu vực ' + t.name, t.id, 'seated', g.rows, g.cols, (i % 3) * 230 + 20, Math.floor(i / 3) * 280 + 180, t.color || '#4f46e5'));
        });
    }
    return result;
}

function makeZone(name, ticketId, type, rows, cols, x, y, color, capacity = 200) {
    const t = getTicketById(ticketId);
    return {
        id: nextZoneId(),
        name,
        ticketId: Number(ticketId),
        type, // 'seated' | 'ga'
        rows: type === 'ga' ? 0 : Math.max(1, rows),
        cols: type === 'ga' ? 0 : Math.max(1, cols),
        capacity: type === 'ga' ? capacity : 0,
        color: color || t.color || '#4f46e5',
        x: Math.max(20, x),
        y: Math.max(20, y),
        prefix: '',
        numScheme: 'ltr',
        startNum: 1,
        skipLetters: 'yes',
        group: null // Konva group ref
    };
}

// ─── Render Canvas ───────────────────────────────────────────────────────────
function renderCanvas() {
    konvaLayer.destroyChildren();

    // Draw Stage
    const stW = 260, stH = 38;
    const stageG = new Konva.Group({ x: stageConfig.x, y: stageConfig.y });
    stageG.add(new Konva.Rect({ width: stW, height: stH, fill: '#1e1b4b', cornerRadius: 10, shadowColor: 'rgba(30,27,75,.25)', shadowBlur: 12, shadowOffsetY: 4 }));
    stageG.add(new Konva.Text({ x: 0, y: 0, width: stW, height: stH, text: stageConfig.title, fill: '#fff', fontSize: 11, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', align: 'center', verticalAlign: 'middle', letterSpacing: 2 }));
    konvaLayer.add(stageG);
    stageGroup = stageG;

    // Draw zones
    zones.forEach(z => renderZone(z));
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

function calcZoneSize(z) {
    if (z.type === 'ga') return { w: 200, h: 90 };
    const cols = Math.min(z.cols, 14);
    const rows = Math.min(z.rows, 8);
    const w = ZONE_PAD * 2 + ROW_LABEL_W + cols * (SEAT_W + SEAT_GAP);
    const h = ZONE_PAD + ZONE_HEADER_H + rows * (SEAT_H + ROW_GAP) + ZONE_PAD;
    return { w: Math.max(w, 140), h: Math.max(h, 80) };
}

function renderZone(z) {
    if (z.group) z.group.destroy();
    const { w, h } = calcZoneSize(z);
    const grp = new Konva.Group({ x: z.x, y: z.y, draggable: true });
    z.group = grp;

    // Zone background rect
    const fill = hexToRgba(z.color, 0.06);
    const bg = new Konva.Rect({ width: w, height: h, fill, stroke: z.color, strokeWidth: z.id === selectedZoneId ? 2.5 : 1.5, cornerRadius: 12, shadowColor: 'rgba(0,0,0,.06)', shadowBlur: 8, shadowOffsetY: 2 });
    if (z.type === 'ga') {
        bg.fillPriority('linear-gradient'); // we'll use pattern
        bg.fill('#fafafa');
        const pat = new Konva.Line({ points: [0,0, w,h, 0,2*h, -w,h], closed: true, fill: 'none', stroke: '#e2e8f0', strokeWidth: 1, visible: false });
        grp.add(pat);
        // Hatch lines for GA
        for (let i = -h; i < w + h; i += 16) {
            grp.add(new Konva.Line({ points: [i, 0, i + h, h], stroke: '#e2e8f0', strokeWidth: 1, listening: false }));
        }
    }
    grp.add(bg);

    // Zone header bar
    const headerBg = new Konva.Rect({ x: 0, y: 0, width: w, height: ZONE_HEADER_H, fill: hexToRgba(z.color, 0.1), cornerRadius: [12, 12, 0, 0] });
    grp.add(headerBg);

    const ticket = getTicketById(z.ticketId);
    const zoneName = new Konva.Text({ x: 10, y: 8, text: z.name, fill: z.color, fontSize: 11, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', width: w - 20, ellipsis: true });
    const zoneTicket = new Konva.Text({ x: 10, y: 20, text: (z.type === 'ga' ? '🧍 GA · ' : '') + ticket.name, fill: '#64748b', fontSize: 9.5, fontFamily: 'Inter,system-ui,sans-serif', width: w - 20, ellipsis: true });
    grp.add(zoneName, zoneTicket);

    if (z.type === 'ga') {
        const gaIcon = new Konva.Text({ x: 0, y: 36, width: w, height: h - 36, text: `${z.capacity || 100} người`, fill: z.color, fontSize: 14, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', align: 'center', verticalAlign: 'middle' });
        grp.add(gaIcon);
    } else {
        // Seat grid preview (max 8 rows, 14 cols for performance)
        const maxR = Math.min(z.rows, 8), maxC = Math.min(z.cols, 14);
        for (let r = 0; r < maxR; r++) {
            const rowLabel = makeRowLabel(r, z.skipLetters === 'yes');
            const rowLabelTxt = new Konva.Text({ x: ZONE_PAD, y: ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP) + (SEAT_H - 10) / 2, text: rowLabel, fill: '#94a3b8', fontSize: 9, fontStyle: 'bold', fontFamily: 'Inter,system-ui', width: ROW_LABEL_W, align: 'center', listening: false });
            grp.add(rowLabelTxt);
            for (let c = 0; c < maxC; c++) {
                const sx = ZONE_PAD + ROW_LABEL_W + c * (SEAT_W + SEAT_GAP);
                const sy = ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP);
                const seatRect = new Konva.Rect({ x: sx, y: sy, width: SEAT_W, height: SEAT_H, fill: hexToRgba(z.color, 0.1), stroke: z.color, strokeWidth: 1, cornerRadius: 5, listening: false });
                const numScheme = z.numScheme || 'ltr';
                let seatNum;
                if (numScheme === 'rtl') seatNum = z.startNum + (z.cols - 1 - c);
                else if (numScheme === 'odd') seatNum = z.startNum + c * 2;
                else if (numScheme === 'even') seatNum = (z.startNum || 2) + c * 2;
                else seatNum = z.startNum + c;
                const seatTxt = new Konva.Text({ x: sx, y: sy, width: SEAT_W, height: SEAT_H, text: String(seatNum), fill: z.color, fontSize: 8, fontStyle: 'bold', fontFamily: 'Inter', align: 'center', verticalAlign: 'middle', listening: false });
                grp.add(seatRect, seatTxt);
            }
            if (z.cols > 14) {
                const moreTxt = new Konva.Text({ x: ZONE_PAD + ROW_LABEL_W + 14 * (SEAT_W + SEAT_GAP) + 4, y: ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP) + 6, text: `+${z.cols - 14}`, fill: '#94a3b8', fontSize: 9, listening: false });
                grp.add(moreTxt);
            }
        }
        if (z.rows > 8) {
            const moreTxt = new Konva.Text({ x: ZONE_PAD + ROW_LABEL_W, y: ZONE_PAD + ZONE_HEADER_H + 8 * (SEAT_H + ROW_GAP) + 2, text: `+ ${z.rows - 8} hàng nữa`, fill: '#94a3b8', fontSize: 9, listening: false });
            grp.add(moreTxt);
        }
    }

    // Delete button (X) at top-right corner
    const delCircle = new Konva.Circle({ x: w - 10, y: 10, radius: 9, fill: '#fee2e2', opacity: 0 });
    const delTxt = new Konva.Text({ x: w - 18, y: 2, text: '✕', fill: '#dc2626', fontSize: 12, fontStyle: 'bold', opacity: 0 });
    grp.add(delCircle, delTxt);
    grp.on('mouseenter', () => { delCircle.opacity(1); delTxt.opacity(1); bg.shadowBlur(14); konvaLayer.batchDraw(); });
    grp.on('mouseleave', () => { delCircle.opacity(0); delTxt.opacity(0); bg.shadowBlur(8); konvaLayer.batchDraw(); });
    delCircle.on('click tap', e => { e.cancelBubble = true; removeZone(z.id); });
    delTxt.on('click tap', e => { e.cancelBubble = true; removeZone(z.id); });

    // Click to select
    grp.on('click tap', e => { if (e.target === delCircle || e.target === delTxt) return; selectZone(z.id); });

    // Drag end → update coords + push undo
    grp.on('dragend', () => {
        pushUndo();
        let nx = Math.round(grp.x() / GRID) * GRID;
        let ny = Math.round(grp.y() / GRID) * GRID;
        grp.position({ x: nx, y: ny });
        z.x = nx; z.y = ny;
        konvaLayer.batchDraw();
    });

    konvaLayer.add(grp);
    return grp;
}

function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return `rgba(${r},${g},${b},${alpha})`;
}

// ─── Zone CRUD ────────────────────────────────────────────────────────────────
function selectZone(id) {
    selectedZoneId = id;
    const z = zones.find(z => z.id === id);
    if (!z) return;
    document.getElementById('propsPlaceholder').style.display = 'none';
    document.getElementById('propsContent').style.display = '';
    document.getElementById('propsZoneTitle').textContent = z.name;
    document.getElementById('propsZoneColorDot').style.background = z.color;
    document.getElementById('pName').value = z.name;
    document.getElementById('pTicket').value = z.ticketId;
    document.getElementById('pColor').value = z.color;
    document.getElementById('pRows').value = z.rows || 5;
    document.getElementById('pCols').value = z.cols || 10;
    document.getElementById('pPrefix').value = z.prefix || '';
    document.getElementById('pNumScheme').value = z.numScheme || 'ltr';
    document.getElementById('pStartNum').value = z.startNum || 1;
    document.getElementById('pSkipLetters').value = z.skipLetters || 'yes';
    document.getElementById('pGaCap').value = z.capacity || 200;
    setZoneTypeUI(z.type);
    document.getElementById('tabSeats').style.opacity = z.type === 'ga' ? '0.4' : '1';
    updateCapTab(z);
    // Re-render to show selection highlight
    zones.forEach(zz => { if (zz.group) zz.group.findOne('Rect').strokeWidth(1.5); });
    if (z.group) z.group.findOne('Rect').strokeWidth(2.5);
    konvaLayer.batchDraw();
}

function deselectZone() {
    selectedZoneId = null;
    document.getElementById('propsPlaceholder').style.display = '';
    document.getElementById('propsContent').style.display = 'none';
    zones.forEach(z => { if (z.group) z.group.findOne('Rect')?.strokeWidth(1.5); });
    konvaLayer.batchDraw();
}

function updateSelectedZone(field, value) {
    const z = zones.find(z => z.id === selectedZoneId);
    if (!z) return;
    pushUndo();
    if (field === 'name') { z.name = value; document.getElementById('propsZoneTitle').textContent = value; }
    else if (field === 'ticketId') z.ticketId = Number(value);
    else if (field === 'color') { z.color = value; document.getElementById('propsZoneColorDot').style.background = value; }
    else if (field === 'rows') z.rows = Math.max(1, Math.min(50, Number(value)));
    else if (field === 'cols') z.cols = Math.max(1, Math.min(60, Number(value)));
    else if (field === 'prefix') z.prefix = value;
    else if (field === 'numScheme') z.numScheme = value;
    else if (field === 'startNum') z.startNum = Math.max(1, Number(value));
    else if (field === 'skipLetters') z.skipLetters = value;
    else if (field === 'capacity') z.capacity = Math.max(1, Number(value));
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateCapTab(z);
}

function setZoneType(type) {
    const z = zones.find(z => z.id === selectedZoneId);
    if (!z) return;
    pushUndo();
    z.type = type;
    setZoneTypeUI(type);
    if (type === 'ga') { z.rows = 0; z.cols = 0; z.capacity = z.capacity || 200; }
    else { z.rows = z.rows || 5; z.cols = z.cols || 10; }
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
}

function setZoneTypeUI(type) {
    document.getElementById('ztSeated').classList.toggle('active', type === 'seated');
    document.getElementById('ztGA').classList.toggle('active', type === 'ga');
    document.getElementById('gaCapField').style.display = type === 'ga' ? '' : 'none';
}

function addSeatedZone() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const z = makeZone('Khu vực ' + (zones.length + 1), t.id, 'seated', 5, 10, 20 + zones.length * 50, 120 + zones.length * 30, t.color || '#4f46e5');
    zones.push(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
    selectZone(z.id);
}

function addGAZone() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const z = makeZone('Khu đứng (GA) ' + (zones.length + 1), t.id, 'ga', 0, 0, 20 + zones.length * 40, 100 + zones.length * 20, t.color || '#f59e0b', 300);
    zones.push(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
    selectZone(z.id);
}

function removeZone(id) {
    pushUndo();
    const idx = zones.findIndex(z => z.id === id);
    if (idx < 0) return;
    if (zones[idx].group) zones[idx].group.destroy();
    zones.splice(idx, 1);
    if (selectedZoneId === id) deselectZone();
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

// ─── Undo / Redo ──────────────────────────────────────────────────────────────
function snapshotState() {
    return JSON.stringify(zones.map(z => ({
        id: z.id, name: z.name, ticketId: z.ticketId, type: z.type,
        rows: z.rows, cols: z.cols, capacity: z.capacity, color: z.color,
        x: z.x, y: z.y, prefix: z.prefix, numScheme: z.numScheme,
        startNum: z.startNum, skipLetters: z.skipLetters
    })));
}
function pushUndo() {
    undoStack.push(snapshotState());
    if (undoStack.length > 50) undoStack.shift();
    redoStack = [];
}
function restoreState(snap) {
    const data = JSON.parse(snap);
    zones.forEach(z => { if (z.group) z.group.destroy(); });
    zones = data.map(d => ({ ...d, group: null }));
    zones.forEach(z => renderZone(z));
    konvaLayer.batchDraw();
    updateStats(); updateSbZoneList();
    if (selectedZoneId && !zones.find(z => z.id === selectedZoneId)) deselectZone();
}
function undoAction() {
    if (!undoStack.length) return;
    redoStack.push(snapshotState());
    restoreState(undoStack.pop());
}
function redoAction() {
    if (!redoStack.length) return;
    undoStack.push(snapshotState());
    restoreState(redoStack.pop());
}

// ─── Stats & Sidebar ─────────────────────────────────────────────────────────
function updateStats() {
    const seatedTotal = zones.filter(z => z.type !== 'ga').reduce((s, z) => s + z.rows * z.cols, 0);
    const gaTotal = zones.filter(z => z.type === 'ga').reduce((s, z) => s + (z.capacity || 0), 0);
    document.getElementById('totalStatPill').textContent = `${seatedTotal + gaTotal} chỗ · ${zones.length} khu vực`;
}

function updateSbZoneList() {
    const list = document.getElementById('sbZoneList');
    list.innerHTML = '';
    zones.forEach(z => {
        const item = document.createElement('div');
        item.className = 'sb-zone-item' + (z.id === selectedZoneId ? ' selected' : '');
        item.style.setProperty('--zc', z.color);
        item.innerHTML = `<span class="sb-zone-name">${z.type === 'ga' ? '🧍 ' : ''}${z.name}</span>
            <button class="sb-zone-del" onclick="event.stopPropagation();removeZone(${z.id})" title="Xóa khu này">✕</button>`;
        item.addEventListener('click', () => selectZone(z.id));
        list.appendChild(item);
    });
}

function updateCapTab(z) {
    const container = document.getElementById('capDetails');
    if (!z) { container.innerHTML = ''; return; }
    const t = getTicketById(z.ticketId);
    let thisCap = z.type === 'ga' ? (z.capacity || 0) : (z.rows * z.cols);
    const allForTicket = zones.filter(zz => Number(zz.ticketId) === Number(z.ticketId));
    const totalForTicket = allForTicket.reduce((s, zz) => s + (zz.type === 'ga' ? (zz.capacity || 0) : zz.rows * zz.cols), 0);
    const pct = t.total > 0 ? Math.round(totalForTicket / t.total * 100) : 0;
    const ok = totalForTicket <= t.total;
    container.innerHTML = `
        <div style="display:flex;justify-content:space-between;margin-bottom:6px"><span>Khu này</span><strong>${thisCap} chỗ</strong></div>
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span>Tổng "${t.name}"</span><strong style="color:${ok ? '#047857' : '#be123c'}">${totalForTicket} / ${t.total} vé</strong></div>
        <div style="height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden">
            <div style="height:100%;width:${Math.min(pct,100)}%;background:${ok ? '#4f46e5' : '#dc2626'};border-radius:4px"></div>
        </div>
        <div style="margin-top:5px;font-size:.7rem;color:${ok ? '#047857' : '#be123c'};font-weight:700">${pct}% ${ok ? '✓ Khớp' : '⚠ Vượt quá số vé!'}</div>
    `;
}

// ─── Props Tabs ───────────────────────────────────────────────────────────────
function switchPropsTab(tab, btn) {
    document.querySelectorAll('.props-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tabBodyZone').classList.toggle('hidden', tab !== 'zone');
    document.getElementById('tabBodySeats').classList.toggle('hidden', tab !== 'seats');
    document.getElementById('tabBodyCap').classList.toggle('hidden', tab !== 'cap');
    if (tab === 'cap') { const z = zones.find(z => z.id === selectedZoneId); updateCapTab(z); }
}

// ─── Preset Select ─────────────────────────────────────────────────────────────
function selectPreset(preset) {
    currentPreset = preset;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b.dataset.preset === preset));
    pushUndo();
    zones.forEach(z => { if (z.group) z.group.destroy(); });
    zones = buildPresetZones(preset);

    const presetToDb = { concert: 'arena', theatre: 'theatre', auditorium: 'auditorium', arena: 'arena', custom: 'custom' };
    document.getElementById('loaiSoDoInput').value = presetToDb[preset] || 'custom';
    document.getElementById('skXInput').value = stageConfig.x;
    document.getElementById('skYInput').value = stageConfig.y;

    const names = {
        concert: 'Sơ đồ Live Concert - ' + EVENT_NAME,
        theatre: 'Sơ đồ Nhà hát Hòa nhạc - ' + EVENT_NAME,
        auditorium: 'Sơ đồ Hội nghị - ' + EVENT_NAME,
        arena: 'Sơ đồ Nhà thi đấu 4 hướng - ' + EVENT_NAME,
        custom: 'Sơ đồ tùy chỉnh - ' + EVENT_NAME,
    };
    document.getElementById('tenSoDoField').value = names[preset] || 'Sơ đồ - ' + EVENT_NAME;
    renderCanvas();
    deselectZone();
}

// ─── Export / Import ──────────────────────────────────────────────────────────
function exportBlueprint() {
    const data = { version: '1.0', preset: currentPreset, stage: stageConfig, zones: zones.map(z => ({
        name: z.name, ticketId: z.ticketId, type: z.type,
        rows: z.rows, cols: z.cols, capacity: z.capacity, color: z.color,
        x: z.x, y: z.y, prefix: z.prefix, numScheme: z.numScheme, startNum: z.startNum, skipLetters: z.skipLetters
    }))};
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `seating-${EVENT_NAME.replace(/\s+/g,'-')}.json`; a.click();
}

function importBlueprintFile(input) {
    const file = input.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        try {
            const data = JSON.parse(e.target.result);
            if (!data.zones) throw new Error('Invalid blueprint');
            pushUndo();
            zones.forEach(z => { if (z.group) z.group.destroy(); });
            if (data.stage) stageConfig = data.stage;
            zones = data.zones.map(d => makeZone(d.name, d.ticketId, d.type || 'seated', d.rows || 5, d.cols || 10, d.x || 20, d.y || 120, d.color, d.capacity || 200));
            zones.forEach((z, i) => { const d = data.zones[i]; z.prefix = d.prefix || ''; z.numScheme = d.numScheme || 'ltr'; z.startNum = d.startNum || 1; z.skipLetters = d.skipLetters || 'yes'; });
            renderCanvas();
            if (typeof WuangUI !== 'undefined') WuangUI.toast('Đã nhập sơ đồ thành công!', 'success');
        } catch (err) {
            if (typeof WuangUI !== 'undefined') WuangUI.toast('File JSON không hợp lệ', 'error');
        }
    };
    reader.readAsText(file);
    input.value = '';
}

// ─── Form Submit ──────────────────────────────────────────────────────────────
function submitNoSeatMap() {
    if (confirm('Bạn có chắc chắn muốn cấu hình sự kiện này thành BÁN VÉ TỰ DO (không chọn ghế)?')) {
        document.getElementById('noSeatForm').submit();
    }
}

function submitStudioForm() {
    const name = document.getElementById('tenSoDoField').value.trim();
    if (!name) { if (typeof WuangUI !== 'undefined') WuangUI.toast('Vui lòng nhập tên sơ đồ', 'error'); return; }
    if (!zones.length) { if (typeof WuangUI !== 'undefined') WuangUI.toast('Vui lòng thêm ít nhất 1 khu vực', 'error'); return; }

    // Đảm bảo mọi zone đều có loại vé hợp lệ
    zones.forEach(z => {
        if (!z.ticketId || !getTicketById(z.ticketId)) {
            z.ticketId = TICKET_TYPES[0]?.id;
        }
    });

    // Validate capacity
    const ticketMap = new Map();
    zones.forEach(z => {
        const cap = z.type === 'ga' ? (z.capacity || 0) : (z.rows * z.cols);
        ticketMap.set(z.ticketId, (ticketMap.get(z.ticketId) || 0) + cap);
    });
    for (const [tid, total] of ticketMap) {
        const t = getTicketById(tid);
        if (t && total > t.total) {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(`Loại vé "${t.name}" phân bổ ${total} chỗ nhưng chỉ có ${t.total} vé!`, 'error');
            return;
        }
    }

    document.getElementById('tenSoDoInput').value = name;
    document.getElementById('skXInput').value = Math.round(stageConfig?.x || 5);
    document.getElementById('skYInput').value = Math.round(stageConfig?.y || 1);

    // Build hidden inputs
    const container = document.getElementById('hiddenZoneInputs');
    container.innerHTML = '';
    const addInput = (name, value) => {
        const inp = document.createElement('input'); inp.type = 'hidden'; inp.name = name; inp.value = value; container.appendChild(inp);
    };
    zones.forEach(z => {
        addInput('zoneTen', z.name || 'Khu vực');
        addInput('zoneLoaiVeId', z.ticketId || TICKET_TYPES[0]?.id);
        addInput('zoneSoHang', z.type === 'ga' ? 0 : Math.max(1, z.rows || 5));
        addInput('zoneSoGheMoiHang', z.type === 'ga' ? 0 : Math.max(1, z.cols || 10));
        addInput('zoneMauSac', z.color || '#4f46e5');
        addInput('zoneViTriX', Math.round(z.x || 0));
        addInput('zoneViTriY', Math.round(z.y || 0));
        addInput('zoneLoaiKhuVuc', z.type || 'seated');
        addInput('zoneSucChua', z.type === 'ga' ? Math.max(1, z.capacity || 100) : 0);
        addInput('zoneTienTo', z.prefix || '');
        addInput('zoneHuongDanhSo', z.numScheme || 'ltr');
        addInput('zoneSoBatDau', z.startNum || 1);
    });

    document.getElementById('studioForm').submit();
}

// ─── Saved map zoom ───────────────────────────────────────────────────────────
let savedZoom = 1;
function adjZ(d) {
    savedZoom = Math.max(.6, Math.min(1.4, savedZoom + d));
    document.getElementById('zoomLbl').textContent = Math.round(savedZoom * 100) + '%';
    const g = document.getElementById('savedGrid');
    if (g) { g.style.transform = `scale(${savedZoom})`; g.style.transformOrigin = 'top center'; }
}
function resetZ() {
    savedZoom = 1;
    document.getElementById('zoomLbl').textContent = '100%';
    const g = document.getElementById('savedGrid');
    if (g) { g.style.transform = 'scale(1)'; }
}

// ─── AJAX Seat Toggle (saved map) ────────────────────────────────────────────
async function seatToggle(seatId) {
    const btn = document.getElementById('sb-' + seatId);
    if (!btn || btn.classList.contains('held') || btn.classList.contains('sold')) return;
    btn.classList.add('toggling');
    try {
        const fd = new FormData();
        fd.append('suKienId', EVENT_ID);
        fd.append('seatId', seatId);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
        const res = await fetch('/Organizer/DoiTrangThaiGheAjax', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            if (data.newStatus === 3) { btn.className = 'cseat locked'; btn.title = 'Mở khóa ghế này'; }
            else { btn.className = 'cseat'; btn.title = 'Khóa ghế này'; }
        } else {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(data.message || 'Không thể đổi trạng thái', 'error');
        }
    } catch { if (typeof WuangUI !== 'undefined') WuangUI.toast('Lỗi kết nối', 'error'); }
    finally { btn.classList.remove('toggling'); }
}

// ─── Bootstrap ───────────────────────────────────────────────────────────────
