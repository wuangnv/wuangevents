            <!-- PROPERTIES PANEL PHẢI -->
            <div class="studio-props" id="propsPanel">
                <div class="props-placeholder" id="propsPlaceholder">
                    <i class="fas fa-mouse-pointer"></i>
                    <p>Nhấp vào một khu vực trên bản vẽ để chỉnh sửa thuộc tính</p>
                </div>
                <div id="propsContent" style="display:none">
                    <h4 class="props-zone-title">
                        <span class="props-zone-color" id="propsZoneColorDot"></span>
                        <span id="propsZoneTitle">Khu vực</span>
                    </h4>
                    <div class="props-tab-bar">
                        <button class="props-tab active" onclick="switchPropsTab('zone',this)">Khu vực</button>
                        <button class="props-tab" onclick="switchPropsTab('seats',this)" id="tabSeats">Hàng &amp; Ghế</button>
                        <button class="props-tab" onclick="switchPropsTab('cap',this)">Sức chứa</button>
                    </div>

                    <!-- Tab Khu vực -->
                    <div class="props-body" id="tabBodyZone">
                        <div class="pf"><label>Tên khu vực</label><input type="text" id="pName" placeholder="Vd: Khu VIP A" oninput="updateSelectedZone('name',this.value)" /></div>
                        <div class="pf"><label>Loại vé</label>
                            <select id="pTicket" onchange="updateSelectedZone('ticketId',this.value)">
                                @foreach (var ve in loaiVes)
                                {
                                    <option value="@ve.Id">@ve.TenLoaiVe (@ve.GiaBan.ToString("N0")đ · @ve.SoLuongTong vé)</option>
                                }
                            </select>
                        </div>
                        <div class="pf"><label>Màu sắc</label><input type="color" id="pColor" oninput="updateSelectedZone('color',this.value)" /></div>
                        <div class="pf">
                            <label>Kiểu khu vực</label>
                            <div class="zone-type-switch">
                                <button type="button" class="zt-btn active" id="ztSeated" onclick="setZoneType('seated')"><i class="fas fa-chair me-1"></i>Ghế ngồi</button>
                                <button type="button" class="zt-btn" id="ztBanquet" onclick="setZoneType('banquet')"><i class="fas fa-utensils me-1"></i>Bàn tiệc</button>
                                <button type="button" class="zt-btn" id="ztGA" onclick="setZoneType('ga')"><i class="fas fa-person-walking me-1"></i>Khu đứng (GA)</button>
                            </div>
