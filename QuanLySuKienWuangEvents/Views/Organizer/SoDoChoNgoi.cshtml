.layout-preview-title-wrap{display:flex;align-items:center;gap:9px;min-width:0}.map-summary{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#f4f0ff;color:#6d28d9;font-size:.72rem;font-weight:800;white-space:nowrap}.map-summary i{font-size:.68rem}.designer-mode{display:flex;align-items:center;gap:7px;margin:0 0 12px}.designer-mode span{font-size:.74rem;color:#64748b;font-weight:750}.designer-mode strong{font-size:.78rem;color:#312e81}.drag-layout .preview-zone{justify-content:flex-start;padding:20px 9px 9px;gap:5px;border-width:2px;transition:transform .15s,box-shadow .15s,outline .15s}.drag-layout .preview-zone:hover{transform:translateY(-1px);box-shadow:0 12px 24px color-mix(in srgb,var(--preview-color) 26%,transparent)}.drag-layout .preview-zone.selected-zone{outline:3px solid #6d28d9;outline-offset:2px;box-shadow:0 0 0 5px rgba(124,58,237,.14),0 12px 24px color-mix(in srgb,var(--preview-color) 24%,transparent)}.drag-handle{position:absolute;top:5px;left:6px;width:20px;height:20px;display:grid;place-items:center;border-radius:6px;background:rgba(255,255,255,.82);color:#5b21b6;font-size:.58rem;z-index:3}.resize-handle{position:absolute;right:5px;bottom:5px;width:18px;height:18px;border:0;border-radius:5px;background:#fff;color:#5b21b6;font-size:.63rem;display:grid;place-items:center;cursor:nwse-resize;box-shadow:0 2px 7px rgba(49,46,129,.18);z-index:4}.resize-handle:hover{background:#ede9fe}.mini-seat-grid{width:min(100%,230px);padding:3px 5px;gap:4px}.mini-seat{height:10px;border-radius:5px 5px 3px 3px;border:1px solid var(--preview-color);background:color-mix(in srgb,var(--preview-color) 20%,white);box-shadow:inset 0 2px 0 color-mix(in srgb,var(--preview-color) 48%,white),0 1px 1px rgba(15,23,42,.08);position:relative}.mini-seat:after{content:"";position:absolute;left:18%;right:18%;bottom:-3px;height:3px;border-radius:0 0 3px 3px;background:var(--preview-color);opacity:.68}.drag-layout .preview-zone small{margin-top:auto;font-size:.66rem;font-weight:800;background:rgba(255,255,255,.66);padding:2px 6px;border-radius:999px}.preview-zone-name{font-size:.72rem!important;font-weight:850}.zone-inspector{margin:0 0 14px;padding:15px 16px;border:1px solid #ded4ff;border-radius:15px;background:linear-gradient(135deg,#fbfaff,#f6f3ff);box-shadow:0 8px 18px rgba(76,29,149,.05)}.zone-inspector-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}.zone-inspector-head strong{color:#312e81;font-size:.88rem}.zone-inspector-head span{color:#64748b;font-size:.74rem;font-weight:750}.zone-inspector-grid{display:grid;grid-template-columns:minmax(180px,1.2fr) minmax(180px,1fr) auto;gap:10px;align-items:end}.zone-stepper{display:flex;align-items:center;gap:6px;height:40px;border:1px solid #ddd6fe;border-radius:10px;background:#fff;padding:4px 5px}.zone-stepper button{width:29px;height:29px;border:0;border-radius:7px;background:#f3e8ff;color:#6d28d9;font-weight:900}.zone-stepper button:hover{background:#ddd6fe}.zone-stepper strong{flex:1;text-align:center;font-size:.78rem;color:#312e81}.inspector-actions{display:flex;gap:7px;flex-wrap:wrap}.inspector-actions button{height:40px;border-radius:10px;padding:0 11px;font-size:.76rem;font-weight:800}.duplicate-zone{border:1px solid #c4b5fd;background:#fff;color:#6d28d9}.remove-selected-zone{border:1px solid #fecaca;background:#fff;color:#dc2626}.zone-list-title{display:flex;justify-content:space-between;align-items:center;margin:4px 0 8px;color:#475569;font-size:.76rem;font-weight:850}.zone-card.selected-card{border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(124,58,237,.1)}.zone-card{cursor:pointer}.zone-card .zone-head strong:before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--zone-color,#7c3aed);margin-right:7px}.tool-btn.select-tool{background:#fff}.tool-btn.select-tool.active{background:#ede9fe}.drag-layout.custom-tool-select .drop-slot{cursor:default}.drag-layout.custom-tool-draw .drop-slot{cursor:crosshair}.drag-layout.custom-tool-stage .drop-slot{cursor:copy}@@media(max-width:850px){.layout-preview-head{align-items:flex-start}.layout-preview-title-wrap{display:block}.map-summary{margin-top:6px}.zone-inspector-grid{grid-template-columns:1fr}.inspector-actions{display:grid;grid-template-columns:1fr 1fr}.designer-mode{display:block}.designer-mode strong{display:block;margin-top:3px}.mini-seat{height:8px}.mini-seat-grid{gap:3px}}
