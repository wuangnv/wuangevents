                            <div class="pf"><label>Ghế / hàng</label><input type="number" id="pCols" min="1" max="30" oninput="updateSelectedZone('cols',this.value)" /></div>
                        </div>
                        <div class="pf"><label>Tiền tố tên hàng</label><input type="text" id="pPrefix" maxlength="10" placeholder="Bỏ trống = A, B, C..." oninput="updateSelectedZone('prefix',this.value)" /></div>
                        <div class="pf">
