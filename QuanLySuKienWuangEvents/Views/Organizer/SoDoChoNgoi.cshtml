                            <label>Bỏ qua chữ dễ nhầm (I, O, Q)</label>
                            <select id="pSkipLetters" onchange="updateSelectedZone('skipLetters',this.value)">
                                <option value="yes">Có (Chuẩn quốc tế)</option>
                                <option value="no">Không</option>
