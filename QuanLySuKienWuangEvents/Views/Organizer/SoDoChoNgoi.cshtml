                            <div class="pf" id="pRowsField"><label>Số hàng</label><input type="number" id="pRows" min="1" max="20" oninput="updateSelectedZone('rows',this.value)" /></div>
                        </div>
                        <div class="pf" id="pColsField"><label>Ghế / hàng (tự tính)</label><input type="number" id="pCols" readonly tabindex="-1" /></div>
                        <div class="pf" id="pPrefixField"><label>Tiền tố tên hàng</label><input type="text" id="pPrefix" maxlength="10" placeholder="Bỏ trống = A, B, C..." oninput="updateSelectedZone('prefix',this.value)" /></div>
                        <div class="pf" id="pNumSchemeField">
                            <label>Kiểu đánh số ghế</label>
                            <select id="pNumScheme" onchange="updateSelectedZone('numScheme',this.value)">
                                <option value="ltr">Liên tục Trái → Phải (1, 2, 3...)</option>
                                <option value="rtl">Liên tục Phải → Trái (N...2, 1)</option>
                                <option value="odd">Lẻ (1, 3, 5...)</option>
                                <option value="even">Chẵn (2, 4, 6...)</option>
                            </select>
                        </div>
                        <div class="pf" id="pStartNumField"><label>Số ghế bắt đầu</label><input type="number" id="pStartNum" min="1" max="999" value="1" oninput="updateSelectedZone('startNum',this.value)" /></div>
                        <div class="pf" id="pSkipLettersField">
                            <label>Bỏ qua chữ dễ nhầm (I, O, Q)</label>
