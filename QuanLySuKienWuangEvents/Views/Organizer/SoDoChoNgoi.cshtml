@model SoDoChoNgoi
@using System.Text.Json
@inject IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_OrganizerSimpleLayout.cshtml";
    ViewData["Title"] = "Sơ đồ chỗ ngồi";
    var suKienId = (Guid)ViewBag.SuKienId;
    var loaiVes = ViewBag.LoaiVes as List<LoaiVe> ?? new();
    var ghe = ViewBag.Ghe as List<ChoNgoi> ?? new();
    var hang = ViewBag.Hang as Dictionary<int, string> ?? new();
    var khuVucTheoHang = ViewBag.KhuVucTheoHang as Dictionary<int, KhuVuc> ?? new();
    var cacKhuVuc = khuVucTheoHang.Values.GroupBy(x => x.Id).Select(x => x.First()).OrderBy(x => x.ThuTu).ToList();
    var cacBoCuc = new[] { "auditorium", "theatre", "cinema", "concert", "arena", "custom" };
    string boCucDaLuu = cacBoCuc.Contains(Model.LoaiSoDo) ? Model.LoaiSoDo : "custom";
    int soTrong = ghe.Count(x => x.TrangThai == 0), dangGiu = ghe.Count(x => x.TrangThai == 1);
    int daBan = ghe.Count(x => x.TrangThai == 2), daKhoa = ghe.Count(x => x.TrangThai == 3);
    bool isExpired = ViewBag.NgayKetThucSuKien != null && VietnamTime.Now > (DateTime)ViewBag.NgayKetThucSuKien;
    bool isLocked = ViewBag.TrangThaiSuKien is not (0 or 2 or 7) || isExpired;
    string loaiVeJson = JsonSerializer.Serialize(loaiVes.Select(x => new { id=x.Id,name=x.TenLoaiVe,price=x.GiaBan,total=x.SoLuongTong,color=x.MauSac ?? "#7c3aed" }));
    string tenSuKienJson = JsonSerializer.Serialize((string?)ViewBag.TenSuKien ?? "");
    bool suDungKeoTha = Configuration.GetValue<bool?>("SeatMapEditor:EnableDragDrop") ?? true;
}

