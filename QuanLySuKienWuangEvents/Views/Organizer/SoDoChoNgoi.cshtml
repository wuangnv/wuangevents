</main>

@section Scripts {
<script src="https://unpkg.com/konva@9/konva.min.js"></script>
<script>
const EVENT_ID = '@suKienId';
const TICKET_TYPES = @Html.Raw(loaiVeJson);
const EVENT_NAME = @Html.Raw(tenSuKienJson);
const SKIP_LETTERS = new Set(['I','O','Q','V','U']);
const GRID = 20; // snap grid px
const MAP_WIDTH = 1200, MAP_HEIGHT = 800;
const SEAT_W = 28, SEAT_H = 24, SEAT_GAP = 4;
const ROW_LABEL_W = 26, ROW_GAP = 6;
const ZONE_PAD = 12, ZONE_HEADER_H = 32;

let currentPreset = 'concert';
let zones = []; // Array of zone objects
let selectedZoneId = null;
let undoStack = [], redoStack = [];
let konvaStage, konvaLayer, konvaBgLayer;
let stageGroup = null;
let stageConfig = { x: 440, y: 36, width: 320, height: 48, title: 'SÂN KHẤU' };

// ─── Init Konva Stage ──────────────────────────────────────────────────────
function initKonva() {
    const container = document.getElementById('konva-container');
    konvaStage = new Konva.Stage({ container: 'konva-container', width: container.clientWidth, height: container.clientHeight });
    konvaBgLayer = new Konva.Layer();
    konvaLayer  = new Konva.Layer();
    konvaStage.add(konvaBgLayer);
    konvaStage.add(konvaLayer);

    drawDotGrid();
    konvaStage.on('wheel', handleWheel);
    konvaStage.on('mousedown touchstart', handlePanStart);
    konvaStage.on('mousemove touchmove', handlePanMove);
    konvaStage.on('mouseup touchend', handlePanEnd);
    konvaStage.on('click tap', e => { if (e.target === konvaStage || e.target.hasName('bg-rect')) deselectZone(); });

    window.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !e.shiftKey) { e.preventDefault(); undoAction(); }
        if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.key === 'z' && e.shiftKey))) { e.preventDefault(); redoAction(); }
    });

    // Canvas logic is 1200 × 800, but the available screen width varies.
    // Recalculate the view rather than leaving the right part of the map cropped.
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            if (!container.clientWidth || !container.clientHeight) return;
            konvaStage.size({ width: container.clientWidth, height: container.clientHeight });
            drawDotGrid();
            konvaFitView();
        }, 120);
    });
}

function drawDotGrid() {
    konvaBgLayer.destroyChildren();
    const bgRect = new Konva.Rect({ x: 0, y: 0, width: MAP_WIDTH, height: MAP_HEIGHT, fill: '#f8fafc', name: 'bg-rect' });
    konvaBgLayer.add(bgRect);
    for (let x = GRID; x < MAP_WIDTH; x += GRID) {
        for (let y = GRID; y < MAP_HEIGHT; y += GRID) {
            konvaBgLayer.add(new Konva.Circle({ x, y, radius: 1, fill: '#cbd5e1', opacity: 0.5 }));
        }
    }
    konvaBgLayer.batchDraw();
}

// ─── Pan handling ────────────────────────────────────────────────────────────
let isPanning = false, panStart = { x: 0, y: 0 }, panOrigin = { x: 0, y: 0 };
function handlePanStart(e) {
    if (e.target !== konvaStage && !e.target.hasName('bg-rect')) return;
    isPanning = true;
    panStart = konvaStage.getPointerPosition();
    panOrigin = { x: konvaLayer.x(), y: konvaLayer.y() };
}
function handlePanMove(e) {
    if (!isPanning) return;
    const pos = konvaStage.getPointerPosition();
    konvaLayer.x(panOrigin.x + pos.x - panStart.x);
    konvaLayer.y(panOrigin.y + pos.y - panStart.y);
    konvaBgLayer.position(konvaLayer.position());
    konvaLayer.batchDraw(); konvaBgLayer.batchDraw();
}
function handlePanEnd() { isPanning = false; }

function applyKonvaTransform(scale, x, y) {
    konvaLayer.scale({ x: scale, y: scale });
    konvaLayer.position({ x, y });
    konvaBgLayer.scale({ x: scale, y: scale });
    konvaBgLayer.position({ x, y });
    konvaLayer.batchDraw();
    konvaBgLayer.batchDraw();
    document.getElementById('konvaZoomLbl').textContent = Math.round(scale * 100) + '%';
}

function getFitScale() {
    const padding = 28;
    return Math.max(0.35, Math.min(
        1,
        (konvaStage.width() - padding * 2) / MAP_WIDTH,
        (konvaStage.height() - padding * 2) / MAP_HEIGHT
    ));
}

// ─── Wheel Zoom ──────────────────────────────────────────────────────────────
function handleWheel(e) {
    e.evt.preventDefault();
    const scaleBy = 1.08;
    const oldScale = konvaLayer.scaleX();
    const pointer = konvaStage.getPointerPosition();
    const mousePointTo = { x: (pointer.x - konvaLayer.x()) / oldScale, y: (pointer.y - konvaLayer.y()) / oldScale };
    const newScale = e.evt.deltaY < 0 ? oldScale * scaleBy : oldScale / scaleBy;
    const clamped = Math.min(Math.max(newScale, 0.3), 3);
    applyKonvaTransform(
        clamped,
        pointer.x - mousePointTo.x * clamped,
        pointer.y - mousePointTo.y * clamped
    );
}
function konvaZoom(delta) {
    const sc = Math.min(Math.max(konvaLayer.scaleX() + delta, 0.3), 3);
    const center = { x: konvaStage.width() / 2, y: konvaStage.height() / 2 };
    const logicalCenter = {
        x: (center.x - konvaLayer.x()) / konvaLayer.scaleX(),
        y: (center.y - konvaLayer.y()) / konvaLayer.scaleY()
    };
    applyKonvaTransform(sc, center.x - logicalCenter.x * sc, center.y - logicalCenter.y * sc);
}
function konvaFitView() {
    const scale = getFitScale();
    applyKonvaTransform(
        scale,
        Math.max(12, Math.round((konvaStage.width() - MAP_WIDTH * scale) / 2)),
        Math.max(12, Math.round((konvaStage.height() - MAP_HEIGHT * scale) / 2))
    );
}

// ─── Preset Config ────────────────────────────────────────────────────────────
function getTicketById(id) { return TICKET_TYPES.find(t => Number(t.id) === Number(id)) || TICKET_TYPES[0]; }
function activeTicketTypes() { return TICKET_TYPES.filter(ticket => ticket.enabled !== false); }
function nextZoneId() { return Date.now() + Math.random(); }

function makeRowLabel(idx, skipLetters) {
    const SKIP = new Set(['I','O','Q','V','U']);
    let chars = [];
    for (let c = 65; c <= 90; c++) {
        const ch = String.fromCharCode(c);
        if (!skipLetters || !SKIP.has(ch)) chars.push(ch);
    }
    let result = '', n = idx + 1;
    while (n > 0) { n--; result = chars[n % chars.length] + result; n = Math.floor(n / chars.length); }
    return result;
}

function ticketAt(index) { return TICKET_TYPES[index % TICKET_TYPES.length]; }

// Mỗi mẫu tự thu gọn số ghế để không phân bổ vượt tồn kho của loại vé đang được gán.
function fitPresetCapacities(items) {
    const grouped = new Map();
    items.forEach(item => {
        const group = grouped.get(item.ticketId) || [];
        group.push(item); grouped.set(item.ticketId, group);
    });
    grouped.forEach((itemsForTicket, ticketId) => {
        const ticket = getTicketById(ticketId);
        const perZone = Math.max(1, Math.floor(Number(ticket?.total || 1) / itemsForTicket.length));
        itemsForTicket.forEach(item => {
            if (item.type === 'ga') { item.capacity = Math.min(item.capacity, perZone); return; }
            const wanted = item.rows * item.cols;
            if (wanted <= perZone) return;
            let best = { rows: 1, cols: 1, seats: 1 };
            for (let rows = 1; rows <= item.rows; rows++) {
                for (let cols = 1; cols <= item.cols; cols++) {
                    const seats = rows * cols;
                    if (seats <= perZone && seats > best.seats) best = { rows, cols, seats };
                }
            }
            item.rows = best.rows; item.cols = best.cols;
        });
    });
    return items;
}

// Các mẫu là điểm xuất phát có bố cục thực tế; người tổ chức vẫn chọn loại vé trong bảng thuộc tính.
function buildPresetZones(preset) {
    if (!TICKET_TYPES.length) return [];
    const zone = (name, ticketIndex, rows, cols, x, y, color) => {
        const ticket = ticketAt(ticketIndex);
        return makeZone(name, ticket.id, 'seated', rows, cols, x, y, color || ticket.color);
    };
    let result;
    if (preset === 'concert') {
        stageConfig = { x: 440, y: 36, width: 320, height: 48, title: 'SÂN KHẤU' };
        result = [
            zone('Khu trung tâm', 0, 7, 12, 383, 150),
            zone('Khán đài trái', 1, 5, 8, 60, 300),
            zone('Khán đài phải', 1, 5, 8, 834, 300),
            zone('Khán đài sau', 2, 5, 18, 287, 510)
        ];
    } else if (preset === 'theatre') {
        stageConfig = { x: 420, y: 36, width: 360, height: 48, title: 'SÂN KHẤU' };
        result = [
            zone('Tầng trệt', 0, 8, 14, 350, 145),
            zone('Lô ghế trái', 1, 4, 6, 70, 230),
            zone('Lô ghế phải', 1, 4, 6, 888, 230),
            zone('Ban công', 2, 5, 18, 287, 490)
        ];
    } else if (preset === 'auditorium') {
        stageConfig = { x: 410, y: 36, width: 380, height: 48, title: 'SÂN KHẤU / MÀN HÌNH' };
        result = [
            zone('Khối A', 0, 8, 8, 80, 145),
            zone('Khối trung tâm', 1, 8, 12, 383, 145),
            zone('Khối B', 0, 8, 8, 814, 145),
            zone('Khối phía sau', 2, 4, 16, 319, 510)
        ];
    } else if (preset === 'arena') {
        stageConfig = { x: 420, y: 345, width: 360, height: 88, title: 'SÀN ĐẤU / SÂN KHẤU' };
        result = [
            zone('Khán đài Bắc', 0, 5, 14, 350, 90),
            zone('Khán đài Nam', 1, 5, 14, 350, 550),
            zone('Khán đài Tây', 2, 7, 6, 70, 275),
            zone('Khán đài Đông', 2, 7, 6, 888, 275)
        ];
    } else {
        stageConfig = { x: 440, y: 36, width: 320, height: 48, title: 'SÂN KHẤU' };
        result = TICKET_TYPES.slice(0, 6).map((ticket, index) =>
            makeZone('Khu ' + ticket.name, ticket.id, 'seated', 5, 10,
                60 + (index % 3) * 390, 155 + Math.floor(index / 3) * 300, ticket.color));
    }
    return fitPresetCapacities(result);
}

function makeZone(name, ticketId, type, rows, cols, x, y, color, capacity = 200) {
    const t = getTicketById(ticketId);
    return {
        id: nextZoneId(),
        name,
        ticketId: Number(ticketId),
        type, // 'seated' | 'ga'
        rows: type === 'ga' ? 0 : Math.max(1, rows),
        cols: type === 'ga' ? 0 : Math.max(1, cols),
        capacity: type === 'ga' ? capacity : 0,
        color: color || t.color || '#4f46e5',
        x: Math.max(20, x),
        y: Math.max(20, y),
        prefix: '',
        numScheme: 'ltr',
        startNum: 1,
        skipLetters: 'yes',
        group: null // Konva group ref
    };
}

// ─── Render Canvas ───────────────────────────────────────────────────────────
function renderCanvas() {
    konvaLayer.destroyChildren();

    // Draw Stage
    const stW = stageConfig.width || 320, stH = stageConfig.height || 48;
    const stageG = new Konva.Group({ x: stageConfig.x, y: stageConfig.y, draggable: true });
    stageG.add(new Konva.Rect({ width: stW, height: stH, fill: '#1e1b4b', cornerRadius: 10, shadowColor: 'rgba(30,27,75,.25)', shadowBlur: 12, shadowOffsetY: 4 }));
    stageG.add(new Konva.Text({ x: 0, y: 0, width: stW, height: stH, text: stageConfig.title, fill: '#fff', fontSize: 11, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', align: 'center', verticalAlign: 'middle', letterSpacing: 2 }));
    konvaLayer.add(stageG);
    stageGroup = stageG;
    stageG.on('dragend', () => {
        pushUndo();
        const x = Math.max(0, Math.min(MAP_WIDTH - stW, Math.round(stageG.x() / GRID) * GRID));
        const y = Math.max(0, Math.min(MAP_HEIGHT - stH, Math.round(stageG.y() / GRID) * GRID));
        stageG.position({ x, y });
        stageConfig.x = x; stageConfig.y = y;
        konvaLayer.batchDraw();
    });

    // Draw zones
    zones.forEach(z => renderZone(z));
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

function calcZoneSize(z) {
    if (z.type === 'ga') return { w: 240, h: 130 };
    const cols = Math.max(1, z.cols);
    const rows = Math.max(1, z.rows);
    const w = ZONE_PAD * 2 + ROW_LABEL_W + cols * (SEAT_W + SEAT_GAP);
    const h = ZONE_PAD + ZONE_HEADER_H + rows * (SEAT_H + ROW_GAP) + ZONE_PAD;
    return { w: Math.max(w, 140), h: Math.max(h, 80) };
}

// Khi người dùng tăng số hàng/cột, khu có thể rộng hơn vị trí cũ.
// Luôn kéo nó trở lại phần bản vẽ hợp lệ để không phát sinh lỗi lúc lưu.
function keepZoneInsideCanvas(z) {
    const { w, h } = calcZoneSize(z);
    z.x = Math.max(0, Math.min(MAP_WIDTH - w, Math.round(Number(z.x || 0) / GRID) * GRID));
    z.y = Math.max(0, Math.min(MAP_HEIGHT - h, Math.round(Number(z.y || 0) / GRID) * GRID));
}

function renderZone(z) {
    if (z.group) z.group.destroy();
    const { w, h } = calcZoneSize(z);
    const grp = new Konva.Group({ x: z.x, y: z.y, draggable: true });
    z.group = grp;

    // Zone background rect
    const fill = hexToRgba(z.color, 0.06);
    const bg = new Konva.Rect({ width: w, height: h, fill, stroke: z.color, strokeWidth: z.id === selectedZoneId ? 2.5 : 1.5, cornerRadius: 12, shadowColor: 'rgba(0,0,0,.06)', shadowBlur: 8, shadowOffsetY: 2 });
    if (z.type === 'ga') {
        bg.fillPriority('linear-gradient'); // we'll use pattern
        bg.fill('#fafafa');
        const pat = new Konva.Line({ points: [0,0, w,h, 0,2*h, -w,h], closed: true, fill: 'none', stroke: '#e2e8f0', strokeWidth: 1, visible: false });
        grp.add(pat);
        // Hatch lines for GA
        for (let i = -h; i < w + h; i += 16) {
            grp.add(new Konva.Line({ points: [i, 0, i + h, h], stroke: '#e2e8f0', strokeWidth: 1, listening: false }));
        }
    }
    grp.add(bg);

    // Zone header bar
    const headerBg = new Konva.Rect({ x: 0, y: 0, width: w, height: ZONE_HEADER_H, fill: hexToRgba(z.color, 0.1), cornerRadius: [12, 12, 0, 0] });
    grp.add(headerBg);

    const ticket = getTicketById(z.ticketId);
    const zoneName = new Konva.Text({ x: 10, y: 8, text: z.name, fill: z.color, fontSize: 11, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', width: w - 20, ellipsis: true });
    const zoneTicket = new Konva.Text({ x: 10, y: 20, text: (z.type === 'ga' ? '🧍 GA · ' : '') + ticket.name, fill: '#64748b', fontSize: 9.5, fontFamily: 'Inter,system-ui,sans-serif', width: w - 20, ellipsis: true });
    grp.add(zoneName, zoneTicket);

    if (z.type === 'ga') {
        const gaIcon = new Konva.Text({ x: 0, y: 36, width: w, height: h - 36, text: `${z.capacity || 100} người`, fill: z.color, fontSize: 14, fontStyle: 'bold', fontFamily: 'Inter,system-ui,sans-serif', align: 'center', verticalAlign: 'middle' });
        grp.add(gaIcon);
    } else {
        // Toàn bộ ghế được vẽ đúng số hàng/cột sẽ lưu, không dùng bản xem trước bị cắt.
        for (let r = 0; r < z.rows; r++) {
            const rowLabel = makeRowLabel(r, z.skipLetters === 'yes');
            const rowLabelTxt = new Konva.Text({ x: ZONE_PAD, y: ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP) + (SEAT_H - 10) / 2, text: rowLabel, fill: '#94a3b8', fontSize: 9, fontStyle: 'bold', fontFamily: 'Inter,system-ui', width: ROW_LABEL_W, align: 'center', listening: false });
            grp.add(rowLabelTxt);
            for (let c = 0; c < z.cols; c++) {
                const sx = ZONE_PAD + ROW_LABEL_W + c * (SEAT_W + SEAT_GAP);
                const sy = ZONE_PAD + ZONE_HEADER_H + r * (SEAT_H + ROW_GAP);
                const seatRect = new Konva.Rect({ x: sx, y: sy, width: SEAT_W, height: SEAT_H, fill: hexToRgba(z.color, 0.1), stroke: z.color, strokeWidth: 1, cornerRadius: 5, listening: false });
                const numScheme = z.numScheme || 'ltr';
                let seatNum;
                if (numScheme === 'rtl') seatNum = z.startNum + (z.cols - 1 - c);
                else if (numScheme === 'odd') seatNum = z.startNum + c * 2;
                else if (numScheme === 'even') seatNum = (z.startNum || 2) + c * 2;
                else seatNum = z.startNum + c;
                const seatTxt = new Konva.Text({ x: sx, y: sy, width: SEAT_W, height: SEAT_H, text: String(seatNum), fill: z.color, fontSize: 8, fontStyle: 'bold', fontFamily: 'Inter', align: 'center', verticalAlign: 'middle', listening: false });
                grp.add(seatRect, seatTxt);
            }
        }
    }

    // Delete button (X) at top-right corner
    const delCircle = new Konva.Circle({ x: w - 10, y: 10, radius: 9, fill: '#fee2e2', opacity: 0 });
    const delTxt = new Konva.Text({ x: w - 18, y: 2, text: '✕', fill: '#dc2626', fontSize: 12, fontStyle: 'bold', opacity: 0 });
    grp.add(delCircle, delTxt);
    grp.on('mouseenter', () => { delCircle.opacity(1); delTxt.opacity(1); bg.shadowBlur(14); konvaLayer.batchDraw(); });
    grp.on('mouseleave', () => { delCircle.opacity(0); delTxt.opacity(0); bg.shadowBlur(8); konvaLayer.batchDraw(); });
    delCircle.on('click tap', e => { e.cancelBubble = true; removeZone(z.id); });
    delTxt.on('click tap', e => { e.cancelBubble = true; removeZone(z.id); });

    // Click to select
    grp.on('click tap', e => { if (e.target === delCircle || e.target === delTxt) return; selectZone(z.id); });

    // Drag end → update coords + push undo
    grp.on('dragend', () => {
        pushUndo();
        let nx = Math.round(grp.x() / GRID) * GRID;
        let ny = Math.round(grp.y() / GRID) * GRID;
        nx = Math.max(0, Math.min(MAP_WIDTH - w, nx));
        ny = Math.max(0, Math.min(MAP_HEIGHT - h, ny));
        grp.position({ x: nx, y: ny });
        z.x = nx; z.y = ny;
        konvaLayer.batchDraw();
    });

    konvaLayer.add(grp);
    return grp;
}

function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return `rgba(${r},${g},${b},${alpha})`;
}

// ─── Zone CRUD ────────────────────────────────────────────────────────────────
function selectZone(id) {
    selectedZoneId = id;
    const z = zones.find(z => z.id === id);
    if (!z) return;
    document.getElementById('propsPlaceholder').style.display = 'none';
    document.getElementById('propsContent').style.display = '';
    document.getElementById('propsZoneTitle').textContent = z.name;
    document.getElementById('propsZoneColorDot').style.background = z.color;
    document.getElementById('pName').value = z.name;
    document.getElementById('pTicket').value = z.ticketId;
    document.getElementById('pColor').value = z.color;
    document.getElementById('pRows').value = z.rows || 5;
    document.getElementById('pCols').value = z.cols || 10;
    document.getElementById('pPrefix').value = z.prefix || '';
    document.getElementById('pNumScheme').value = z.numScheme || 'ltr';
    document.getElementById('pStartNum').value = z.startNum || 1;
    document.getElementById('pSkipLetters').value = z.skipLetters || 'yes';
    document.getElementById('pGaCap').value = z.capacity || 200;
    setZoneTypeUI(z.type);
    document.getElementById('tabSeats').style.opacity = z.type === 'ga' ? '0.4' : '1';
    updateCapTab(z);
    // Re-render to show selection highlight
    zones.forEach(zz => { if (zz.group) zz.group.findOne('Rect').strokeWidth(1.5); });
    if (z.group) z.group.findOne('Rect').strokeWidth(2.5);
    konvaLayer.batchDraw();
}

function deselectZone() {
    selectedZoneId = null;
    document.getElementById('propsPlaceholder').style.display = '';
    document.getElementById('propsContent').style.display = 'none';
    zones.forEach(z => { if (z.group) z.group.findOne('Rect')?.strokeWidth(1.5); });
    konvaLayer.batchDraw();
}

function updateSelectedZone(field, value) {
    const z = zones.find(z => z.id === selectedZoneId);
    if (!z) return;
    pushUndo();
    if (field === 'name') { z.name = value; document.getElementById('propsZoneTitle').textContent = value; }
    else if (field === 'ticketId') z.ticketId = Number(value);
    else if (field === 'color') { z.color = value; document.getElementById('propsZoneColorDot').style.background = value; }
    else if (field === 'rows') z.rows = Math.max(1, Math.min(20, Number(value)));
    else if (field === 'cols') z.cols = Math.max(1, Math.min(30, Number(value)));
    else if (field === 'prefix') z.prefix = value;
    else if (field === 'numScheme') z.numScheme = value;
    else if (field === 'startNum') z.startNum = Math.max(1, Number(value));
    else if (field === 'skipLetters') z.skipLetters = value;
    else if (field === 'capacity') z.capacity = Math.max(1, Number(value));
    keepZoneInsideCanvas(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateCapTab(z);
    updateSbZoneList();
}

function setZoneType(type) {
    const z = zones.find(z => z.id === selectedZoneId);
    if (!z) return;
    pushUndo();
    z.type = type;
    setZoneTypeUI(type);
    if (type === 'ga') { z.rows = 0; z.cols = 0; z.capacity = z.capacity || 200; }
    else { z.rows = z.rows || 5; z.cols = z.cols || 10; }
    keepZoneInsideCanvas(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

function setZoneTypeUI(type) {
    document.getElementById('ztSeated').classList.toggle('active', type === 'seated');
    document.getElementById('ztGA').classList.toggle('active', type === 'ga');
    document.getElementById('gaCapField').style.display = type === 'ga' ? '' : 'none';
}

function addSeatedZone() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const z = makeZone('Khu vực ' + (zones.length + 1), t.id, 'seated', 5, 10, 20 + zones.length * 50, 120 + zones.length * 30, t.color || '#4f46e5');
    keepZoneInsideCanvas(z);
    zones.push(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
    selectZone(z.id);
}

function addGAZone() {
    pushUndo();
    const t = TICKET_TYPES[0];
    const z = makeZone('Khu đứng (GA) ' + (zones.length + 1), t.id, 'ga', 0, 0, 20 + zones.length * 40, 100 + zones.length * 20, t.color || '#f59e0b', 300);
    keepZoneInsideCanvas(z);
    zones.push(z);
    renderZone(z);
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
    selectZone(z.id);
}

function removeZone(id) {
    pushUndo();
    const idx = zones.findIndex(z => z.id === id);
    if (idx < 0) return;
    if (zones[idx].group) zones[idx].group.destroy();
    zones.splice(idx, 1);
    if (selectedZoneId === id) deselectZone();
    konvaLayer.batchDraw();
    updateStats();
    updateSbZoneList();
}

// ─── Undo / Redo ──────────────────────────────────────────────────────────────
function snapshotState() {
    return JSON.stringify({ stage: stageConfig, zones: zones.map(z => ({
        id: z.id, name: z.name, ticketId: z.ticketId, type: z.type,
        rows: z.rows, cols: z.cols, capacity: z.capacity, color: z.color,
        x: z.x, y: z.y, prefix: z.prefix, numScheme: z.numScheme,
        startNum: z.startNum, skipLetters: z.skipLetters
    })) });
}
function pushUndo() {
    undoStack.push(snapshotState());
    if (undoStack.length > 50) undoStack.shift();
    redoStack = [];
}
function restoreState(snap) {
    const snapshot = JSON.parse(snap);
    const data = Array.isArray(snapshot) ? snapshot : snapshot.zones;
    if (!Array.isArray(snapshot)) stageConfig = { ...stageConfig, ...snapshot.stage };
    zones.forEach(z => { if (z.group) z.group.destroy(); });
    zones = data.map(d => ({ ...d, group: null }));
    renderCanvas();
    updateStats(); updateSbZoneList();
    if (selectedZoneId && !zones.find(z => z.id === selectedZoneId)) deselectZone();
}
function undoAction() {
    if (!undoStack.length) return;
    redoStack.push(snapshotState());
    restoreState(undoStack.pop());
}
function redoAction() {
    if (!redoStack.length) return;
    undoStack.push(snapshotState());
    restoreState(redoStack.pop());
}

// ─── Stats & Sidebar ─────────────────────────────────────────────────────────
function updateStats() {
    const seatedTotal = zones.filter(z => z.type !== 'ga').reduce((s, z) => s + z.rows * z.cols, 0);
    const gaTotal = zones.filter(z => z.type === 'ga').reduce((s, z) => s + (z.capacity || 0), 0);
    document.getElementById('totalStatPill').textContent = `${seatedTotal + gaTotal} chỗ · ${zones.length} khu vực`;
}

function updateSbZoneList() {
    const list = document.getElementById('sbZoneList');
    list.innerHTML = '';
    zones.forEach(z => {
        const item = document.createElement('div');
        item.className = 'sb-zone-item' + (z.id === selectedZoneId ? ' selected' : '');
        item.style.setProperty('--zc', z.color);
        item.innerHTML = `<span class="sb-zone-name">${z.type === 'ga' ? '🧍 ' : ''}${z.name}</span>
            <button class="sb-zone-del" onclick="event.stopPropagation();removeZone(${z.id})" title="Xóa khu này">✕</button>`;
        item.addEventListener('click', () => selectZone(z.id));
        list.appendChild(item);
    });
}

function updateCapTab(z) {
    const container = document.getElementById('capDetails');
    if (!z) { container.innerHTML = ''; return; }
    const t = getTicketById(z.ticketId);
    let thisCap = z.type === 'ga' ? (z.capacity || 0) : (z.rows * z.cols);
    const allForTicket = zones.filter(zz => Number(zz.ticketId) === Number(z.ticketId));
    const totalForTicket = allForTicket.reduce((s, zz) => s + (zz.type === 'ga' ? (zz.capacity || 0) : zz.rows * zz.cols), 0);
    const pct = t.total > 0 ? Math.round(totalForTicket / t.total * 100) : 0;
    const exact = totalForTicket === t.total;
    const over = totalForTicket > t.total;
    const statusColor = exact ? '#047857' : over ? '#be123c' : '#b45309';
    const statusText = exact ? '✓ Đã phân bổ đủ số vé' : over
        ? `⚠ Vượt ${totalForTicket - t.total} chỗ so với số vé` : `Còn ${t.total - totalForTicket} vé chưa gán chỗ`;
    container.innerHTML = `
        <div style="display:flex;justify-content:space-between;margin-bottom:6px"><span>Khu này</span><strong>${thisCap} chỗ</strong></div>
        <div style="display:flex;justify-content:space-between;margin-bottom:8px"><span>Tổng "${t.name}"</span><strong style="color:${statusColor}">${totalForTicket} / ${t.total} vé</strong></div>
        <div style="height:8px;background:#f1f5f9;border-radius:4px;overflow:hidden">
            <div style="height:100%;width:${Math.min(pct,100)}%;background:${statusColor};border-radius:4px"></div>
        </div>
        <div style="margin-top:5px;font-size:.7rem;color:${statusColor};font-weight:700">${pct}% · ${statusText}</div>
    `;
}

// ─── Props Tabs ───────────────────────────────────────────────────────────────
function switchPropsTab(tab, btn) {
    document.querySelectorAll('.props-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tabBodyZone').classList.toggle('hidden', tab !== 'zone');
    document.getElementById('tabBodySeats').classList.toggle('hidden', tab !== 'seats');
    document.getElementById('tabBodyCap').classList.toggle('hidden', tab !== 'cap');
    if (tab === 'cap') { const z = zones.find(z => z.id === selectedZoneId); updateCapTab(z); }
}

// ─── Preset Select ─────────────────────────────────────────────────────────────
function selectPreset(preset) {
    currentPreset = preset;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b.dataset.preset === preset));
    pushUndo();
    zones.forEach(z => { if (z.group) z.group.destroy(); });
    zones = buildPresetZones(preset);

    const presetToDb = { concert: 'concert', theatre: 'theatre', auditorium: 'auditorium', arena: 'arena', custom: 'custom' };
    document.getElementById('loaiSoDoInput').value = presetToDb[preset] || 'custom';
    document.getElementById('skXInput').value = stageConfig.x;
    document.getElementById('skYInput').value = stageConfig.y;
    document.getElementById('skWidthInput').value = stageConfig.width;
    document.getElementById('skHeightInput').value = stageConfig.height;
    document.getElementById('stageLabelInput').value = stageConfig.title;

    const names = {
        concert: 'Sơ đồ Live Concert - ' + EVENT_NAME,
        theatre: 'Sơ đồ Nhà hát Hòa nhạc - ' + EVENT_NAME,
        auditorium: 'Sơ đồ Hội nghị - ' + EVENT_NAME,
        arena: 'Sơ đồ Nhà thi đấu 4 hướng - ' + EVENT_NAME,
        custom: 'Sơ đồ tùy chỉnh - ' + EVENT_NAME,
    };
    document.getElementById('tenSoDoField').value = names[preset] || 'Sơ đồ - ' + EVENT_NAME;
    renderCanvas();
    if (zones.length) selectZone(zones[0].id);
    requestAnimationFrame(konvaFitView);
}

// ─── Form Submit ──────────────────────────────────────────────────────────────
function submitNoSeatMap() {
    if (confirm('Bạn có chắc chắn muốn cấu hình sự kiện này thành BÁN VÉ TỰ DO (không chọn ghế)?')) {
        document.getElementById('noSeatForm').submit();
    }
}

function submitStudioForm() {
    const name = document.getElementById('tenSoDoField').value.trim();
    if (!name) { if (typeof WuangUI !== 'undefined') WuangUI.toast('Vui lòng nhập tên sơ đồ', 'error'); return; }
    if (!zones.length) { if (typeof WuangUI !== 'undefined') WuangUI.toast('Vui lòng thêm ít nhất 1 khu vực', 'error'); return; }

    // Đảm bảo mọi zone đều có loại vé hợp lệ
    zones.forEach(z => {
        if (!z.ticketId || !getTicketById(z.ticketId)) {
            z.ticketId = TICKET_TYPES[0]?.id;
        }
        keepZoneInsideCanvas(z);
    });

    // Validate capacity
    const ticketMap = new Map();
    zones.forEach(z => {
        const cap = z.type === 'ga' ? (z.capacity || 0) : (z.rows * z.cols);
        ticketMap.set(z.ticketId, (ticketMap.get(z.ticketId) || 0) + cap);
    });
    for (const [tid, total] of ticketMap) {
        const t = getTicketById(tid);
        if (t && total > t.total) {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(`Loại vé "${t.name}" phân bổ ${total} chỗ nhưng chỉ có ${t.total} vé!`, 'error');
            return;
        }
    }
    const missingTicket = activeTicketTypes().find(ticket => !ticketMap.has(ticket.id));
    if (missingTicket) {
        if (typeof WuangUI !== 'undefined') WuangUI.toast(`Hãy gán loại vé "${missingTicket.name}" vào một khu vực trước khi lưu.`, 'error');
        return;
    }
    for (const [tid] of ticketMap) {
        const ticketZones = zones.filter(z => Number(z.ticketId) === Number(tid));
        const standing = ticketZones.filter(z => z.type === 'ga');
        if (standing.length && (ticketZones.length !== 1 || standing[0].capacity !== getTicketById(tid).total)) {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(`Vé khu đứng "${getTicketById(tid).name}" phải thuộc một khu duy nhất và có sức chứa đúng bằng tổng số vé.`, 'error');
            return;
        }
    }

    document.getElementById('tenSoDoInput').value = name;
    document.getElementById('skXInput').value = Math.round(stageConfig?.x || 5);
    document.getElementById('skYInput').value = Math.round(stageConfig?.y || 1);
    document.getElementById('skWidthInput').value = Math.round(stageConfig?.width || 320);
    document.getElementById('skHeightInput').value = Math.round(stageConfig?.height || 48);
    document.getElementById('stageLabelInput').value = stageConfig?.title || 'SÂN KHẤU';

    // Build hidden inputs
    const container = document.getElementById('hiddenZoneInputs');
    container.innerHTML = '';
    const addInput = (name, value) => {
        const inp = document.createElement('input'); inp.type = 'hidden'; inp.name = name; inp.value = value; container.appendChild(inp);
    };
    zones.forEach(z => {
        addInput('zoneTen', z.name || 'Khu vực');
        addInput('zoneLoaiVeId', z.ticketId || TICKET_TYPES[0]?.id);
        addInput('zoneSoHang', z.type === 'ga' ? 0 : Math.max(1, z.rows || 5));
        addInput('zoneSoGheMoiHang', z.type === 'ga' ? 0 : Math.max(1, z.cols || 10));
        addInput('zoneMauSac', z.color || '#4f46e5');
        addInput('zoneViTriX', Math.round(z.x || 0));
        addInput('zoneViTriY', Math.round(z.y || 0));
        const size = calcZoneSize(z);
        addInput('zoneRong', Math.round(size.w));
        addInput('zoneCao', Math.round(size.h));
        addInput('zoneLoaiKhuVuc', z.type || 'seated');
        addInput('zoneSucChua', z.type === 'ga' ? Math.max(1, z.capacity || 100) : 0);
        addInput('zoneTienTo', z.prefix || '');
        addInput('zoneHuongDanhSo', z.numScheme || 'ltr');
        addInput('zoneSoBatDau', z.startNum || 1);
        addInput('zoneBoQuaChuDeNham', z.skipLetters || 'yes');
    });

    document.getElementById('studioForm').submit();
}

// ─── Saved map zoom ───────────────────────────────────────────────────────────
let savedZoom = 1;
function adjZ(d) {
    savedZoom = Math.max(.6, Math.min(1.4, savedZoom + d));
    document.getElementById('zoomLbl').textContent = Math.round(savedZoom * 100) + '%';
    const g = document.getElementById('savedGrid');
    if (g) { g.style.transform = `scale(${savedZoom})`; g.style.transformOrigin = 'top center'; }
}
function resetZ() {
    savedZoom = 1;
    document.getElementById('zoomLbl').textContent = '100%';
    const g = document.getElementById('savedGrid');
    if (g) { g.style.transform = 'scale(1)'; }
}

// ─── AJAX Seat Toggle (saved map) ────────────────────────────────────────────
async function seatToggle(seatId) {
    const btn = document.getElementById('sb-' + seatId);
    if (!btn || btn.classList.contains('held') || btn.classList.contains('sold')) return;
    btn.classList.add('toggling');
    try {
        const fd = new FormData();
        fd.append('suKienId', EVENT_ID);
        fd.append('seatId', seatId);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
        const res = await fetch('/Organizer/DoiTrangThaiGheAjax', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            if (data.newStatus === 3) { btn.className = 'cseat locked'; btn.title = 'Mở khóa ghế này'; }
            else { btn.className = 'cseat'; btn.title = 'Khóa ghế này'; }
        } else {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(data.message || 'Không thể đổi trạng thái', 'error');
        }
    } catch { if (typeof WuangUI !== 'undefined') WuangUI.toast('Lỗi kết nối', 'error'); }
    finally { btn.classList.remove('toggling'); }
}

