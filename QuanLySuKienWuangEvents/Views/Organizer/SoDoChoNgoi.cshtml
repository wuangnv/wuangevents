@model SoDoChoNgoi
@using System.Text.Json
@inject IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_OrganizerSimpleLayout.cshtml";
    ViewData["Title"] = "Sơ đồ chỗ ngồi";
    var suKienId = (Guid)ViewBag.SuKienId;
    var loaiVes = ViewBag.LoaiVes as List<LoaiVe> ?? new();
    var ghe = ViewBag.Ghe as List<ChoNgoi> ?? new();
    var hang = ViewBag.Hang as Dictionary<int, string> ?? new();
    var khuVucTheoHang = ViewBag.KhuVucTheoHang as Dictionary<int, KhuVuc> ?? new();
    var cacKhuVuc = ViewBag.KhuVucs as List<KhuVuc> ?? khuVucTheoHang.Values.GroupBy(x => x.Id).Select(x => x.First()).OrderBy(x => x.ThuTu).ToList();
    var cacBoCuc = new[] { "workshop", "auditorium", "concert", "gala", "theatre", "cinema", "arena", "custom" };
    string boCucDaLuu = cacBoCuc.Contains(Model.LoaiSoDo) ? Model.LoaiSoDo : "custom";
    int soTrong = ghe.Count(x => x.TrangThai == 0), dangGiu = ghe.Count(x => x.TrangThai == 1);
    int daBan = ghe.Count(x => x.TrangThai == 2), daKhoa = ghe.Count(x => x.TrangThai == 3);
    bool isExpired = ViewBag.NgayKetThucSuKien != null && VietnamTime.Now > (DateTime)ViewBag.NgayKetThucSuKien;
    bool isLocked = ViewBag.TrangThaiSuKien is not (0 or 2 or 7) || isExpired;
    string loaiVeJson = JsonSerializer.Serialize(loaiVes.Select(x => new { id = x.Id, name = x.TenLoaiVe, price = x.GiaBan, total = x.SoLuongTong, enabled = x.TrangThai, color = x.MauSac ?? "#4f46e5" }));
    string tenSuKienJson = JsonSerializer.Serialize((string?)ViewBag.TenSuKien ?? "");
}

@section Styles {
<style>
/* ===== VENUE SEATING STUDIO — 100% LIGHT THEME ===== */
*{box-sizing:border-box}
.seat-admin { max-width: 1700px; margin: 0 auto; padding: 20px 16px 80px; }

/* Hero Bar */
.hero-bar{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:18px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px;box-shadow:0 2px 6px rgba(0,0,0,.03)}
.hero-bar h1{font-size:1.35rem;font-weight:850;color:#1e1b4b;margin:0 0 3px}
.hero-bar p{margin:0;color:#64748b;font-size:.84rem}
.btn-del{border:1px solid #fecaca;background:#fff1f2;color:#dc2626;border-radius:10px;padding:7px 14px;font-weight:750;font-size:.82rem;transition:.15s;cursor:pointer}
.btn-del:hover:not(:disabled){background:#fee2e2}
.btn-del:disabled{opacity:.45;cursor:not-allowed}

/* Alerts */
.alert-box{border-radius:12px;padding:11px 16px;margin-bottom:14px;font-weight:650;font-size:.85rem;display:flex;align-items:center;gap:8px}
.alert-box.error{background:#fff1f2;border:1px solid #fecdd3;color:#be123c}
.alert-box.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#047857}

/* Stats Bar */
.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.stat-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:14px 18px;text-align:center;box-shadow:0 2px 4px rgba(0,0,0,.02)}
.stat-card strong{display:block;font-size:1.55rem;color:#1e1b4b;font-weight:850}
.stat-card span{font-size:.75rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.04em}

/* ====== SAVED MAP VIEW ====== */
.saved-map-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:20px;margin-bottom:20px;box-shadow:0 4px 14px rgba(0,0,0,.03)}
.saved-map-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #f1f5f9}
.saved-map-title{font-size:1rem;font-weight:850;color:#1e1b4b;margin:0;display:flex;align-items:center;gap:8px}
.saved-map-tools{display:flex;align-items:center;gap:6px}
.tool-btn{width:32px;height:32px;border:1px solid #cbd5e1;background:#fff;border-radius:8px;color:#334155;font-weight:850;font-size:.88rem;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;justify-content:center}
.tool-btn:hover{background:#f8fafc;border-color:#94a3b8}
.zoom-lbl{font-size:.78rem;font-weight:750;color:#64748b;min-width:42px;text-align:center}
.map-viewport{overflow:auto;padding:16px 8px;background:#fafbfc;border:1px solid #e2e8f0;border-radius:14px}
.org-map-host{position:relative}.org-map-canvas{position:relative;border:1px dashed #ddd6fe;border-radius:14px;background-image:linear-gradient(#ede9fe 1px,transparent 1px),linear-gradient(90deg,#ede9fe 1px,transparent 1px);background-size:24px 24px;transform-origin:top left;box-shadow:inset 0 0 55px rgba(124,58,237,.035)}
.org-stage{position:absolute;z-index:5;background:linear-gradient(120deg,#4c1d95,#7c3aed 60%,#a855f7);color:white;border-radius:10px;display:flex;align-items:center;justify-content:center;padding:0 12px;font-size:.72rem;font-weight:900;letter-spacing:.1em;text-align:center;box-shadow:0 8px 18px rgba(109,40,217,.2)}
.org-zone{position:absolute;box-sizing:border-box;border:2px solid var(--zcolor,#4f46e5);border-radius:13px;overflow:hidden;background:color-mix(in srgb,var(--zcolor,#4f46e5) 6%,#fff);box-shadow:0 9px 21px color-mix(in srgb,var(--zcolor,#4f46e5) 14%,transparent)}
.org-zone .rows-wrap{height:calc(100% - 41px);overflow:auto}.org-zone .seat-row{justify-content:flex-start}.org-zone .ga-info-box{height:calc(100% - 41px);display:flex;flex-direction:column;justify-content:center}
.org-zone.banquet-zone{overflow:visible;border:0;background:transparent;box-shadow:none}.org-banquet-title{position:absolute;left:50%;top:3px;transform:translateX(-50%);max-width:100%;font-size:.68rem;font-weight:850;color:var(--zcolor,#4f46e5);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.org-banquet-core{position:absolute;left:50%;top:50%;width:54px;height:36px;transform:translate(-50%,-42%);border:2px solid var(--zcolor,#4f46e5);border-radius:50%;background:color-mix(in srgb,var(--zcolor,#4f46e5) 12%,#fff);display:grid;place-items:center;font-size:.58rem;font-weight:900;color:var(--zcolor,#4f46e5)}.org-banquet-seat{position:absolute!important;width:19px!important;height:16px!important;border-radius:5px 5px 3px 3px!important;font-size:.46rem!important;z-index:2}.org-banquet-ticket{position:absolute;left:50%;bottom:1px;transform:translateX(-50%);font-size:.55rem;font-weight:800;color:#64748b;white-space:nowrap}

/* Stage header (organizer view) */
.org-stage-hdr{text-align:center;margin-bottom:20px}
.org-stage-lbl{display:inline-block;background:#1e1b4b;color:#fff;padding:8px 40px;border-radius:0 0 40% 40%/0 0 20px 20px;font-size:.75rem;font-weight:850;letter-spacing:2px;text-transform:uppercase;box-shadow:0 4px 14px rgba(30,27,75,.2)}
.org-stage-line{height:3px;background:linear-gradient(to right,transparent 5%,#e2e8f0 30%,#e2e8f0 70%,transparent 95%);margin-top:4px;border-radius:2px}

/* Zone flex layout */
.zone-stage-wrapper{display:flex;flex-direction:column;gap:16px;min-width:700px}
.zone-row-grp{display:flex;justify-content:center;align-items:flex-start;gap:12px;flex-wrap:nowrap}
.zone-row-grp.spread{justify-content:space-between}

/* Zone box */
.zone-box{background:#fff;border:1.5px solid var(--zcolor,#4f46e5);border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.04);flex-shrink:0}
.zone-box.ga-zone{}
.zone-header{padding:8px 14px 6px;background:color-mix(in srgb,var(--zcolor,#4f46e5) 9%,#fff);border-bottom:1px solid color-mix(in srgb,var(--zcolor,#4f46e5) 18%,#fff);display:flex;justify-content:space-between;align-items:center;gap:8px}
.zone-name{font-size:.78rem;font-weight:850;color:var(--zcolor,#4f46e5);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}
.zone-ticket{font-size:.7rem;font-weight:850;color:#fff;background:var(--zcolor,#4f46e5);padding:2px 8px;border-radius:999px;white-space:nowrap;flex-shrink:0}
.rows-wrap{padding:10px 12px 12px}
.seat-row{display:flex;align-items:center;gap:3px;margin-bottom:3px;justify-content:center}
.row-label{width:20px;text-align:right;font-size:.67rem;font-weight:850;color:#94a3b8;flex-shrink:0;margin-right:3px}

/* Professional seat button (chair-back style) */
.cseat{
    width:28px;height:24px;
    border-radius:6px 6px 3px 3px;
    border:1.5px solid var(--zcolor,#4f46e5);
    background:color-mix(in srgb,var(--zcolor,#4f46e5) 8%,#fff);
    color:var(--zcolor,#4f46e5);
    font-size:.58rem;font-weight:850;
    display:inline-flex;align-items:center;justify-content:center;
    cursor:pointer;transition:all .12s ease;
    user-select:none;outline:none;flex-shrink:0;
    box-shadow:0 -2px 0 0 color-mix(in srgb,var(--zcolor,#4f46e5) 30%,#fff) inset;
}
.cseat:hover:not(:disabled){background:var(--zcolor,#4f46e5);color:#fff;transform:translateY(-2px);box-shadow:0 4px 10px rgba(0,0,0,.12),0 -2px 0 0 color-mix(in srgb,var(--zcolor,#4f46e5) 60%,#000) inset;}
.cseat.held{background:#fef3c7;border-color:#f59e0b;color:#92400e;cursor:not-allowed;box-shadow:0 -2px 0 0 #f59e0b inset;}
.cseat.sold{background:#fee2e2;border-color:#fca5a5;color:#b91c1c;cursor:not-allowed;box-shadow:0 -2px 0 0 #fca5a5 inset;}
.cseat.locked{background:#f1f5f9;border-color:#dde2ec;color:#c1cad8;box-shadow:0 -2px 0 0 #dde2ec inset;}
.cseat.toggling{opacity:.4;pointer-events:none}

/* GA zone seats area */
.ga-info-box{padding:18px 20px;text-align:center;background:repeating-linear-gradient(45deg,#fafafa,#fafafa 8px,#f1f5f9 8px,#f1f5f9 16px)}
.ga-info-lbl{font-size:.84rem;font-weight:850;color:var(--zcolor,#4f46e5)}
.ga-info-sub{font-size:.72rem;color:#64748b;margin-top:3px}

.legend-bar{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;border-top:1px solid #f1f5f9;margin-top:14px;padding-top:12px;font-size:.77rem;color:#64748b;font-weight:650}
.legend-bar span{display:flex;align-items:center;gap:5px}
.legend-box{width:20px;height:17px;border-radius:4px 4px 2px 2px;display:inline-block;border:1.5px solid}

/* ====== STUDIO BUILDER ====== */
.studio-layout{display:grid;grid-template-columns:235px minmax(620px,1fr) 270px;gap:16px;align-items:start}
.studio-sidebar{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.03)}
.studio-canvas-area{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.03);min-width:0}
.studio-props{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 4px 14px rgba(0,0,0,.03)}

/* Sidebar */
.sb-section-title{font-size:.78rem;font-weight:850;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin:0 0 10px}
.preset-list{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}
.preset-btn{border:1.5px solid #e2e8f0;border-radius:12px;padding:10px 12px;background:#fff;cursor:pointer;transition:.15s;text-align:left;display:flex;align-items:center;gap:10px}
.preset-btn:hover{border-color:#94a3b8;background:#fafafa}
.preset-btn.active{border:2px solid #4f46e5;background:#f5f7ff}
.preset-icon{width:32px;height:32px;border-radius:8px;background:#f1f5f9;color:#4f46e5;font-size:.9rem;display:grid;place-items:center;flex-shrink:0}
.preset-btn.active .preset-icon{background:#4f46e5;color:#fff}
.preset-btn .ptxt strong{display:block;font-size:.8rem;color:#1e1b4b;font-weight:800}
.preset-btn .ptxt small{font-size:.68rem;color:#64748b;line-height:1.3}
.sb-divider{border:0;border-top:1px solid #f1f5f9;margin:14px 0}
.sb-btn-add{width:100%;border:1.5px dashed #4f46e5;background:#f5f7ff;color:#4f46e5;border-radius:10px;padding:9px;font-weight:800;font-size:.8rem;cursor:pointer;margin-bottom:6px;display:flex;align-items:center;justify-content:center;gap:6px}
.sb-btn-add:hover{background:#e0e7ff}
.sb-zone-list{display:flex;flex-direction:column;gap:6px;max-height:220px;overflow-y:auto}
.sb-zone-item{padding:8px 10px;border-radius:10px;border-left:4px solid var(--zc,#4f46e5);background:#f8fafc;cursor:pointer;font-size:.78rem;display:flex;justify-content:space-between;align-items:center}
.sb-zone-item.selected{background:#e0e7ff;border-left-color:#4f46e5}
.sb-zone-item:hover{background:#f1f5f9}
.sb-zone-name{font-weight:750;color:#1e1b4b}
.sb-zone-del{border:0;background:0;color:#ef4444;font-size:.82rem;cursor:pointer;padding:0 4px}

/* Canvas */
.canvas-hud{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #f1f5f9}
.canvas-hud-title{font-size:.88rem;font-weight:850;color:#1e1b4b;display:flex;align-items:center;gap:6px}
.canvas-hud-tools{display:flex;align-items:center;gap:5px}
.pill-stat{background:#f1f5f9;color:#475569;font-size:.72rem;font-weight:750;padding:4px 10px;border-radius:999px;border:1px solid #e2e8f0}
#konva-container{border:1px solid #e2e8f0;border-radius:14px;background:#f8fafc;overflow:hidden;cursor:grab;height:min(640px,calc(100vh - 255px));min-height:500px}
#konva-container:active{cursor:grabbing}

/* Properties Panel */
.props-placeholder{text-align:center;padding:40px 20px;color:#94a3b8}
.props-placeholder i{font-size:2rem;display:block;margin-bottom:8px}
.props-placeholder p{font-size:.82rem;margin:0}
.props-zone-title{font-size:.95rem;font-weight:850;color:#1e1b4b;margin:0 0 14px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;gap:8px}
.props-zone-color{width:14px;height:14px;border-radius:50%;display:inline-block;flex-shrink:0}
.props-tab-bar{display:flex;gap:4px;margin-bottom:14px}
.props-tab{flex:1;padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;font-size:.75rem;font-weight:800;color:#64748b;cursor:pointer;transition:.15s;text-align:center}
.props-tab.active{border-color:#4f46e5;background:#f5f7ff;color:#4f46e5}
.props-body{display:flex;flex-direction:column;gap:10px}
.props-body.hidden{display:none}
.pf label{display:block;font-size:.72rem;font-weight:750;color:#64748b;margin-bottom:4px}
.pf input,.pf select{width:100%;border:1px solid #cbd5e1;border-radius:8px;padding:7px 10px;font-size:.82rem;font-weight:650;color:#1e293b}
.pf input:focus,.pf select:focus{border-color:#4f46e5;outline:none;box-shadow:0 0 0 2px rgba(79,70,229,.12)}
.pf-grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cap-bar{margin-top:4px;padding:7px 10px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0;font-size:.73rem}
.cap-bar.ok{background:#ecfdf5;border-color:#a7f3d0;color:#047857}
.cap-bar.warn{background:#fff1f2;border-color:#fecdd3;color:#be123c}
.zone-type-switch{display:flex;gap:6px;margin-bottom:2px}
.zt-btn{flex:1;padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.77rem;font-weight:800;cursor:pointer;text-align:center;transition:.15s}
.zt-btn.active{border-color:#4f46e5;background:#f5f7ff;color:#4f46e5}

/* Form Submit Bar */
.studio-submit-bar{display:flex;justify-content:space-between;align-items:center;padding-top:14px;border-top:1px solid #f1f5f9;margin-top:14px;gap:12px}
.btn-save-map{border:0;background:#4f46e5;color:#fff;border-radius:10px;padding:11px 22px;font-weight:850;font-size:.88rem;cursor:pointer;transition:.15s}
.btn-save-map:hover:not(:disabled){background:#4338ca}
.btn-save-map:disabled{opacity:.45;cursor:not-allowed}
.btn-no-seat{border:1px solid #94a3b8;background:#fff;color:#475569;border-radius:8px;padding:8px 14px;font-weight:750;font-size:.78rem;cursor:pointer}

/* No ticket type fallback */
.no-loaive-box{background:#fff1f2;border:1px solid #fecdd3;color:#be123c;border-radius:12px;padding:14px 18px;font-weight:650;font-size:.86rem}

@@media(max-width:1200px){.seat-admin{max-width:1100px}.studio-layout{grid-template-columns:1fr 1fr}.studio-props{grid-column:span 2}}
@@media(max-width:800px){.studio-layout{grid-template-columns:1fr}.studio-props{order:3}.stats-bar{grid-template-columns:repeat(2,1fr)}}
</style>
}

<main class="seat-admin">
    @if (isLocked)
    {
        <div class="alert-box error"><i class="fas fa-lock"></i> Sự kiện đang khóa nghiệp vụ hoặc đã kết thúc; không thể thay đổi sơ đồ.</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-box error"><i class="fas fa-circle-exclamation"></i> @TempData["Error"]</div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert-box success"><i class="fas fa-circle-check"></i> @TempData["Message"]</div>
    }

    <div class="hero-bar">
        <div>
            <h1><i class="fas fa-chair me-2 text-primary"></i>Sơ đồ chỗ ngồi</h1>
            <p>@ViewBag.TenSuKien</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            @if (Model.Id != 0)
            {
                <form method="post" action="/Organizer/XoaSoDo" data-confirm="Xóa toàn bộ sơ đồ ghế của sự kiện?" data-confirm-title="Xóa sơ đồ ghế" data-confirm-button="Xóa sơ đồ" style="margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suKienId" value="@suKienId" />
                    <button class="btn-del" disabled="@(isLocked || dangGiu > 0 || daBan > 0)" type="submit">
                        <i class="fas fa-trash me-1"></i>Xóa sơ đồ
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Id != 0)
    {
        <!-- ====== PHÂN HỆ QUẢN TRỊ SƠ ĐỒ ĐÃ TẠO ====== -->
        <div class="stats-bar">
            <div class="stat-card"><strong>@soTrong</strong><span>Ghế trống</span></div>
            <div class="stat-card"><strong style="color:#d97706">@dangGiu</strong><span>Đang giữ chỗ</span></div>
            <div class="stat-card"><strong style="color:#dc2626">@daBan</strong><span>Đã thanh toán</span></div>
            <div class="stat-card"><strong style="color:#64748b">@daKhoa</strong><span>Tạm khóa</span></div>
        </div>

        <div class="saved-map-card">
            <div class="saved-map-header">
                <h3 class="saved-map-title"><i class="fas fa-map text-primary"></i>Bản vẽ không gian 2D: @Model.TenSoDo</h3>
                <div class="saved-map-tools">
                    <button class="tool-btn" onclick="adjZ(-0.1)" title="Thu nhỏ">−</button>
                    <span class="zoom-lbl" id="zoomLbl">100%</span>
                    <button class="tool-btn" onclick="adjZ(0.1)" title="Phóng to">+</button>
                    <button class="tool-btn" onclick="resetZ()" title="Đặt lại"><i class="fas fa-rotate-left"></i></button>
                </div>
            </div>

            <div class="map-viewport">
                @{
                    int canvasWidth = Model.CanvasRong > 0 ? Model.CanvasRong : 960;
                    int canvasHeight = Model.CanvasCao > 0 ? Model.CanvasCao : 650;
                    int stageWidth = Model.SanKhauRong > 0 ? Model.SanKhauRong : 280;
                    int stageHeight = Model.SanKhauCao > 0 ? Model.SanKhauCao : 44;
                    int stageX = Model.SanKhauX ?? (canvasWidth - stageWidth) / 2;
                    int stageY = Model.SanKhauY ?? 36;
                }
                <div class="org-map-host" id="savedMapHost" style="width:@canvasWidth.ToString()px;height:@canvasHeight.ToString()px">
                    <div class="org-map-canvas" id="savedGrid" style="width:@canvasWidth.ToString()px;height:@canvasHeight.ToString()px;transition:transform .2s">
                        <div class="org-stage" style="left:@stageX.ToString()px;top:@stageY.ToString()px;width:@stageWidth.ToString()px;height:@stageHeight.ToString()px">@(string.IsNullOrWhiteSpace(Model.NhanSanKhau) ? "SÂN KHẤU" : Model.NhanSanKhau)</div>
                        @foreach (var zone in cacKhuVuc)
                        {
                            var zoneRows = ghe.GroupBy(x => x.HangGheId)
                                .Where(row => khuVucTheoHang.GetValueOrDefault(row.Key)?.Id == zone.Id)
                                .OrderBy(row => row.Key).ToList();
                            string zc = zone.MauSac ?? "#4f46e5";
                            var ve = loaiVes.FirstOrDefault(v => v.Id == zone.LoaiVeId);
                            int zoneWidth = zone.Rong > 0 ? zone.Rong : 260;
                            int zoneHeight = zone.Cao > 0 ? zone.Cao : 180;
                            int zoneX = zone.ViTriX ?? 0;
                            int zoneY = zone.ViTriY ?? 0;
                            <section class="org-zone @(zone.LoaiKhuVuc == "banquet" ? "banquet-zone" : "")" style="--zcolor:@zc;left:@zoneX.ToString()px;top:@zoneY.ToString()px;width:@zoneWidth.ToString()px;height:@zoneHeight.ToString()px">
                                @if (zone.LoaiKhuVuc == "banquet")
                                {
                                    var tableSeats = zoneRows.SelectMany(row => row).ToList();
                                    <div class="org-banquet-title">@zone.TenKhuVuc</div>
                                    <div class="org-banquet-core">BÀN</div>
                                    @for (int seatIndex = 0; seatIndex < tableSeats.Count; seatIndex++)
                                    {
                                        var seat = tableSeats[seatIndex];
                                        var angle = -Math.PI / 2d + 2d * Math.PI * seatIndex / Math.Max(1, tableSeats.Count);
                                        var seatLeft = (int)Math.Round(zoneWidth / 2d + Math.Cos(angle) * 55d - 10d);
                                        var seatTop = (int)Math.Round(zoneHeight / 2d + Math.Sin(angle) * 38d - 8d);
                                        string cls = seat.TrangThai == 1 ? "cseat held org-banquet-seat" : seat.TrangThai == 2 ? "cseat sold org-banquet-seat" : seat.TrangThai == 3 ? "cseat locked org-banquet-seat" : "cseat org-banquet-seat";
                                        bool dis = isLocked || seat.TrangThai is 1 or 2;
                                        string tip = seat.TrangThai == 0 ? "Khóa ghế này" : seat.TrangThai == 3 ? "Mở khóa ghế này" : seat.TrangThai == 1 ? "Đang giữ" : "Đã bán";
                                        <button type="button" class="@cls" id="sb-@seat.Id" disabled="@dis" title="@tip" onclick="seatToggle(@seat.Id)" style="--zcolor:@zc;left:@seatLeft.ToString()px;top:@seatTop.ToString()px">@(seat.SoGhe.Contains('-') ? seat.SoGhe[(seat.SoGhe.LastIndexOf('-') + 1)..] : seat.SoGhe)</button>
                                    }
                                    <span class="org-banquet-ticket">@(ve?.TenLoaiVe ?? "Loại vé") · @tableSeats.Count ghế</span>
                                }
                                else
                                {
                                    <div class="zone-header"><span class="zone-name">@zone.TenKhuVuc</span><span class="zone-ticket">@(ve?.TenLoaiVe ?? "Loại vé")</span></div>
                                    @if (zone.LoaiKhuVuc == "ga")
                                    {
                                        <div class="ga-info-box"><div class="ga-info-lbl"><i class="fas fa-person-walking me-1"></i>Khu đứng</div><div class="ga-info-sub">Sức chứa @((zone.SucChua ?? 0).ToString("N0")) người · @(ve?.TenLoaiVe)</div></div>
                                    }
                                    else
                                    {
                                        <div class="rows-wrap">
                                            @foreach (var row in zoneRows)
                                            {
                                                <div class="seat-row"><span class="row-label">@hang.GetValueOrDefault(row.Key)</span>
                                                @foreach (var seat in row)
                                                {
                                                    string cls = seat.TrangThai == 1 ? "cseat held" : seat.TrangThai == 2 ? "cseat sold" : seat.TrangThai == 3 ? "cseat locked" : "cseat";
                                                    bool dis = isLocked || seat.TrangThai is 1 or 2;
                                                    string tip = seat.TrangThai == 0 ? "Khóa ghế này" : seat.TrangThai == 3 ? "Mở khóa ghế này" : seat.TrangThai == 1 ? "Đang giữ" : "Đã bán";
                                                    <button type="button" class="@cls" id="sb-@seat.Id" disabled="@dis" title="@tip" onclick="seatToggle(@seat.Id)" style="--zcolor:@zc">@seat.SoGhe</button>
                                                }</div>
                                            }
                                        </div>
                                    }
                                }
                            </section>
                        }
                    </div>
                </div>
            </div>

            <div class="legend-bar">
                <span><span class="legend-box" style="background:color-mix(in srgb,#4f46e5 8%,#fff);border-color:#4f46e5"></span>Trống (Nhấp để Khóa)</span>
                <span><span class="legend-box" style="background:#fef3c7;border-color:#f59e0b"></span>Đang giữ chỗ</span>
                <span><span class="legend-box" style="background:#fee2e2;border-color:#fca5a5"></span>Đã bán</span>
                <span><span class="legend-box" style="background:#f1f5f9;border-color:#dde2ec"></span>Tạm khóa (Nhấp để Mở)</span>
            </div>
        </div>

    }
    else if (!loaiVes.Any())
    {
        <div class="no-loaive-box"><i class="fas fa-triangle-exclamation me-2"></i>Chưa có loại vé nào. Vui lòng <a href="/Organizer/LoaiVe?suKienId=@suKienId" class="fw-bold ms-1 text-decoration-underline">Tạo loại vé</a> trước khi thiết lập sơ đồ chỗ ngồi.</div>
    }
    else
    {
        <!-- ====== PHÂN HỆ STUDIO THIẾT KẾ SƠ ĐỒ (KONVA.JS) ====== -->
        <div class="studio-layout">
            <!-- SIDEBAR TRÁI -->
            <div class="studio-sidebar">
                <p class="sb-section-title">Mẫu địa điểm</p>
                <div class="preset-list" id="presetList">
                    <button type="button" class="preset-btn active" data-preset="workshop" onclick="selectPreset('workshop')">
                        <span class="preset-icon"><i class="fas fa-chalkboard-user"></i></span>
                        <span class="ptxt"><strong>Phòng Workshop</strong><small>Một hoặc hai dãy, lối đi chính giữa</small></span>
                    </button>
                    <button type="button" class="preset-btn" data-preset="auditorium" onclick="selectPreset('auditorium')">
                        <span class="preset-icon"><i class="fas fa-landmark"></i></span>
                        <span class="ptxt"><strong>Hội trường 3 dãy</strong><small>Khối trái, giữa, phải và hai lối đi</small></span>
                    </button>
                    <button type="button" class="preset-btn" data-preset="concert" onclick="selectPreset('concert')">
                        <span class="preset-icon"><i class="fas fa-music"></i></span>
                        <span class="ptxt"><strong>Sân khấu biểu diễn</strong><small>VIP/GA sát sân khấu, vé thường phía sau</small></span>
                    </button>
                    <button type="button" class="preset-btn" data-preset="gala" onclick="selectPreset('gala')">
                        <span class="preset-icon"><i class="fas fa-utensils"></i></span>
                        <span class="ptxt"><strong>Tiệc Gala / bàn tròn</strong><small>Bàn 6–10 ghế, lối đi trung tâm</small></span>
                    </button>
                    <button type="button" class="preset-btn" data-preset="arena" onclick="selectPreset('arena')">
                        <span class="preset-icon"><i class="fas fa-trophy"></i></span>
                        <span class="ptxt"><strong>Nhà thi đấu / thể thao</strong><small>Bốn khán đài quanh sàn trung tâm</small></span>
                    </button>
                    <button type="button" class="preset-btn" data-preset="custom" onclick="selectPreset('custom')">
                        <span class="preset-icon"><i class="fas fa-sliders"></i></span>
                        <span class="ptxt"><strong>Tự thiết kế</strong><small>Thêm khu, kéo thả và gán vé</small></span>
                    </button>
                </div>
                <hr class="sb-divider">
                <p class="sb-section-title">Khu vực trong sơ đồ</p>
                <button type="button" class="sb-btn-add" onclick="addSeatedZone()"><i class="fas fa-chair"></i> Thêm khu ghế ngồi</button>
                <button type="button" class="sb-btn-add" onclick="addBanquetTable()" style="background:#fff7ed;border-color:#fb923c;color:#c2410c;margin-top:0"><i class="fas fa-utensils"></i> Thêm bàn tiệc</button>
                <button type="button" class="sb-btn-add" onclick="addGAZone()" style="background:#fff8f0;border-color:#f59e0b;color:#d97706;margin-top:0"><i class="fas fa-person-walking"></i> Thêm khu đứng (GA)</button>
                <button type="button" class="sb-btn-add" onclick="autoAllocateSeatsForTickets()" style="background:#f0fdf4;border-color:#86efac;color:#047857;margin-top:0"><i class="fas fa-wand-magic-sparkles"></i> Tự cân số ghế theo vé</button>
                <div class="sb-zone-list" id="sbZoneList"></div>
            </div>

            <!-- CANVAS GIỮA (Konva.js) -->
            <div class="studio-canvas-area">
                <div class="canvas-hud">
                    <span class="canvas-hud-title"><i class="fas fa-drafting-compass text-primary"></i>&nbsp;Bản vẽ Studio 2D</span>
                    <div class="canvas-hud-tools">
                        <span class="pill-stat" id="totalStatPill">0 ghế · 0 khu</span>
                        <button class="tool-btn" onclick="konvaZoom(-0.2)" title="Thu nhỏ">−</button>
