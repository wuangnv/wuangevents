@{
    string? successMessage = TempData["Message"]?.ToString();
    string? errorMessage = TempData["Error"]?.ToString();
    string? warningMessage = TempData["Warning"]?.ToString();
    string? infoMessage = TempData["Info"]?.ToString();

    TempData.Remove("Message");
    TempData.Remove("Error");
    TempData.Remove("Warning");
    TempData.Remove("Info");
}

<div id="uiFlashData"
     data-success="@successMessage"
     data-error="@errorMessage"
     data-warning="@warningMessage"
     data-info="@infoMessage"
     hidden></div>

<div class="ui-toast-region" id="uiToastRegion" aria-live="polite" aria-atomic="false"></div>

<div class="ui-confirm-backdrop" id="uiConfirmDialog" aria-hidden="true">
    <div class="ui-confirm-card" role="dialog" aria-modal="true" aria-labelledby="uiConfirmTitle" aria-describedby="uiConfirmMessage">
        <div class="ui-confirm-icon" id="uiConfirmIcon"><i class="fas fa-triangle-exclamation"></i></div>
        <h2 id="uiConfirmTitle">Xác nhận thao tác</h2>
        <p id="uiConfirmMessage"></p>
        <div class="ui-confirm-actions">
            <button type="button" class="ui-confirm-cancel" id="uiConfirmCancel">Quay lại</button>
            <button type="button" class="ui-confirm-submit" id="uiConfirmSubmit">Xác nhận</button>
        </div>
    </div>
</div>
