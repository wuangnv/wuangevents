@{
    Layout = "~/Views/Shared/_AdminSimpleLayout.cshtml";
    ViewData["Title"] = "Bảng quản trị";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div class="portal-page-title">
        <span class="portal-kicker"><i class="fas fa-shield-halved"></i> Quản trị viên</span>
        <h1>Bảng quản trị hệ thống</h1>
        <p>Trang này gom các số liệu chính và lối tắt quản lý quan trọng của hệ thống.</p>
    </div>
    <div class="portal-actions">
        <a class="btn btn-outline-primary" href="/Admin/SuKien">
            <i class="fas fa-calendar-check me-1"></i> Duyệt sự kiện
        </a>
        <a class="btn btn-primary" href="/Admin/DanhMuc">
            <i class="fas fa-layer-group me-1"></i> Danh mục
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div>
                <div class="stat-label">Người dùng</div>
                <p class="stat-number">@ViewBag.SoNguoiDung</p>
            </div>
            <span class="stat-icon"><i class="fas fa-users"></i></span>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div>
                <div class="stat-label">Sự kiện</div>
                <p class="stat-number">@ViewBag.SoSuKien</p>
            </div>
            <span class="stat-icon"><i class="fas fa-calendar-days"></i></span>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div>
                <div class="stat-label">Đơn hàng</div>
                <p class="stat-number">@ViewBag.SoDonHang</p>
            </div>
            <span class="stat-icon"><i class="fas fa-receipt"></i></span>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div>
                <div class="stat-label">Doanh thu</div>
                <p class="stat-number">@ViewBag.DoanhThu.ToString("N0")</p>
            </div>
            <span class="stat-icon"><i class="fas fa-coins"></i></span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="portal-card h-100">
            <div class="portal-card-header">
                <h2>Công việc thường dùng</h2>
            </div>
            <div class="portal-card-body simple-list">
                <a href="/Admin/SuKien">
                    <span>
                        <i class="fas fa-calendar-check me-2 text-primary"></i>Duyệt sự kiện chờ admin
                        @if (ViewBag.SoSuKienChoDuyet > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.75rem;">@ViewBag.SoSuKienChoDuyet sự kiện</span>
                        }
                    </span>
                    <i class="fas fa-chevron-right"></i>
                </a>
                <a href="/Admin/DuyetBTCList">
                    <span>
                        <i class="fas fa-handshake me-2 text-primary"></i>Phê duyệt ban tổ chức
                        @if (ViewBag.SoYeuCauBTCChoDuyet > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-2" style="font-size: 0.75rem;">@ViewBag.SoYeuCauBTCChoDuyet yêu cầu</span>
                        }
                    </span>
                    <i class="fas fa-chevron-right"></i>
                </a>
                <a href="/Admin/DanhMuc">
                    <span><i class="fas fa-layer-group me-2 text-primary"></i>Thêm hoặc sửa danh mục</span>
                    <i class="fas fa-chevron-right"></i>
                </a>
                <a href="/Admin/NguoiDung">
                    <span><i class="fas fa-users me-2 text-primary"></i>Quản lý tài khoản người dùng</span>
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="portal-card h-100">
            <div class="portal-card-header">
                <h2>Tổng quan quản trị</h2>
            </div>
            <div class="portal-card-body">
                <p class="mb-2">Sự kiện mới cần được admin duyệt trước khi bán vé công khai.</p>
                <p class="mb-2">Danh mục giúp người dùng lọc sự kiện nhanh hơn trên trang chủ.</p>
                <p class="mb-0">Bạn có thể khóa/mở khóa tài khoản khách hàng hoặc ban tổ chức nếu cần.</p>
            </div>
        </div>
    </div>
</div>
