@model List<NguoiDung>
@{
    Layout = "~/Views/Shared/_AdminSimpleLayout.cshtml";
    ViewData["Title"] = "Duyệt Ban tổ chức";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div class="portal-page-title">
        <span class="portal-kicker"><i class="fas fa-handshake"></i> Đối tác</span>
        <h1>Duyệt Ban tổ chức</h1>
        <p>Phê duyệt hoặc từ chối các yêu cầu nâng cấp tài khoản lên Ban tổ chức của người dùng.</p>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-circle-check me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="portal-card">
    <div class="portal-card-header d-flex justify-content-between align-items-center">
        <h2>Yêu cầu chờ phê duyệt</h2>
        <span class="badge bg-primary text-white" style="border-radius:12px; padding: 6px 12px; font-weight: 600;">@Model.Count yêu cầu</span>
    </div>
    <div class="table-responsive">
        <table class="table portal-table align-middle" style="min-width: 800px;">
            <thead>
                <tr>
                    <th style="width: 25%;">Họ và tên</th>
                    <th style="width: 25%;">Email đăng nhập</th>
                    <th style="width: 20%;">Số điện thoại</th>
                    <th style="width: 15%;">Ngày gửi yêu cầu</th>
                    <th class="text-end" style="width: 15%;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <i class="fas fa-inbox fa-2x d-block mb-3" style="color: #e5e7eb;"></i>
                            Chưa có yêu cầu nâng cấp nào cần phê duyệt.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-shrink-0 d-flex align-items-center justify-content-center" 
                                         style="width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #7c3aed, #a855f7); color: #fff; font-weight: 700; font-size: 1rem;">
                                        @(string.IsNullOrEmpty(item.HoTen) ? "U" : item.HoTen[0].ToString().ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="font-size: .95rem; color: #1a1a2e;">@item.HoTen</div>
                                        <div class="text-muted small">Người dùng nâng cấp</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary" style="font-size: .92rem;">@item.Email</span>
                            </td>
                            <td>
                                <span class="font-monospace text-dark" style="font-size: .9rem;"><i class="fas fa-phone text-muted me-1 small"></i> @item.SdtBanToChuc</span>
                            </td>
                            <td>
                                <span class="text-secondary small">
                                    <i class="fas fa-calendar-alt text-muted me-1 small"></i> 
                                    @(item.NgayYeuCauBTC.HasValue ? item.NgayYeuCauBTC.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <form class="d-inline" method="post" action="/Admin/XuLyDuyetBTC" onsubmit="return confirm('Bạn có chắc chắn muốn phê duyệt tài khoản này làm Ban tổ chức?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="true" />
                                        <button class="btn btn-sm btn-success fw-semibold" type="submit" style="border-radius: 8px; font-size: .78rem; padding: 6px 12px;">
                                            <i class="fas fa-check me-1"></i> Duyệt
                                        </button>
                                    </form>

                                    <button class="btn btn-sm btn-outline-danger fw-semibold" type="button" 
                                            onclick="showRejectModal('@item.Id', '@item.HoTen.Replace("'", "\\'")')"
                                            style="border-radius: 8px; font-size: .78rem; padding: 6px 12px;">
                                        <i class="fas fa-times me-1"></i> Từ chối
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Từ chối duyệt -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="rejectModalLabel"><i class="fas fa-ban text-danger me-2"></i> Từ chối yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Admin/XuLyDuyetBTC">
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectUserId" />
                    <input type="hidden" name="status" value="false" />
                    <p class="small text-muted mb-3">Vui lòng điền lý do từ chối yêu cầu làm Ban tổ chức của <strong id="rejectUserName"></strong>:</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do từ chối <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="lyDo" rows="3" required placeholder="Ví dụ: Số điện thoại không liên lạc được, hoặc thông tin tổ chức chưa đầy đủ..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function showRejectModal(id, name) {
        document.getElementById('rejectUserId').value = id;
        document.getElementById('rejectUserName').textContent = name;
        const rejectModal = new bootstrap.Modal(document.getElementById('rejectModal'));
        rejectModal.show();
    }
</script>
