@* ChiTietDonHang() gọi return View(donHang), vì vậy Model của trang là một DonHang. *@
@model DonHang

@{
    Layout = "~/Views/Shared/_AdminSimpleLayout.cshtml";
    ViewData["Title"] = "Chi tiết đơn";

    // Danh sách vé là dữ liệu phụ được Controller gửi trong ViewBag.ChiTiet.
    // Nếu ép kiểu thất bại hoặc dữ liệu null thì dùng danh sách rỗng.
    var chiTiet = ViewBag.ChiTiet as List<ChiTietDonHang> ?? new();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="portal-page-title">
        @* Model lấy dữ liệu từ object donHang mà Controller trả về. *@
        <h1>Đơn @Model.MaDonHang</h1>

        @* TenSuKien không thuộc model DonHang nên Controller gửi riêng bằng ViewBag. *@
        <p>@ViewBag.TenSuKien</p>
    </div>

    @* Link này tạo request GET /Admin/DonHang để quay lại action danh sách. *@
    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="DonHang">Quay lại</a>
</div>

@* TempData giữ thông báo qua được một lần redirect; nếu có lỗi thì mới in khối HTML này. *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="portal-card portal-card-body">
            <span class="text-muted">Người mua</span>
            <strong class="d-block">@Model.HoTenNguoiMua</strong>
            <small>@Model.EmailNguoiMua</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="portal-card portal-card-body">
            <span class="text-muted">Tổng thanh toán</span>
            <strong class="d-block fs-5">@Model.TongThanhToan.ToString("N0") VND</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="portal-card portal-card-body">
            <span class="text-muted">Trạng thái</span>
            <strong class="d-block">@(Model.TrangThai == 0 ? "Chờ thanh toán" : Model.TrangThai == 1 ? "Đã thanh toán" : Model.TrangThai == 2 ? "Đã hủy" : Model.TrangThai == 4 ? "Hết hạn" : "Không xác định")</strong>
        </div>
    </div>
</div>

<div class="portal-card mb-3">
    <div class="portal-card-header">
        <h2>Vé trong đơn</h2>
    </div>
    <div class="table-responsive">
        <table class="table portal-table">
            <thead>
                <tr>
                    <th>Người tham dự</th>
                    <th>Email</th>
                    <th>Loại vé</th>
                    <th>Số ghế</th>
                    <th>Mã vé</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @* Một đơn có thể có nhiều vé nên lặp List<ChiTietDonHang>. *@
                @foreach (var item in chiTiet)
                {
                    <tr>
                        <td>@item.TenNguoiThamDu</td>
                        <td>@item.EmailNguoiThamDu</td>
                        <td><span class="badge bg-info text-dark">@item.TenLoaiVe</span></td>
                        <td>
                            @* SoGhe có thể null/rỗng với sự kiện không sử dụng sơ đồ ghế. *@
                            @if (!string.IsNullOrEmpty(item.SoGhe))
                            {
                                <span class="badge bg-secondary"><i class="fas fa-chair me-1"></i>@item.SoGhe</span>
                            }
                            else
                            {
                                <span class="text-muted small">Không có</span>
                            }
                        </td>
                        <td><code>@item.MaVe</code></td>
                        <td>@item.GiaVe.ToString("N0") VND</td>
                        <td>
                            @* Đổi mã check-in trong database thành nhãn hiển thị. *@
                            @if (item.TrangThaiCheckin == 1)
                            {
                                <span class="badge bg-success">Đã check-in</span>
                            }
                            else if (item.TrangThaiCheckin == 2)
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chưa sử dụng</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
