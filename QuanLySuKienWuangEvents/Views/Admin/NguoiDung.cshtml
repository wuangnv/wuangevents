@model List<NguoiDung>

@{
    Layout = "~/Views/Shared/_AdminSimpleLayout.cshtml";
    ViewData["Title"] = "Người dùng";
}

<div class="d-flex justify-content-between align-items-start mb-4 gap-3">
    <div class="portal-page-title"><span class="portal-kicker"><i class="fas fa-users"></i> Tài khoản</span><h1>Quản lý người dùng</h1><p>Tìm kiếm, lọc và khóa hoặc mở tài khoản.</p></div>
    <a class="btn btn-outline-primary" href="/Admin/XuatFileCsvNguoiDung?vaiTro=@ViewBag.VaiTro&trangThai=@ViewBag.TrangThai&search=@ViewBag.Search"><i class="fas fa-file-csv me-1"></i> Xuất CSV</a>
</div>

<div class="portal-card mb-3"><div class="portal-card-body"><form method="get" class="row g-2">
    <div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Tên hoặc email" /></div>
    <div class="col-md-3"><select class="form-select" name="vaiTro"><option value="">Tất cả vai trò</option><option value="0">Người mua</option><option value="1">Ban tổ chức</option><option value="2">Nhân viên soát vé</option><option value="3">Quản trị viên</option></select></div>
    <div class="col-md-2"><select class="form-select" name="trangThai"><option value="">Tất cả</option><option value="1">Hoạt động</option><option value="0">Bị khóa</option></select></div>
    <div class="col-md-2 d-grid"><button class="btn btn-primary">Lọc</button></div>
</form></div></div>

<div class="portal-card"><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>Người dùng</th><th>Vai trò</th><th>Ngày tạo</th><th>Trạng thái</th><th class="text-end">Hành động</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr>
        <td><a href="/Admin/ChiTietNguoiDung/@item.Id" class="text-decoration-none fw-bold text-dark">@item.HoTen</a><div class="text-muted small">@item.Email</div></td>
        <td>@Role(item.VaiTro)</td>
        <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
        <td>
            @if (item.TrangThai == 1) {
                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:.75rem;border-radius:8px;padding:3px 10px;"><i class="fas fa-circle-check me-1"></i>Hoạt động</span>
            } else {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:.75rem;border-radius:8px;padding:3px 10px;"><i class="fas fa-ban me-1"></i>Bị khóa</span>
            }
        </td>
        <td class="text-end">
            <div class="d-flex justify-content-end align-items-center gap-1">
                <a href="/Admin/ChiTietNguoiDung/@item.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-info-circle me-1"></i>Chi tiết</a>
                @if (item.VaiTro != 3) {
                    <form method="post" action="/Admin/KhoaMoKhoaNguoiDung/@item.Id" class="m-0"
                          onsubmit="return confirm('@(item.TrangThai == 1 ? "Khóa tài khoản " + item.HoTen + "?\\nNgười dùng sẽ không thể đăng nhập cho đến khi được mở khóa." : "Mở khóa tài khoản " + item.HoTen + "?")')">
                        <button class="btn btn-sm @(item.TrangThai == 1 ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                            @if (item.TrangThai == 1) { <i class="fas fa-lock me-1"></i> } else { <i class="fas fa-lock-open me-1"></i> }
                            @(item.TrangThai == 1 ? "Khóa" : "Mở khóa")
                        </button>
                    </form>
                }
            </div>
        </td>
    </tr>
}
</tbody></table></div></div>

@functions { private static string Role(byte value) => value == 3 ? "Quản trị viên" : value == 2 ? "Nhân viên soát vé" : value == 1 ? "Ban tổ chức" : "Người mua"; }
