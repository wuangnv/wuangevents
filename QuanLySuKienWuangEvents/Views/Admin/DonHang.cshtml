@model List<DonHang>

@{
    Layout = "~/Views/Shared/_AdminSimpleLayout.cshtml";
    ViewData["Title"] = "Đơn hàng";
    var events = ViewBag.Events as Dictionary<Guid, string> ?? new();
}

<div class="portal-page-title mb-4"><span class="portal-kicker"><i class="fas fa-receipt"></i> Giao dịch</span><h1>Quản lý đơn hàng</h1><p>Xem toàn bộ đơn và xử lý hoàn tiền.</p></div>
<div class="portal-card mb-3"><div class="portal-card-body"><form method="get" class="row g-2"><div class="col-md-7"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Mã đơn, tên hoặc email" /></div><div class="col-md-3"><select class="form-select" name="trangThai"><option value="">Tất cả trạng thái</option><option value="0">Chờ thanh toán</option><option value="1">Đã thanh toán</option><option value="2">Đã hủy</option><option value="3">Hoàn tiền</option><option value="4">Hết hạn</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Lọc</button></div></form></div></div>
<div class="portal-card"><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>Mã đơn</th><th>Sự kiện</th><th>Người mua</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th><th></th></tr></thead><tbody>
@foreach(var item in Model){
    <tr>
        <td>
            <strong>@item.MaDonHang</strong>
            <div class="text-muted small">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
        </td>
        <td>@events.GetValueOrDefault(item.SuKienId)</td>
        <td>
            @item.HoTenNguoiMua
            <div class="text-muted small">@item.EmailNguoiMua</div>
        </td>
        <td>
            @if (item.TrangThai == 1)
            {
                <span class="badge bg-success text-white">Đã thanh toán</span>
            }
            else if (item.TrangThai == 2)
            {
                <span class="badge bg-danger text-white">Đã hủy</span>
            }
            else if (item.TrangThai == 3)
            {
                <span class="badge bg-info text-dark">Hoàn tiền</span>
            }
            else if (item.TrangThai == 4)
            {
                <span class="badge bg-secondary text-white">Hết hạn</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
            }
        </td>
        <td class="text-end"><strong>@item.TongThanhToan.ToString("N0")</strong>đ</td>
        <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="/Admin/ChiTietDonHang/@item.Id">Chi tiết</a>
        </td>
    </tr>
}
</tbody></table></div></div>
