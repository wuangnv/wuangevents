@* Controller truyền List<DonHang> qua return View(danhSachDonHang),
   nên View phải khai báo đúng kiểu dữ liệu nhận vào ở dòng @model. *@
@model List<DonHang>

@{
    // Trang này dùng giao diện chung dành cho Admin.
    Layout = "~/Views/Shared/_AdminSimpleLayout.cshtml";
    ViewData["Title"] = "Đơn hàng";

    // Controller gửi ViewBag.Events dưới dạng Dictionary<Guid, string>.
    // "as" thử ép về đúng kiểu; ?? new() tạo dictionary rỗng nếu không có dữ liệu.
    var events = ViewBag.Events as Dictionary<Guid, string> ?? new();
}

<div class="portal-page-title mb-4">
    <span class="portal-kicker"><i class="fas fa-receipt"></i> Giao dịch</span>
    <h1>Quản lý đơn hàng</h1>
</div>

@* Form GET tạo /Admin/DonHang?search=...&trangThai=...; tên input phải trùng tham số action. *@
<div class="portal-card mb-3">
    <div class="portal-card-body">
        <form method="get" asp-controller="Admin" asp-action="DonHang" class="row g-2">
            <div class="col-md-7">
                @* value giữ lại chữ tìm kiếm mà Controller gửi về qua ViewBag.Search. *@
                <input class="form-control"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Mã đơn, tên hoặc email" />
            </div>
            <div class="col-md-3">
                <select class="form-select" name="trangThai">
                    <option value="">Tất cả trạng thái</option>
                    <option value="0">Chờ thanh toán</option>
                    <option value="1">Đã thanh toán</option>
                    <option value="2">Đã hủy</option>
                    <option value="4">Hết hạn</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                @* button trong form mặc định là nút submit. *@
                <button class="btn btn-primary">Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="portal-card">
    <div class="table-responsive">
        <table class="table portal-table align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Sự kiện</th>
                    <th>Người mua</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @* Model là List<DonHang>; foreach lấy từng DonHang và đặt tên tạm là item. *@
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @* Dấu @ chuyển từ HTML sang đọc giá trị C# của object item. *@
                            <strong>@item.MaDonHang</strong>
                            <div class="text-muted small">@VietnamTime.FromUtc(item.NgayTao).ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                        @* Model DonHang chỉ có SuKienId nên dùng Id đó tra tên trong dictionary. *@
                        <td>@events.GetValueOrDefault(item.SuKienId)</td>
                        <td>
                            @item.HoTenNguoiMua
                            <div class="text-muted small">@item.EmailNguoiMua</div>
                        </td>
                        <td>
                            @* Database lưu trạng thái bằng số; View đổi số thành nhãn cho con người. *@
                            @if (item.TrangThai == 1)
                            {
                                <span class="badge bg-success text-white">Đã thanh toán</span>
                            }
                            else if (item.TrangThai == 2)
                            {
                                <span class="badge bg-danger text-white">Đã hủy</span>
                            }
                            else if (item.TrangThai == 4)
                            {
                                <span class="badge bg-secondary text-white">Hết hạn</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                            }
                        </td>
                        @* N0 định dạng tiền không có phần thập phân và có phân cách hàng nghìn. *@
                        <td class="text-end"><strong>@item.TongThanhToan.ToString("N0")</strong>đ</td>
                        <td class="text-end">
                            @* Tag Helper tạo /Admin/ChiTietDonHang/{id}; browser gọi action ChiTietDonHang. *@
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="Admin"
                               asp-action="ChiTietDonHang"
                               asp-route-id="@item.Id">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
