@model SuKien
@{
    ViewData["Title"] = "Chọn ghế - " + Model.TenSuKien;
    var loaiVes = ViewBag.LoaiVes as List<LoaiVe> ?? new List<LoaiVe>();
}

@section Styles {
<style>
/* ===== CHON GHE — TICKETBOX STANDARD UX ===== */
*, *::before, *::after { box-sizing: border-box; }

body { background: #f1f5f9; }

.chon-ghe-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 16px 100px;
}

/* ── Top Bar ── */
.cghe-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    gap: 16px;
    flex-wrap: wrap;
}
.cghe-event-info .back-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #4f46e5;
    font-size: .83rem;
    font-weight: 750;
    text-decoration: none;
    margin-bottom: 5px;
    transition: .15s;
}
.cghe-event-info .back-link:hover { color: #3730a3; }
.cghe-event-info h1 { font-size: 1.4rem; font-weight: 850; color: #1e1b4b; margin: 0 0 4px; }
.cghe-event-info .event-meta { color: #64748b; font-size: .84rem; font-weight: 600; }

.booking-stepper {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 6px rgba(0,0,0,.03);
}
.step-item { font-size: .82rem; font-weight: 800; color: #94a3b8; display: flex; align-items: center; gap: 6px; }
.step-item.active { color: #4f46e5; }
.step-item.active .step-num { background: #4f46e5; color: #fff; }
.step-num { width: 22px; height: 22px; border-radius: 50%; background: #f1f5f9; color: #64748b; display: grid; place-items: center; font-size: .72rem; font-weight: 850; }
.step-sep { color: #cbd5e1; font-size: .75rem; }

/* ── Main 2-col grid ── */
.cghe-layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 20px;
    align-items: start;
}

/* ── Map Card ── */
.map-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,.04);
    min-width: 0;
}

/* Map controls */
.map-ctrl {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
    flex-wrap: wrap;
    gap: 10px;
}
.map-hint { font-size: .82rem; color: #64748b; font-weight: 650; display: flex; align-items: center; gap: 6px; }
.map-tools { display: flex; align-items: center; gap: 5px; }
.mtool-btn {
    width: 32px;
    height: 32px;
    border: 1px solid #cbd5e1;
    background: #fff;
    border-radius: 8px;
    color: #334155;
    font-weight: 850;
    font-size: .88rem;
    cursor: pointer;
    transition: .15s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.mtool-btn:hover { background: #f8fafc; border-color: #94a3b8; }
.zoom-lbl { font-size: .78rem; font-weight: 750; color: #64748b; min-width: 44px; text-align: center; }

/* ── Venue Stage Header ── */
.venue-stage-header {
    text-align: center;
    margin-bottom: 20px;
}
.stage-label {
    display: inline-block;
    background: #1e1b4b;
    color: #fff;
    padding: 8px 40px;
    border-radius: 0 0 40% 40% / 0 0 20px 20px;
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(30,27,75,.2);
}
.perspective-line {
    height: 3px;
    background: linear-gradient(to right, transparent 5%, #e2e8f0 30%, #e2e8f0 70%, transparent 95%);
    margin-top: 4px;
    border-radius: 2px;
}

/* ── Seat Map Viewport ── */
.map-viewport {
    overflow: auto;
    padding: 16px 8px;
    background: #fafbfc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    position: relative;
}

/* ── Zone layout: stacks of zones per row separated by aisles ── */
.zone-stage-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 700px;
    transition: transform .2s ease;
}

/* Each "row" of zones (side by side) */
.zone-row-group {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: nowrap;
}
.zone-row-group.single-center { justify-content: center; }
.zone-row-group.spread { justify-content: space-between; }

/* ── Zone Box ── */
.zone-box {
    background: #fff;
    border: 1.5px solid var(--zc, #4f46e5);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.04);
    transition: box-shadow .15s;
    flex-shrink: 0;
}
.zone-box:hover { box-shadow: 0 6px 20px rgba(0,0,0,.09); }

.zone-header {
    padding: 8px 14px 6px;
    background: color-mix(in srgb, var(--zc, #4f46e5) 9%, #fff);
    border-bottom: 1px solid color-mix(in srgb, var(--zc, #4f46e5) 18%, #fff);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}
.zone-name {
    font-size: .78rem;
    font-weight: 850;
    color: var(--zc, #4f46e5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
}
.zone-price-badge {
    font-size: .7rem;
    font-weight: 850;
    color: #fff;
    background: var(--zc, #4f46e5);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
}

/* GA Zone */
.zone-box.ga-zone .zone-seats {
    background: repeating-linear-gradient(45deg, #fafafa, #fafafa 8px, #f1f5f9 8px, #f1f5f9 16px);
    padding: 18px 20px;
    text-align: center;
    cursor: pointer;
    transition: background .15s;
}
.zone-box.ga-zone .zone-seats:hover { background: color-mix(in srgb, var(--zc, #4f46e5) 8%, #fff); }
.ga-capacity-info { font-size: .84rem; font-weight: 850; color: var(--zc, #4f46e5); }
.ga-cap-sub { font-size: .72rem; color: #64748b; margin-top: 3px; }
.ga-qty-ctrl { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px; }
.ga-qty-btn {
    width: 30px; height: 30px; border-radius: 50%;
    border: 2px solid var(--zc, #4f46e5);
    background: #fff; color: var(--zc, #4f46e5);
    font-size: 1rem; font-weight: 850; cursor: pointer;
    display: grid; place-items: center; transition: .15s;
}
.ga-qty-btn:hover { background: var(--zc, #4f46e5); color: #fff; }
.ga-qty-num { font-size: 1rem; font-weight: 850; color: #1e1b4b; min-width: 24px; text-align: center; }

/* Seat rows */
.zone-seats {
    padding: 10px 12px 12px;
}
.seat-row {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-bottom: 3px;
    justify-content: center;
}
.row-lbl {
    width: 20px;
    text-align: right;
    font-size: .67rem;
    font-weight: 850;
    color: #94a3b8;
    flex-shrink: 0;
    margin-right: 3px;
}

/* ── SEAT BUTTON (Ticketbox-style) ── */
.seat-btn {
    width: 28px;
    height: 24px;
    border-radius: 6px 6px 3px 3px;
    border: 1.5px solid var(--zc, #4f46e5);
    background: color-mix(in srgb, var(--zc, #4f46e5) 8%, #fff);
    color: var(--zc, #4f46e5);
    font-size: .58rem;
    font-weight: 850;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all .12s ease;
    user-select: none;
    outline: none;
    position: relative;
    flex-shrink: 0;
    /* Chair back effect */
    box-shadow: 0 -2px 0 0 color-mix(in srgb, var(--zc, #4f46e5) 30%, #fff) inset;
}
.seat-btn:hover:not(:disabled) {
    background: var(--zc, #4f46e5);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,0,0,.15), 0 -2px 0 0 color-mix(in srgb, var(--zc, #4f46e5) 60%, #000) inset;
}
.seat-btn.selected {
    background: var(--zc, #4f46e5);
    color: #fff;
    box-shadow: 0 0 0 2.5px #fff, 0 0 0 4.5px var(--zc, #4f46e5), 0 -2px 0 0 color-mix(in srgb, var(--zc, #4f46e5) 60%, #000) inset;
    transform: translateY(-2px) scale(1.07);
    z-index: 2;
}
.seat-btn.held {
    background: #fef3c7;
    border-color: #f59e0b;
    color: #92400e;
    cursor: not-allowed;
    box-shadow: 0 -2px 0 0 #f59e0b inset;
}
.seat-btn.sold {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #b91c1c;
    cursor: not-allowed;
    box-shadow: 0 -2px 0 0 #fca5a5 inset;
}
.seat-btn.locked, .seat-btn.unavail {
    background: #f1f5f9;
    border-color: #dde2ec;
    color: #c1cad8;
    cursor: not-allowed;
    box-shadow: 0 -2px 0 0 #dde2ec inset;
}

/* Aisle spacer */
.aisle { width: 18px; flex-shrink: 0; }

/* ── Legend ── */
.legend-bar {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    border-top: 1px solid #f1f5f9;
    margin-top: 14px;
    padding-top: 12px;
    font-size: .77rem;
    color: #64748b;
    font-weight: 650;
}
.legend-bar span { display: flex; align-items: center; gap: 5px; }
.leg-box {
    width: 20px; height: 17px;
    border-radius: 4px 4px 2px 2px;
    display: inline-block;
    border: 1.5px solid;
}

/* ── Order Summary Sidebar ── */
.order-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 4px 14px rgba(0,0,0,.03);
    position: sticky;
    top: 90px;
}
.order-title { font-size: 1.05rem; font-weight: 850; color: #1e1b4b; margin: 0 0 14px; }

/* Ticket pricing chips */
.pricing-list { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; }
.pricing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    border-radius: 10px;
    border: 1px solid #f1f5f9;
    background: #fafafa;
}
.pricing-badge { display: flex; align-items: center; gap: 8px; font-size: .82rem; font-weight: 750; color: #334155; }
.pricing-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.pricing-num { font-size: .82rem; font-weight: 850; color: #4f46e5; }

/* Selected seats */
.sel-section { border-top: 1px solid #f1f5f9; padding-top: 14px; margin-bottom: 16px; }
.sel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.sel-head strong { font-size: .9rem; color: #1e1b4b; }
.sel-badge { padding: 3px 9px; border-radius: 999px; background: #e0e7ff; color: #4f46e5; font-size: .74rem; font-weight: 850; }

.empty-state {
    padding: 20px 14px;
    text-align: center;
    background: #f8fafc;
    border: 1.5px dashed #cbd5e1;
    border-radius: 12px;
    color: #94a3b8;
    font-size: .82rem;
}
.empty-state i { font-size: 1.6rem; display: block; margin-bottom: 6px; }

.sel-list { display: flex; flex-direction: column; gap: 7px; max-height: 230px; overflow-y: auto; }
.sel-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    border-radius: 10px;
    background: #f8fafc;
    border-left: 4px solid var(--sc, #4f46e5);
}
.sel-name { font-size: .85rem; font-weight: 850; color: #1e1b4b; }
.sel-sub { font-size: .71rem; color: #64748b; }
.sel-right { display: flex; align-items: center; gap: 8px; }
.sel-price { font-size: .84rem; color: #4f46e5; font-weight: 850; }
.btn-rm {
    border: 0; background: #fee2e2; color: #dc2626;
    width: 20px; height: 20px; border-radius: 50%;
    font-size: .65rem; display: grid; place-items: center;
    cursor: pointer; transition: .15s;
}
.btn-rm:hover { background: #fca5a5; }

.total-row {
    border-top: 1.5px solid #f1f5f9;
    padding-top: 14px;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
}
.total-row span { font-size: .84rem; color: #64748b; font-weight: 700; }
.total-row strong { font-size: 1.35rem; color: #4f46e5; font-weight: 900; }

.btn-checkout {
    width: 100%;
    border: 0;
    border-radius: 12px;
    background: #4f46e5;
    color: #fff;
    padding: 13px 18px;
    font-size: .92rem;
    font-weight: 850;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background .15s, transform .1s;
}
.btn-checkout:hover:not(:disabled) { background: #4338ca; transform: translateY(-1px); }
.btn-checkout:disabled { background: #cbd5e1; cursor: not-allowed; transform: none; }

.guarantee-note {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #64748b;
    font-size: .73rem;
    font-weight: 650;
    margin-top: 12px;
    line-height: 1.4;
}

/* Tooltip */
.seat-tooltip {
    position: fixed;
    z-index: 9999;
    background: #1e293b;
    color: #fff;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: .73rem;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(0,0,0,.2);
    display: none;
    transform: translate(-50%, calc(-100% - 8px));
    white-space: nowrap;
    line-height: 1.4;
    text-align: center;
}
.seat-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -4px;
    border: 4px solid transparent;
    border-top-color: #1e293b;
}

@@media(max-width:992px) { .cghe-layout { grid-template-columns: 1fr; } .order-card { position: static; } }
@@media(max-width:640px) { .cghe-topbar { flex-direction: column; align-items: flex-start; } .booking-stepper { display: none; } }
</style>
}

<main class="chon-ghe-page">
    <!-- Top Bar -->
    <div class="cghe-topbar">
        <div class="cghe-event-info">
            <a class="back-link" href="/Home/ChiTiet/@Model.Id"><i class="fas fa-arrow-left"></i> Quay lại sự kiện</a>
            <h1>Chọn ghế của bạn</h1>
            <div class="event-meta">
                <i class="fas fa-calendar-alt me-1 text-primary"></i>@Model.TenSuKien · @Model.NgayBatDau.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
        <div class="booking-stepper">
            <div class="step-item active"><span class="step-num">1</span><span>Chọn ghế</span></div>
            <span class="step-sep"><i class="fas fa-chevron-right"></i></span>
            <div class="step-item"><span class="step-num">2</span><span>Thanh toán</span></div>
            <span class="step-sep"><i class="fas fa-chevron-right"></i></span>
            <div class="step-item"><span class="step-num">3</span><span>Nhận vé</span></div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 py-2 px-3 mb-3 fw-bold">
            <i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="cghe-layout">
        <!-- Seat Map Card -->
        <section class="map-card">
            <div class="map-ctrl">
                <div class="map-hint"><i class="fas fa-hand-pointer text-primary"></i> Nhấp vào ghế trống để chọn chỗ ngồi của bạn</div>
                <div class="map-tools">
                    <button class="mtool-btn" onclick="doZoom(-0.15)" title="Thu nhỏ">−</button>
                    <span class="zoom-lbl" id="zoomTxt">100%</span>
                    <button class="mtool-btn" onclick="doZoom(0.15)" title="Phóng to">+</button>
                    <button class="mtool-btn" onclick="doZoom(0)" title="Đặt lại"><i class="fas fa-compress-arrows-alt"></i></button>
                </div>
            </div>

            <!-- Loading state -->
            <div id="mapLoading" style="text-align:center;padding:60px 0;color:#94a3b8">
                <i class="fas fa-spinner fa-spin fa-2x" style="color:#4f46e5;margin-bottom:12px;display:block"></i>
                <div style="font-weight:750;font-size:.9rem">Đang tải sơ đồ...</div>
            </div>

            <!-- Map viewport -->
            <div class="map-viewport" id="mapVp" style="display:none">
                <!-- Stage -->
                <div class="venue-stage-header" id="stageHeader">
                    <div class="stage-label" id="stageLbl">SÂN KHẤU CHÍNH</div>
                    <div class="perspective-line"></div>
                </div>
                <!-- Zone blocks rendered here -->
                <div class="zone-stage-wrapper" id="zoneWrapper"></div>
            </div>

            <!-- Legend -->
            <div class="legend-bar" id="legendBar" style="display:none">
                <span><span class="leg-box" style="background:color-mix(in srgb,#4f46e5 8%,#fff);border-color:#4f46e5"></span>Trống (Nhấp để chọn)</span>
                <span><span class="leg-box" style="background:#4f46e5;border-color:#4f46e5"></span>Đang chọn</span>
                <span><span class="leg-box" style="background:#fef3c7;border-color:#f59e0b"></span>Đang giữ</span>
                <span><span class="leg-box" style="background:#fee2e2;border-color:#fca5a5"></span>Đã bán</span>
                <span><span class="leg-box" style="background:#f1f5f9;border-color:#dde2ec"></span>Không khả dụng</span>
            </div>
        </section>

        <!-- Order Summary Sidebar -->
        <aside class="order-card">
            <h2 class="order-title"><i class="fas fa-ticket me-2 text-primary"></i>Bảng giá vé</h2>
            <div class="pricing-list">
                @foreach (var ve in loaiVes)
                {
                    <div class="pricing-item">
                        <div class="pricing-badge">
                            <span class="pricing-dot" style="background:@(ve.MauSac ?? "#4f46e5")"></span>
                            @ve.TenLoaiVe
                        </div>
                        <div class="pricing-num">@ve.GiaBan.ToString("N0")đ</div>
                    </div>
                }
            </div>

            <div class="sel-section">
                <div class="sel-head">
                    <strong>Ghế đã chọn</strong>
                    <span class="sel-badge" id="selCountBadge">0 ghế</span>
                </div>
                <div id="emptyState" class="empty-state">
                    <i class="fas fa-chair"></i>Bạn chưa chọn ghế nào
                </div>
                <div id="selList" class="sel-list" style="display:none"></div>
            </div>

            <div class="total-row">
                <span>Tổng tạm tính</span>
                <strong id="grandTotal">0đ</strong>
            </div>

            <form method="post" action="/Booking/DatVe" id="bookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="suKienId" value="@Model.Id" />
                <div id="hiddenSeats"></div>
                <button type="submit" class="btn-checkout" id="btnCheckout" disabled>
                    <span id="btnCheckoutTxt">Tiếp tục thanh toán</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="guarantee-note">
                <i class="fas fa-shield-halved text-success fs-5"></i>
                <span>Ghế được giữ độc quyền trong 10–15 phút khi chuyển sang thanh toán.</span>
            </div>
        </aside>
    </div>
</main>

<div id="seatTooltip" class="seat-tooltip"></div>

@section Scripts {
<script>
const EVENT_ID = '@Model.Id';
const MAX_SEATS = 8;
const selectedSeats = new Map();   // seatId → { id, label, zoneName, ticketName, ticketId, price, color }
const typeCounts = new Map();      // ticketTypeId → count
const money = v => new Intl.NumberFormat('vi-VN').format(v) + 'đ';
const vo = (o, a, b) => o[a] ?? o[b];  // camelCase / PascalCase fallback

let curZoom = 1;

// ── Tooltip ──────────────────────────────────────────────────────────────────
const tooltip = document.getElementById('seatTooltip');
function showTip(e, html) {
    tooltip.innerHTML = html;
    tooltip.style.left = e.clientX + 'px';
    tooltip.style.top  = e.clientY + 'px';
    tooltip.style.display = 'block';
}
function hideTip() { tooltip.style.display = 'none'; }

// ── Zoom ──────────────────────────────────────────────────────────────────────
function doZoom(delta) {
    if (delta === 0) { curZoom = 1; }
    else { curZoom = Math.max(0.6, Math.min(1.6, curZoom + delta)); }
    document.getElementById('zoomTxt').textContent = Math.round(curZoom * 100) + '%';
    const w = document.getElementById('zoneWrapper');
    if (w) { w.style.transform = `scale(${curZoom})`; w.style.transformOrigin = 'top center'; }
}

// ── Load & render ─────────────────────────────────────────────────────────────
async function loadMap() {
    try {
        const res = await fetch('/Booking/LaySoDoGheTheoSuKien?suKienId=' + EVENT_ID);
        if (!res.ok) throw new Error('Lỗi tải dữ liệu');
        const seats = await res.json();
        renderMap(seats);
    } catch (err) {
        document.getElementById('mapLoading').innerHTML =
            `<div style="color:#dc2626;font-weight:750"><i class="fas fa-triangle-exclamation me-2"></i>${err.message}</div>`;
    }
}

function renderMap(seats) {
    const loading = document.getElementById('mapLoading');
    const vp      = document.getElementById('mapVp');
    const wrapper = document.getElementById('zoneWrapper');
    const legend  = document.getElementById('legendBar');

    if (!seats || !seats.length) {
        loading.innerHTML = '<div style="color:#94a3b8;font-weight:700">Sự kiện này chưa có sơ đồ chỗ ngồi.</div>';
        return;
    }

    // Stage label
    const layout = vo(seats[0], 'loaiSoDo', 'LoaiSoDo') || '';
    document.getElementById('stageLbl').textContent =
        layout === 'cinema' ? 'MÀN HÌNH CHIẾU CHÍNH' :
        layout === 'arena'  ? 'SÀN ĐẤU TRUNG TÂM / ARENA' :
        'SÂN KHẤU CHÍNH / MAIN STAGE';

    loading.style.display = 'none';
    vp.style.display = '';
    legend.style.display = '';

    // Build zone map: zoneId → zone object
    const zonesMap = new Map();
    seats.forEach(seat => {
        const zId = vo(seat, 'khuVucId', 'KhuVucId');
        if (!zonesMap.has(zId)) {
            zonesMap.set(zId, {
                id: zId,
                name: vo(seat, 'tenKhuVuc', 'TenKhuVuc'),
                color: vo(seat, 'mauSac', 'MauSac') || '#4f46e5',
                order: Number(vo(seat, 'thuTuKhuVuc', 'ThuTuKhuVuc') || 0),
                viTriX: Number(vo(seat, 'khuVucViTriX', 'KhuVucViTriX') || 0),
                viTriY: Number(vo(seat, 'khuVucViTriY', 'KhuVucViTriY') || 0),
                ticketName: vo(seat, 'tenLoaiVe', 'TenLoaiVe'),
                ticketId: vo(seat, 'loaiVeId', 'LoaiVeId'),
                price: Number(vo(seat, 'giaBan', 'GiaBan')),
                rows: new Map()
            });
        }
        const z = zonesMap.get(zId);
        const rId = vo(seat, 'hangGheId', 'HangGheId');
        if (!z.rows.has(rId)) {
            z.rows.set(rId, {
                id: rId,
                name: vo(seat, 'tenHang', 'TenHang'),
                order: Number(vo(seat, 'thuTuHang', 'ThuTuHang') || 0),
                seats: []
            });
        }
        z.rows.get(rId).seats.push(seat);
    });

    // Sort zones by order
    const sortedZones = [...zonesMap.values()].sort((a, b) => a.order - b.order);

    // Detect GA zones (row name == 'GA')
    const isGA = zone => {
        const rows = [...zone.rows.values()];
        return rows.length === 1 && rows[0].name === 'GA';
    };

    // Group zones into visual rows for layout (by viTriY bucket, or auto-group for 2-per-row)
    // Strategy: zones are sorted by order; group into rows of max 3 per row
    // For wings layout: 2 side zones + 1 center = 3 per row
    const zoneGroups = [];
    const ZONES_PER_ROW = 3;
    for (let i = 0; i < sortedZones.length; i += ZONES_PER_ROW) {
        zoneGroups.push(sortedZones.slice(i, i + ZONES_PER_ROW));
    }

    wrapper.innerHTML = '';
    zoneGroups.forEach((group, gIdx) => {
        const rowDiv = document.createElement('div');
        rowDiv.className = 'zone-row-group';
        if (group.length === 1) rowDiv.classList.add('single-center');
        else rowDiv.classList.add('spread');

        group.forEach(zone => {
            const zoneEl = buildZoneEl(zone, isGA(zone));
            rowDiv.appendChild(zoneEl);
        });
        wrapper.appendChild(rowDiv);
    });
}

function buildZoneEl(zone, ga) {
    const box = document.createElement('div');
    box.className = 'zone-box' + (ga ? ' ga-zone' : '');
    box.style.setProperty('--zc', zone.color);

    // Header
    const hdr = document.createElement('div');
    hdr.className = 'zone-header';
    hdr.innerHTML = `
        <span class="zone-name">${zone.name}</span>
        <span class="zone-price-badge">${money(zone.price)}</span>
    `;
    box.appendChild(hdr);

    const seatsArea = document.createElement('div');
    seatsArea.className = 'zone-seats';

    if (ga) {
        // GA Zone: Show capacity and quantity picker
        const rows = [...zone.rows.values()];
        const totalCap = rows.reduce((s, r) => s + r.seats.length, 0);
        const available = rows.reduce((s, r) => s + r.seats.filter(s2 => vo(s2, 'trangThai', 'TrangThai') === 0).length, 0);

        seatsArea.dataset.zoneId = zone.id;
        seatsArea.dataset.available = available;
        seatsArea.innerHTML = `
            <div class="ga-capacity-info">
                <i class="fas fa-person-walking me-1"></i>Khu đứng tự do · ${available > 0 ? available + ' chỗ trống' : 'Hết chỗ'}
            </div>
            <div class="ga-cap-sub">${zone.ticketName}</div>
            ${available > 0 ? `
            <div class="ga-qty-ctrl">
                <button class="ga-qty-btn" onclick="gaQtyChange(this,-1,'${zone.id}')" style="--zc:${zone.color}">−</button>
                <span class="ga-qty-num" id="ga-qty-${zone.id}">0</span>
                <button class="ga-qty-btn" onclick="gaQtyChange(this,1,'${zone.id}')" style="--zc:${zone.color}">+</button>
            </div>` : ''}
        `;
        // Store GA meta for checkout
        seatsArea.dataset.ticketId   = zone.ticketId;
        seatsArea.dataset.price      = zone.price;
        seatsArea.dataset.ticketName = zone.ticketName;
        seatsArea.dataset.zoneName   = zone.name;
        seatsArea.dataset.color      = zone.color;
        seatsArea.dataset.gaSeats    = JSON.stringify([...zone.rows.values()][0].seats.filter(s => vo(s,'trangThai','TrangThai') === 0).map(s => vo(s,'id','Id')));
        box.appendChild(seatsArea);
        return box;
    }

    // Seated zone: render rows
    const rowsArr = [...zone.rows.values()].sort((a, b) => a.order - b.order);
    rowsArr.forEach(row => {
        const rowDiv = document.createElement('div');
        rowDiv.className = 'seat-row';
        // Row label
        const lbl = document.createElement('span');
        lbl.className = 'row-lbl';
        lbl.textContent = row.name;
        rowDiv.appendChild(lbl);

        // Seats
        row.seats.forEach(seat => {
            const btn = makeSeatBtn(seat, zone);
            rowDiv.appendChild(btn);
        });

        seatsArea.appendChild(rowDiv);
    });

    box.appendChild(seatsArea);
    return box;
}

function isSeatAvail(seat) {
    return vo(seat,'trangThai','TrangThai') === 0
        && vo(seat,'loaiVeDangBan','LoaiVeDangBan')
        && vo(seat,'trongThoiGianBan','TrongThoiGianBan')
        && Number(vo(seat,'soVeConLai','SoVeConLai')) > 0;
}

function makeSeatBtn(seat, zone) {
    const id     = vo(seat,'id','Id');
    const label  = vo(seat,'soGhe','SoGhe');
    const status = vo(seat,'trangThai','TrangThai');
    const avail  = isSeatAvail(seat);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'seat-btn';
    btn.style.setProperty('--zc', zone.color);
    btn.textContent = label;
    btn.dataset.seatId = id;
    btn.title = '';

    if (status === 1) btn.classList.add('held');
    else if (status === 2) btn.classList.add('sold');
    else if (status === 3) btn.classList.add('locked');
    else if (!avail) btn.classList.add('unavail');

    btn.disabled = status !== 0 || !avail;

    const tipHtml = `<strong>${label}</strong><br>${zone.name}<br>${zone.ticketName} · ${money(zone.price)}`;
    btn.addEventListener('mouseenter', e => showTip(e, tipHtml));
    btn.addEventListener('mousemove',  e => showTip(e, tipHtml));
    btn.addEventListener('mouseleave', hideTip);
    btn.addEventListener('click', () => { hideTip(); toggleSeat(btn, seat, zone); });

    return btn;
}

// ── GA quantity picker ────────────────────────────────────────────────────────
const gaSelections = new Map(); // zoneId → { count, seats[] }

function gaQtyChange(btn, delta, zoneId) {
    const area = btn.closest('.zone-seats');
    const available = Number(area.dataset.available);
    const numEl = document.getElementById('ga-qty-' + zoneId);
    const cur = gaSelections.get(zoneId) || { count: 0, seats: JSON.parse(area.dataset.gaSeats || '[]') };
    let newCount = Math.max(0, Math.min(Math.min(cur.count + delta, MAX_SEATS - selectedSeats.size - gaCountExcluding(zoneId)), available, 4));

    cur.count = newCount;
    gaSelections.set(zoneId, cur);
    numEl.textContent = newCount;

    // Rebuild GA selections in the order summary
    updateGAInSummary(zoneId, area, cur);
}

function gaCountExcluding(excl) {
    let c = 0;
    for (const [k, v] of gaSelections) { if (k !== excl) c += v.count; }
    return c;
}

function updateGAInSummary(zoneId, area, cur) {
    // Remove old GA items for this zone
    for (const [id, s] of selectedSeats) {
        if (s.gaZoneId === zoneId) selectedSeats.delete(id);
    }
    // Add new GA seat placeholders
    const available = cur.seats.slice(0, cur.count);
    available.forEach((id, i) => {
        selectedSeats.set('ga_' + zoneId + '_' + i, {
            id,
            label: '#' + (i + 1),
            zoneName: area.dataset.zoneName,
            ticketName: area.dataset.ticketName,
            ticketId: area.dataset.ticketId,
            price: Number(area.dataset.price),
            color: area.dataset.color,
            gaZoneId: zoneId
        });
    });
    updateSummary();
}

// ── Seat selection ────────────────────────────────────────────────────────────
function toggleSeat(btn, seat, zone) {
    const id       = vo(seat,'id','Id');
    const label    = vo(seat,'soGhe','SoGhe');
    const ticketId = vo(seat,'loaiVeId','LoaiVeId');
    const price    = Number(vo(seat,'giaBan','GiaBan'));

    if (selectedSeats.has(id)) {
        selectedSeats.delete(id);
        typeCounts.set(ticketId, Math.max(0, (typeCounts.get(ticketId) || 1) - 1));
        btn.classList.remove('selected');
    } else {
        const totalSelected = selectedSeats.size;
        if (totalSelected >= MAX_SEATS) {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(`Tối đa ${MAX_SEATS} ghế trong một đơn hàng.`, 'error');
            return;
        }
        const maxPerType = Math.min(vo(seat,'gioiHanMoiDon','GioiHanMoiDon') || MAX_SEATS, vo(seat,'soVeConLai','SoVeConLai') || MAX_SEATS);
        const curCount = typeCounts.get(ticketId) || 0;
        if (curCount >= maxPerType) {
            if (typeof WuangUI !== 'undefined') WuangUI.toast(`Loại vé "${zone.ticketName}" tối đa ${maxPerType} vé.`, 'error');
            return;
        }
        selectedSeats.set(id, { id, label, zoneName: zone.name, ticketName: zone.ticketName, ticketId, price, color: zone.color });
        typeCounts.set(ticketId, curCount + 1);
        btn.classList.add('selected');
    }
    updateSummary();
}

function removeSeat(seatId) {
    const s = selectedSeats.get(seatId);
    if (!s) return;
    selectedSeats.delete(seatId);
    typeCounts.set(s.ticketId, Math.max(0, (typeCounts.get(s.ticketId) || 1) - 1));
    const btn = document.querySelector(`.seat-btn[data-seat-id="${seatId}"]`);
    if (btn) btn.classList.remove('selected');
    updateSummary();
}

// ── Summary panel update ──────────────────────────────────────────────────────
function updateSummary() {
    const list   = document.getElementById('selList');
    const empty  = document.getElementById('emptyState');
    const badge  = document.getElementById('selCountBadge');
    const total  = document.getElementById('grandTotal');
    const btn    = document.getElementById('btnCheckout');
    const hidden = document.getElementById('hiddenSeats');
    const btnTxt = document.getElementById('btnCheckoutTxt');

    const seats = [...selectedSeats.values()];
    badge.textContent = seats.length + ' ghế';
    list.innerHTML = '';
    hidden.innerHTML = '';

    if (!seats.length) {
        empty.style.display = '';
        list.style.display  = 'none';
        total.textContent   = '0đ';
        btn.disabled = true;
        btnTxt.textContent = 'Tiếp tục thanh toán';
        return;
    }

    empty.style.display = 'none';
    list.style.display  = '';

    let sum = 0;
    seats.forEach(s => {
        sum += s.price;

        const row = document.createElement('div');
        row.className = 'sel-item';
        row.style.setProperty('--sc', s.color);
        row.innerHTML = `
            <div>
                <div class="sel-name">Ghế ${s.label}</div>
                <div class="sel-sub">${s.zoneName} · ${s.ticketName}</div>
            </div>
            <div class="sel-right">
                <span class="sel-price">${money(s.price)}</span>
                <button type="button" class="btn-rm" onclick="removeSeat(${JSON.stringify(s.id)})" title="Bỏ chọn"><i class="fas fa-xmark"></i></button>
            </div>
        `;
        list.appendChild(row);

        const inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = 'choNgoiIds';
        inp.value = s.id;
        hidden.appendChild(inp);
    });

    total.textContent = money(sum);
    btn.disabled = false;
    btnTxt.textContent = `Tiếp tục thanh toán (${seats.length} vé)`;
}

// ── Math.clamp polyfill (older browsers) ──────────────────────────────────────
Math.clamp = (v, a, b) => Math.min(Math.max(v, a), b);

// ── Boot ──────────────────────────────────────────────────────────────────────
loadMap();
</script>
}
