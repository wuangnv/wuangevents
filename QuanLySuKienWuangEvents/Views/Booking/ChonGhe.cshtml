@model QuanLySuKienWuangEvents.Models.SuKien
@using QuanLySuKienWuangEvents.Models
@{
    ViewData["Title"] = "Chọn chỗ ngồi";
    var loaiVes = ViewBag.LoaiVes as List<LoaiVe> ?? new List<LoaiVe>();
}

@section Styles {
<style>
.seat-booking-page{max-width:1380px;margin:0 auto;padding:28px 24px 52px;color:#172033}.seat-booking-page *{box-sizing:border-box}.seat-booking-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:20px}.seat-booking-head h1{font-size:1.7rem;margin:8px 0 3px;font-weight:850;letter-spacing:-.04em}.seat-booking-head p{margin:0;color:#64748b;font-size:.92rem}.seat-back{font-size:.86rem;font-weight:750;color:#475569;text-decoration:none}.seat-back:hover{color:#6d28d9}.booking-steps{display:flex;align-items:center;gap:8px;color:#64748b;font-size:.82rem;font-weight:750}.booking-steps .active{color:#6d28d9}.booking-steps b{width:23px;height:23px;border-radius:50%;display:inline-grid;place-items:center;background:#ede9fe;color:#6d28d9;margin-right:4px}.booking-steps i{font-size:.64rem;color:#cbd5e1}
.seat-workspace{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:20px;align-items:start}.seat-map-card,.seat-summary{background:#fff;border:1px solid #e5e7eb;border-radius:18px;box-shadow:0 10px 30px rgba(30,41,59,.06)}.seat-map-card{padding:18px}.seat-summary{padding:20px;position:sticky;top:82px}.map-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 2px 14px}.map-toolbar-title{font-weight:800;font-size:.93rem;color:#334155}.map-toolbar-title i{color:#7c3aed;margin-right:6px}.map-toolbar-actions{display:flex;align-items:center;gap:5px}.map-tool{width:32px;height:32px;border:1px solid #ddd6fe;background:#fff;color:#6d28d9;border-radius:8px;font-size:1.05rem;font-weight:800;cursor:pointer}.map-tool:hover{background:#f5f3ff}.map-zoom{font-size:.78rem;min-width:42px;text-align:center;color:#64748b;font-weight:750}
.seat-map-viewport{overflow:auto;border:1px solid #e9e7f7;border-radius:14px;background:radial-gradient(circle at 50% 0,#f5f3ff 0,#fafbff 36%,#fff 100%);padding:18px;min-height:530px}.seat-map-host{position:relative}.seat-map-canvas{position:relative;transform-origin:top left;background-image:linear-gradient(#ede9fe 1px,transparent 1px),linear-gradient(90deg,#ede9fe 1px,transparent 1px);background-size:24px 24px;border:1px dashed #ddd6fe;border-radius:12px;box-shadow:inset 0 0 55px rgba(124,58,237,.035)}.map-stage{position:absolute;display:flex;align-items:center;justify-content:center;z-index:4;border-radius:10px;background:linear-gradient(120deg,#4c1d95,#7c3aed 60%,#a855f7);color:#fff;font-size:.72rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;box-shadow:0 8px 18px rgba(109,40,217,.23);text-align:center;padding:0 14px}.map-stage:after{content:"";position:absolute;left:10%;right:10%;top:7px;border-top:2px solid rgba(255,255,255,.38);border-radius:50%}
.seat-zone{position:absolute;box-sizing:border-box;border:2px solid var(--zone);border-radius:12px;background:color-mix(in srgb,var(--zone) 6%,#fff);box-shadow:0 9px 21px color-mix(in srgb,var(--zone) 14%,transparent);overflow:hidden}.seat-zone-header{height:31px;display:flex;align-items:center;justify-content:space-between;gap:7px;padding:0 10px;background:color-mix(in srgb,var(--zone) 11%,#fff);border-bottom:1px solid color-mix(in srgb,var(--zone) 25%,#fff)}.seat-zone-title{font-size:.72rem;font-weight:900;color:#243052;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.seat-zone-ticket{font-size:.64rem;font-weight:850;border-radius:99px;color:var(--zone);background:#fff;border:1px solid color-mix(in srgb,var(--zone) 40%,#fff);padding:2px 6px;white-space:nowrap}.seat-zone-body{height:calc(100% - 31px);padding:9px 10px;display:flex;flex-direction:column;justify-content:center;gap:3px;overflow:hidden}.seat-row{display:grid;align-items:center;gap:3px;grid-template-columns:25px 1fr}.row-label{text-align:center;color:#64748b;font-weight:850;font-size:.62rem;white-space:nowrap;overflow:hidden}.seat-grid{display:grid;gap:3px}.seat-btn{height:21px;min-width:0;padding:0;border:1.5px solid var(--zone);border-radius:5px;background:#fff;color:var(--zone);font-size:clamp(.44rem,.7vw,.64rem);font-weight:850;cursor:pointer;box-shadow:inset 0 -2px 0 color-mix(in srgb,var(--zone) 22%,#fff);transition:transform .12s,background .12s}.seat-btn:hover:not(:disabled){background:var(--zone);color:#fff;transform:translateY(-1px)}.seat-btn.selected{background:var(--zone);color:#fff;box-shadow:0 0 0 2px #fff,0 0 0 4px var(--zone)}.seat-btn:disabled{cursor:not-allowed}.seat-btn.held{background:#fef3c7;border-color:#f59e0b;color:#92400e}.seat-btn.sold{background:#fee2e2;border-color:#fca5a5;color:#b91c1c}.seat-btn.locked,.seat-btn.unavailable{background:#f1f5f9;border-color:#cbd5e1;color:#94a3b8}
.ga-zone-body{height:calc(100% - 31px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;background:repeating-linear-gradient(45deg,transparent,transparent 9px,color-mix(in srgb,var(--zone) 7%,transparent) 9px,color-mix(in srgb,var(--zone) 7%,transparent) 18px)}.ga-available{font-size:.72rem;font-weight:750;color:#64748b}.ga-control{display:flex;align-items:center;gap:10px}.ga-button{width:29px;height:29px;border:1.5px solid var(--zone);background:#fff;color:var(--zone);border-radius:50%;font-size:1rem;font-weight:900;cursor:pointer}.ga-button:hover:not(:disabled){background:var(--zone);color:#fff}.ga-button:disabled{opacity:.4;cursor:not-allowed}.ga-amount{min-width:25px;font-weight:900;color:#1e1b4b}.map-legend{display:flex;gap:13px;flex-wrap:wrap;padding:14px 2px 0;font-size:.74rem;color:#64748b;font-weight:700}.map-legend span{display:flex;align-items:center;gap:5px}.legend-chip{width:17px;height:14px;border-radius:4px;border:1px solid}.lc-empty{border-color:#7c3aed;background:#f5f3ff}.lc-selected{border-color:#7c3aed;background:#7c3aed}.lc-held{border-color:#f59e0b;background:#fef3c7}.lc-sold{border-color:#fca5a5;background:#fee2e2}
.summary-title{font-size:1.03rem;font-weight:850;margin:0 0 14px;color:#1e1b4b}.summary-title i{color:#7c3aed;margin-right:5px}.ticket-price-list{display:flex;flex-direction:column;gap:7px;border-bottom:1px solid #edf0f4;padding-bottom:14px}.ticket-price{display:flex;justify-content:space-between;gap:10px;padding:9px 10px;border:1px solid #edf0f4;border-radius:9px;font-size:.78rem;font-weight:750}.ticket-price-name{display:flex;gap:7px;align-items:center;min-width:0}.ticket-price-name span:last-child{overflow:hidden;text-overflow:ellipsis}.price-dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}.ticket-price strong{color:#5b21b6;white-space:nowrap}.selected-heading{display:flex;justify-content:space-between;align-items:center;margin:16px 0 9px;font-size:.86rem;font-weight:850}.selected-count{font-size:.7rem;color:#6d28d9;background:#ede9fe;border-radius:999px;padding:3px 8px}.selection-empty{padding:18px 10px;border:1.5px dashed #d8dee9;border-radius:10px;text-align:center;color:#94a3b8;font-size:.78rem}.selection-empty i{display:block;font-size:1.45rem;margin-bottom:5px}.selection-list{max-height:245px;overflow:auto;display:flex;flex-direction:column;gap:6px}.selection-row{display:flex;justify-content:space-between;align-items:center;gap:6px;background:#f8fafc;border-left:4px solid var(--sc);padding:7px 8px;border-radius:7px}.selection-row b{display:block;font-size:.77rem}.selection-row small{display:block;color:#64748b;font-size:.66rem}.selection-row-right{display:flex;gap:6px;align-items:center;font-size:.74rem;color:#5b21b6;font-weight:850}.remove-choice{border:0;background:#fee2e2;color:#dc2626;border-radius:50%;width:19px;height:19px;cursor:pointer;font-size:.64rem}.summary-total{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid #edf0f4;margin-top:15px;padding-top:14px;color:#64748b;font-size:.82rem;font-weight:750}.summary-total strong{font-size:1.26rem;color:#6d28d9}.submit-seat-map{margin-top:14px;width:100%;border:0;border-radius:10px;background:linear-gradient(100deg,#6d28d9,#9333ea);color:white;padding:12px;font-size:.9rem;font-weight:850;cursor:pointer}.submit-seat-map:disabled{background:#cbd5e1;cursor:not-allowed}.hold-note{display:flex;gap:7px;align-items:flex-start;margin:12px 2px 0;font-size:.7rem;line-height:1.4;color:#64748b}.hold-note i{color:#059669;margin-top:1px}.map-error{padding:50px 15px;text-align:center;color:#b91c1c;font-weight:750}.map-loading{padding:70px 15px;text-align:center;color:#64748b;font-size:.86rem;font-weight:750}.map-loading i{color:#7c3aed;font-size:1.8rem;display:block;margin-bottom:10px}
@@media(max-width:1050px){.seat-workspace{grid-template-columns:1fr}.seat-summary{position:static}.booking-steps{display:none}}@@media(max-width:600px){.seat-booking-page{padding:20px 12px 36px}.seat-booking-head{align-items:flex-start}.seat-booking-head h1{font-size:1.4rem}.seat-map-card{padding:12px}.seat-map-viewport{padding:10px;min-height:430px}.map-toolbar-title{font-size:.8rem}}
</style>
}

<main class="seat-booking-page">
    <header class="seat-booking-head"><div><a class="seat-back" href="/Home/ChiTiet/@Model.Id"><i class="fas fa-arrow-left me-1"></i>Quay lại sự kiện</a><h1>Chọn chỗ ngồi</h1><p><i class="fas fa-calendar-alt me-1 text-primary"></i>@Model.TenSuKien · @Model.NgayBatDau.ToString("dd/MM/yyyy HH:mm")</p></div><div class="booking-steps"><span class="active"><b>1</b>Chọn chỗ</span><i class="fas fa-chevron-right"></i><span>Thanh toán</span><i class="fas fa-chevron-right"></i><span>Nhận vé</span></div></header>
    @if (TempData["Error"] != null) { <div class="alert alert-danger rounded-3 py-2 px-3 mb-3 fw-bold"><i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]</div> }
    <div class="seat-workspace"><section class="seat-map-card"><div class="map-toolbar"><div class="map-toolbar-title"><i class="fas fa-chair"></i>Chọn ghế trực tiếp trên sơ đồ</div><div class="map-toolbar-actions"><button type="button" class="map-tool" onclick="changeZoom(-.1)" aria-label="Thu nhỏ">−</button><span class="map-zoom" id="zoomLabel">100%</span><button type="button" class="map-tool" onclick="changeZoom(.1)" aria-label="Phóng to">+</button><button type="button" class="map-tool" onclick="changeZoom(0)" aria-label="Đặt lại"><i class="fas fa-expand"></i></button></div></div><div class="seat-map-viewport"><div class="map-loading" id="mapLoading"><i class="fas fa-spinner fa-spin"></i>Đang tải sơ đồ chỗ ngồi...</div><div class="seat-map-host" id="mapHost" hidden><div class="seat-map-canvas" id="mapCanvas"><div class="map-stage" id="mapStage"></div></div></div></div><div class="map-legend" id="mapLegend" hidden><span><i class="legend-chip lc-empty"></i>Trống</span><span><i class="legend-chip lc-selected"></i>Đang chọn</span><span><i class="legend-chip lc-held"></i>Đang giữ</span><span><i class="legend-chip lc-sold"></i>Đã bán/khóa</span></div></section>
    <aside class="seat-summary"><h2 class="summary-title"><i class="fas fa-ticket"></i>Thông tin đặt chỗ</h2><div class="ticket-price-list">@foreach (var ve in loaiVes){<div class="ticket-price"><span class="ticket-price-name"><i class="price-dot" style="background:@(ve.MauSac ?? "#7c3aed")"></i><span>@ve.TenLoaiVe</span></span><strong>@ve.GiaBan.ToString("N0")đ</strong></div>}</div><div class="selected-heading"><span>Chỗ đã chọn</span><span class="selected-count" id="selectedCount">0 vé</span></div><div class="selection-empty" id="selectionEmpty"><i class="fas fa-chair"></i>Chưa chọn chỗ nào</div><div class="selection-list" id="selectionList" hidden></div><div class="summary-total"><span>Tổng tạm tính</span><strong id="selectedTotal">0đ</strong></div><form method="post" action="/Booking/DatVe" id="seatBookingForm">@Html.AntiForgeryToken()<input type="hidden" name="suKienId" value="@Model.Id" /><div id="bookingInputs"></div><button class="submit-seat-map" id="continueButton" type="submit" disabled>Tiếp tục thanh toán <i class="fas fa-arrow-right ms-1"></i></button></form><div class="hold-note"><i class="fas fa-shield-halved"></i><span>Chỗ chỉ được giữ sau khi bạn xác nhận sang cổng thanh toán, tối đa 10 phút.</span></div></aside></div>
</main>

@section Scripts {
<script>
const EVENT_ID='@Model.Id', selectedSeats=new Map(), selectedGA=new Map();let currentMap=null,currentZones=[],zoom=1;const money=value=>new Intl.NumberFormat('vi-VN').format(Number(value||0))+'đ';
function idealMapZoom(){const viewport=document.querySelector('.seat-map-viewport');if(!viewport||!currentMap)return 1;return Math.max(.55,Math.min(1,(viewport.clientWidth-38)/currentMap.width,(viewport.clientHeight-38)/currentMap.height))}
function changeZoom(delta){zoom=delta===0?idealMapZoom():Math.max(.55,Math.min(1.45,zoom+delta));document.getElementById('zoomLabel').textContent=Math.round(zoom*100)+'%';if(!currentMap)return;const canvas=document.getElementById('mapCanvas'),host=document.getElementById('mapHost');canvas.style.transform=`scale(${zoom})`;host.style.width=(currentMap.width*zoom)+'px';host.style.height=(currentMap.height*zoom)+'px'}
async function loadSeatMap(){try{const response=await fetch('/Booking/LaySoDoGheTheoSuKien?suKienId='+encodeURIComponent(EVENT_ID));if(!response.ok)throw new Error();const payload=await response.json();currentMap=payload.map;currentZones=payload.zones||[];renderSeatMap();document.getElementById('mapLoading').hidden=true;document.getElementById('mapHost').hidden=false;document.getElementById('mapLegend').hidden=false}catch{const loading=document.getElementById('mapLoading');loading.className='map-error';loading.innerHTML='<i class="fas fa-triangle-exclamation me-2"></i>Không thể tải sơ đồ. Vui lòng tải lại trang.'}}
function renderSeatMap(){const canvas=document.getElementById('mapCanvas');canvas.querySelectorAll('.seat-zone').forEach(item=>item.remove());canvas.style.width=currentMap.width+'px';canvas.style.height=currentMap.height+'px';const stage=document.getElementById('mapStage');stage.textContent=currentMap.stageLabel||'SÂN KHẤU';stage.style.left=currentMap.stageX+'px';stage.style.top=currentMap.stageY+'px';stage.style.width=currentMap.stageWidth+'px';stage.style.height=currentMap.stageHeight+'px';currentZones.forEach(zone=>canvas.appendChild(buildZone(zone)));changeZoom(0)}
function buildZone(zone){const zoneEl=document.createElement('section');zoneEl.className='seat-zone';zoneEl.style.setProperty('--zone',zone.color||'#7c3aed');zoneEl.style.left=zone.x+'px';zoneEl.style.top=zone.y+'px';zoneEl.style.width=zone.width+'px';zoneEl.style.height=zone.height+'px';const header=document.createElement('div');header.className='seat-zone-header';const title=document.createElement('span');title.className='seat-zone-title';title.textContent=zone.name;const ticket=document.createElement('span');ticket.className='seat-zone-ticket';ticket.textContent=zone.ticketName+' · '+money(zone.price);header.append(title,ticket);zoneEl.appendChild(header);if(zone.type==='ga')zoneEl.appendChild(buildGAZone(zone));else{const body=document.createElement('div');body.className='seat-zone-body';(zone.rows||[]).forEach(row=>body.appendChild(buildSeatRow(row,zone)));zoneEl.appendChild(body)}return zoneEl}
function buildSeatRow(row,zone){const rowEl=document.createElement('div');rowEl.className='seat-row';const label=document.createElement('span');label.className='row-label';label.textContent=row.name;const grid=document.createElement('div');grid.className='seat-grid';grid.style.gridTemplateColumns=`repeat(${row.seats.length}, minmax(16px, 1fr))`;row.seats.forEach(seat=>{const button=document.createElement('button');button.type='button';button.className='seat-btn';button.textContent=seat.label;button.title=zone.name+' · Ghế '+seat.label+' · '+money(zone.price);if(!zone.enabled){button.disabled=true;button.classList.add('unavailable')}else if(seat.status===1){button.disabled=true;button.classList.add('held')}else if(seat.status===2){button.disabled=true;button.classList.add('sold')}else if(seat.status===3){button.disabled=true;button.classList.add('locked')}else button.addEventListener('click',()=>toggleSeat(button,seat,zone));grid.appendChild(button)});rowEl.append(label,grid);return rowEl}
function buildGAZone(zone){const body=document.createElement('div');body.className='ga-zone-body';const available=document.createElement('div');available.className='ga-available';available.textContent=zone.enabled?'Còn '+zone.available+' chỗ':'Hiện chưa mở bán';const control=document.createElement('div');control.className='ga-control';const minus=document.createElement('button');minus.type='button';minus.className='ga-button';minus.textContent='−';minus.disabled=!zone.enabled;const amount=document.createElement('span');amount.className='ga-amount';amount.id='ga-'+zone.id;amount.textContent=selectedGA.get(zone.id)?.count||0;const plus=document.createElement('button');plus.type='button';plus.className='ga-button';plus.textContent='+';plus.disabled=!zone.enabled||zone.available<=0;minus.addEventListener('click',()=>changeGA(zone,-1));plus.addEventListener('click',()=>changeGA(zone,1));control.append(minus,amount,plus);body.append(available,control);return body}
function countForTicket(ticketId){let total=0;selectedSeats.forEach(item=>{if(item.ticketId===ticketId)total++});selectedGA.forEach(item=>{if(item.ticketId===ticketId)total+=item.count});return total}
function toggleSeat(button,seat,zone){if(selectedSeats.has(seat.id)){selectedSeats.delete(seat.id);button.classList.remove('selected')}else{if(countForTicket(zone.ticketId)>=zone.limitPerOrder)return showToast(`Mỗi đơn tối đa ${zone.limitPerOrder} vé ${zone.ticketName}.`);selectedSeats.set(seat.id,{id:seat.id,label:seat.label,zoneName:zone.name,ticketId:zone.ticketId,ticketName:zone.ticketName,price:Number(zone.price),color:zone.color});button.classList.add('selected')}updateSummary()}
function changeGA(zone,delta){const current=selectedGA.get(zone.id)||{zoneId:zone.id,count:0,ticketId:zone.ticketId,ticketName:zone.ticketName,zoneName:zone.name,price:Number(zone.price),color:zone.color};const withoutThis=countForTicket(zone.ticketId)-current.count;current.count=Math.max(0,Math.min(current.count+delta,zone.available,zone.limitPerOrder-withoutThis));if(current.count)selectedGA.set(zone.id,current);else selectedGA.delete(zone.id);const amount=document.getElementById('ga-'+zone.id);if(amount)amount.textContent=current.count;updateSummary()}
function removeChoice(kind,id){if(kind==='seat'){selectedSeats.delete(Number(id));renderSeatMap()}else{selectedGA.delete(Number(id));const amount=document.getElementById('ga-'+id);if(amount)amount.textContent='0'}updateSummary()}
function updateSummary(){const list=document.getElementById('selectionList'),empty=document.getElementById('selectionEmpty'),inputs=document.getElementById('bookingInputs');list.innerHTML='';inputs.innerHTML='';let total=0,count=0;selectedSeats.forEach(item=>{total+=item.price;count++;appendChoice(item,'seat',item.id);addHidden('choNgoiIds',item.id)});selectedGA.forEach(item=>{total+=item.price*item.count;count+=item.count;appendChoice(item,'ga',item.zoneId,item.count);addHidden(`khuDungChon[${item.zoneId}]`,item.count)});document.getElementById('selectedCount').textContent=count+' vé';document.getElementById('selectedTotal').textContent=money(total);empty.hidden=count>0;list.hidden=count===0;document.getElementById('continueButton').disabled=count===0}
function appendChoice(item,kind,id,quantity=1){const row=document.createElement('div');row.className='selection-row';row.style.setProperty('--sc',item.color||'#7c3aed');const left=document.createElement('div'),label=kind==='seat'?'Ghế '+item.label:'Khu đứng × '+quantity;const labelEl=document.createElement('b');labelEl.textContent=label;const detailEl=document.createElement('small');detailEl.textContent=item.zoneName+' · '+item.ticketName;left.append(labelEl,detailEl);const right=document.createElement('div');right.className='selection-row-right';const price=document.createElement('span');price.textContent=money(item.price*quantity);right.appendChild(price);const remove=document.createElement('button');remove.type='button';remove.className='remove-choice';remove.setAttribute('aria-label','Bỏ lựa chọn');remove.innerHTML='<i class="fas fa-times"></i>';remove.addEventListener('click',()=>removeChoice(kind,id));right.appendChild(remove);row.append(left,right);document.getElementById('selectionList').appendChild(row)}
function addHidden(name,value){const input=document.createElement('input');input.type='hidden';input.name=name;input.value=value;document.getElementById('bookingInputs').appendChild(input)}function showToast(message){if(window.WuangUI?.toast)WuangUI.toast(message,'error');else window.alert(message)}document.addEventListener('DOMContentLoaded',loadSeatMap);
</script>
}
