@model List<dynamic>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
.orders-page { max-width: 900px; margin: 0 auto; padding: 32px 16px 64px; }
.orders-hero { background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); border-radius: 20px; padding: 28px 32px; color: #fff; margin-bottom: 28px; }
.orders-hero h1 { font-size: 1.7rem; font-weight: 800; margin: 0 0 6px; }
.orders-hero p { opacity: .82; margin: 0; font-size: .95rem; }

/* Tab lọc */
.orders-tabs { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
.tab-btn { background: #f3f4f6; color: #4b5563; border: none; padding: 8px 20px; border-radius: 20px; font-weight: 600; cursor: pointer; font-size: .88rem; transition: .2s; }
.tab-btn:hover { background: #e5e7eb; }
.tab-btn.active { background: #7c3aed; color: #fff; }

/* Card đơn hàng */
.order-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 14px rgba(0,0,0,.08); overflow: hidden; margin-bottom: 16px; transition: .2s; border: 1px solid #f0f0f0; }
.order-card:hover { box-shadow: 0 4px 24px rgba(124,58,237,.12); transform: translateY(-2px); }
.order-card-body { display: flex; align-items: stretch; gap: 0; }
.order-img { width: 130px; min-height: 100px; flex-shrink: 0; overflow: hidden; }
.order-img img { width: 100%; height: 100%; object-fit: cover; }
.order-img .img-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #ede9fe, #c4b5fd); display: flex; align-items: center; justify-content: center; }
.order-info { flex: 1; padding: 18px 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
.order-event-name { font-weight: 700; font-size: 1.05rem; color: #1a1a2e; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.order-meta-row { display: flex; flex-wrap: wrap; gap: 12px; }
.order-meta-item { display: flex; align-items: center; gap: 6px; font-size: .82rem; color: #666; }
.order-meta-item i { color: #7c3aed; width: 14px; }
.order-footer { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px 16px; border-top: 1px solid #f3f4f6; gap: 12px; flex-wrap: wrap; }
.order-total { font-size: 1.1rem; font-weight: 800; color: #7c3aed; }
.order-code { font-size: .78rem; color: #aaa; font-family: monospace; }

/* Badge trạng thái */
.badge-paid { display: inline-flex; align-items: center; gap: 5px; background: #d1fae5; color: #065f46; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }
.badge-pending { display: inline-flex; align-items: center; gap: 5px; background: #fef9c3; color: #92400e; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }
.badge-cancelled { display: inline-flex; align-items: center; gap: 5px; background: #fee2e2; color: #dc2626; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }
.badge-refund { display: inline-flex; align-items: center; gap: 5px; background: #dbeafe; color: #1e40af; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }
.badge-expired { display: inline-flex; align-items: center; gap: 5px; background: #f3f4f6; color: #6b7280; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }

/* Phương thức thanh toán */
.pm-tag { font-size: .72rem; background: #ede9fe; color: #5b21b6; padding: 2px 8px; border-radius: 8px; font-weight: 600; }

/* Empty state */
.empty-state { text-align: center; padding: 60px 20px; color: #9ca3af; }
.empty-state i { font-size: 3.5rem; display: block; margin-bottom: 16px; color: #ddd; }
.empty-state h3 { font-size: 1.1rem; font-weight: 700; color: #4b5563; margin-bottom: 8px; }

@@media(max-width: 600px) {
    .order-img { width: 90px; }
    .orders-hero { padding: 20px 18px; }
}
</style>
}

<div class="orders-page">
    @* HERO *@
    <div class="orders-hero">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
            <div>
                <h1><i class="fas fa-ticket me-2"></i>Đơn hàng của tôi</h1>
                <p>Xem lại lịch sử mua vé và tra cứu vé điện tử của bạn.</p>
            </div>
            <span style="background:rgba(255,255,255,.15);color:#fff;padding:8px 16px;border-radius:12px;font-weight:700;font-size:.95rem">
                @Model.Count đơn hàng
            </span>
        </div>
    </div>

    @* TABS LỌC *@
    <div class="orders-tabs">
        <button class="tab-btn" onclick="locTab(this, 'all')"><i class="fas fa-list me-1"></i> Tất cả</button>
        <button class="tab-btn active" id="tab-paid" onclick="locTab(this, '1')"><i class="fas fa-circle-check text-success me-1"></i> Đã thanh toán</button>
        <button class="tab-btn" onclick="locTab(this, '0')"><i class="fas fa-clock text-warning me-1"></i> Chờ thanh toán</button>
        <button class="tab-btn" onclick="locTab(this, '2')"><i class="fas fa-circle-xmark text-danger me-1"></i> Đã hủy</button>
        <button class="tab-btn" onclick="locTab(this, '3,4')"><i class="fas fa-circle-info text-info me-1"></i> Hoàn tiền / Hết hạn</button>
    </div>

    @* DANH SÁCH ĐƠN HÀNG *@
    <div id="orderList">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-ticket"></i>
                <h3>Bạn chưa có đơn hàng nào</h3>
                <p>Khám phá các sự kiện đang mở bán và đặt vé ngay!</p>
                <a href="/" class="btn btn-primary mt-3"><i class="fas fa-compass me-2"></i>Khám phá sự kiện</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                byte tt = (byte)item.TrangThai;
                string tenSuKien = (string)(item.TenSuKien ?? "Sự kiện");
                string anhBia = (string)(item.AnhBia ?? "");
                string maDon = (string)(item.MaDonHang ?? "");
                decimal tongTien = (decimal)item.TongThanhToan;
                string ngayTao = ((DateTime)item.NgayTao).ToString("dd/MM/yyyy HH:mm");
                string diaDiem = (string)(item.DiaDiemSuKien ?? "");
                byte pttt = (byte)(item.PhuongThucThanhToan ?? 0);

                <div class="order-card" data-tt="@tt">
                    <div class="order-card-body">
                        @* Ảnh sự kiện *@
                        <div class="order-img">
                            @if (!string.IsNullOrEmpty(anhBia))
                            {
                                <img src="@anhBia" alt="@tenSuKien" onerror="this.parentNode.innerHTML='<div class=\'img-placeholder\'><i class=\'fas fa-calendar-days\' style=\'font-size:2rem;color:#a78bfa\'></i></div>'" />
                            }
                            else
                            {
                                <div class="img-placeholder">
                                    <i class="fas fa-calendar-days" style="font-size:2rem;color:#a78bfa"></i>
                                </div>
                            }
                        </div>

                        @* Thông tin đơn *@
                        <div class="order-info">
                            <div>
                                <div class="order-event-name">@tenSuKien</div>
                                <div class="order-meta-row mt-2">
                                    <span class="order-meta-item"><i class="fas fa-calendar"></i> @ngayTao</span>
                                    @if (!string.IsNullOrEmpty(diaDiem))
                                    {
                                        <span class="order-meta-item"><i class="fas fa-map-marker-alt"></i> @diaDiem</span>
                                    }
                                    <span class="order-meta-item">
                                        <i class="fas fa-credit-card"></i>
                                        <span class="pm-tag">@(pttt == 2 ? "VNPay" : pttt == 3 ? "MoMo" : pttt == 4 ? "ZaloPay" : "Đang xử lý")</span>
                                    </span>
                                </div>
                            </div>
                            <div class="order-code">Mã đơn: @maDon</div>
                        </div>
                    </div>

                    <div class="order-footer">
                        @* Badge trạng thái *@
                        @if (tt == 1)
                        {
                            <span class="badge-paid"><i class="fas fa-circle-check"></i> Đã thanh toán</span>
                        }
                        else if (tt == 0)
                        {
                            <span class="badge-pending"><i class="fas fa-clock"></i> Chờ thanh toán</span>
                        }
                        else if (tt == 2)
                        {
                            <span class="badge-cancelled"><i class="fas fa-ban"></i> Đã hủy</span>
                        }
                        else if (tt == 3)
                        {
                            <span class="badge-refund"><i class="fas fa-rotate-left"></i> Hoàn tiền</span>
                        }
                        else
                        {
                            <span class="badge-expired"><i class="fas fa-timer"></i> Hết hạn</span>
                        }

                        <div style="display:flex;align-items:center;gap:12px">
                            <span class="order-total">@tongTien.ToString("N0") VND</span>
                            @if (tt == 0)
                            {
                                <a href="/Booking/ThanhToan?id=@item.Id" class="btn btn-primary btn-sm" style="border-radius:8px;font-weight:600">
                                    <i class="fas fa-credit-card me-1"></i>Thanh toán
                                </a>
                            }
                            @if (tt == 1)
                            {
                                <a href="/Booking/ChiTietDonHang?id=@item.Id" class="btn btn-outline-primary btn-sm" style="border-radius:8px;font-weight:600">
                                    <i class="fas fa-ticket me-1"></i>Xem vé
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
function locTab(btn, giaTri) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.order-card').forEach(card => {
        const tt = card.getAttribute('data-tt');
        if (giaTri === 'all') {
            card.style.display = '';
        } else if (giaTri === '3,4') {
            card.style.display = (tt === '3' || tt === '4') ? '' : 'none';
        } else {
            card.style.display = (tt === giaTri) ? '' : 'none';
        }
    });
}

// Tự động chạy bộ lọc cho tab Đã thanh toán lúc tải trang
window.addEventListener('DOMContentLoaded', function() {
    const tabPaid = document.getElementById('tab-paid');
    if (tabPaid) {
        locTab(tabPaid, '1');
    }
});
</script>
}
