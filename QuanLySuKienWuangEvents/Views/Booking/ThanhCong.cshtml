@model DonHang
@using QuanLySuKienWuangEvents.Models

@{
    ViewData["Title"] = "Đặt vé thành công";
    var sk = ViewBag.SuKien as SuKien;
    bool laTrucTuyen = sk?.LoaiSuKien == 1;
    bool laMienPhi = Model.TongThanhToan <= 0;
}

@* ThanhCong(id) chỉ trả đơn đã thanh toán thuộc user hiện tại.
   Model là DonHang; ViewBag chứa sự kiện, danh sách vé và ghế. *@
@section Styles {
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    .success-page {
        max-width: 680px;
        margin: 0 auto;
        padding: 40px 16px 80px;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    
    /* Thanh tiến trình 3 bước */
    .checkout-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 600px;
        margin: 0 auto 32px;
    }
    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 2;
    }
    .step-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e5e7eb;
        color: #4b5563;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        border: 2px solid #e5e7eb;
        transition: all 0.3s ease;
    }
    .step.completed .step-num {
        background: #10b981;
        color: #fff;
        border-color: #10b981;
    }
    .step-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: #9ca3af;
        margin-top: 8px;
        white-space: nowrap;
    }
    .step.completed .step-label {
        color: #10b981;
    }
    .step-line {
        flex: 1;
        height: 3px;
        background: #e5e7eb;
        margin: -20px 10px 0;
        position: relative;
        z-index: 1;
        border-radius: 2px;
    }
    .step-line.completed {
        background: #10b981;
    }

    .success-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid #f1f5f9;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.05), 0 1px 8px rgba(0, 0, 0, 0.02);
        padding: 40px;
        text-align: center;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #d1fae5;
        color: #10b981;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.2);
    }

    .order-summary-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        margin: 28px 0;
        text-align: left;
    }

    .summary-title {
        font-size: 0.82rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 12px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 8px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 0.92rem;
        color: #334155;
    }
    
    .btn-action-group {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 32px;
    }
    
    .btn-main {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        border: none;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-main:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.3);
        color: #fff;
    }

    .btn-secondary {
        background: #fff;
        color: #475569;
        border: 1.5px solid #cbd5e1;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-secondary:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #1e293b;
    }
</style>
}

<div class="success-page">
    @* Thanh tiến trình 3 bước *@
    <div class="checkout-steps">
        <div class="step completed">
            <span class="step-num"><i class="fas fa-check"></i></span>
            <span class="step-label">Chọn vé</span>
        </div>
        <div class="step-line completed"></div>
        <div class="step completed">
            <span class="step-num"><i class="fas fa-check"></i></span>
            <span class="step-label">@(laMienPhi ? "Xác nhận" : "Thanh toán")</span>
        </div>
        <div class="step-line completed"></div>
        <div class="step completed">
            <span class="step-num"><i class="fas fa-check"></i></span>
            <span class="step-label">Hoàn tất</span>
        </div>
    </div>

    <div class="success-card">
        <div class="success-icon">
            <i class="fas @(laTrucTuyen ? "fa-video" : "fa-check") fa-2x"></i>
        </div>
        
        <h1 class="h3 fw-bold" style="color: #0f172a; font-weight: 800;">@(laTrucTuyen || laMienPhi ? "Đăng ký tham dự thành công!" : "Đặt vé thành công!")</h1>
        <p style="color: #64748b; font-size: 0.95rem; margin-top: 8px; line-height: 1.5;">
            @(laTrucTuyen
                ? "Quyền tham dự trực tuyến đã được gắn với đơn hàng của bạn."
                : laMienPhi
                    ? "Đăng ký đã được xác nhận và vé điện tử đã sẵn sàng cho bạn."
                    : "Hệ thống đã nhận được thanh toán và tạo vé điện tử thành công cho bạn.")
        </p>

        <div class="order-summary-box">
            <div class="summary-title">@(laMienPhi ? "Thông tin đăng ký" : "Thông tin giao dịch")</div>
            
            <div class="summary-row">
                <span>Mã đơn hàng:</span>
                <strong style="color: #7c3aed; font-family: monospace; font-size: 1rem;">@Model.MaDonHang</strong>
            </div>

            @if (sk != null)
            {
                    <div class="summary-row">
                        <span>Sự kiện:</span>
                        <strong style="max-width: 320px; text-align: right;">@sk.TenSuKien</strong>
                    </div>
                    <div class="summary-row">
                        <span>Thời gian:</span>
                        <strong>@sk.NgayBatDau.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
            }

            <div class="summary-row">
                <span>@(laMienPhi ? "Chi phí:" : "Tổng tiền đã thanh toán:")</span>
                <strong style="color: #10b981; font-size: 1.05rem;">@(laMienPhi ? "Miễn phí" : Model.TongThanhToan.ToString("N0") + " VND")</strong>
            </div>
        </div>

        <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 14px; padding: 16px; text-align: left; font-size: 0.88rem; color: #065f46; display: flex; gap: 12px; align-items: flex-start; margin-bottom: 24px;">
            <i class="fas fa-envelope-open-text" style="font-size: 1.2rem; margin-top: 2px;"></i>
            <div>
                <strong>@(laTrucTuyen ? "Xác nhận tham dự đã gửi đến email:" : "Vé đã gửi đến email:")</strong><br />
                @(laTrucTuyen ? "Thông tin truy cập" : "Thông tin vé chi tiết") đã được gửi đến <strong style="text-decoration: underline;">@Model.EmailNguoiMua</strong>.
            </div>
        </div>

        @if (sk != null)
        {
            var format = "yyyyMMddTHHmmssZ";
            var startUtc = VietnamTime.ToUtc(sk.NgayBatDau).ToString(format);
            var endUtc = VietnamTime.ToUtc(sk.NgayKetThuc).ToString(format);
            var gTitle = Uri.EscapeDataString(sk.TenSuKien);
            var gDesc = Uri.EscapeDataString(sk.MoTaNgan ?? "");
            var gLoc = Uri.EscapeDataString(sk.LoaiSuKien == 1 ? "Trực tuyến: " + (sk.LinkOnline ?? "") : $"{sk.TenDiaDiem}, {sk.DiaChiDiaDiem}, {sk.ThanhPhoDiaDiem}");
            var googleCalendarLink = $"https://calendar.google.com/calendar/render?action=TEMPLATE&text={gTitle}&dates={startUtc}/{endUtc}&details={gDesc}&location={gLoc}";

            <div style="margin-bottom: 16px;">
                <a href="@googleCalendarLink" target="_blank" class="btn-secondary" style="font-size: 0.85rem; padding: 8px 16px;">
                    <i class="fab fa-google"></i> Thêm sự kiện vào Google Calendar
                </a>
            </div>
        }

        <div class="btn-action-group">
            <a class="btn-main" asp-controller="Booking" asp-action="ChiTietDonHang" asp-route-id="@Model.Id">
                <i class="fas @(laTrucTuyen ? "fa-video" : "fa-qrcode")"></i> @(laTrucTuyen ? "Xem quyền tham dự" : "Xem vé của bạn")
            </a>
            <a class="btn-secondary" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
    window.addEventListener('load', function() {
        // Bắn confetti chúc mừng khi load trang
        confetti({
            particleCount: 150,
            spread: 80,
            origin: { y: 0.6 }
        });
    });
</script>
