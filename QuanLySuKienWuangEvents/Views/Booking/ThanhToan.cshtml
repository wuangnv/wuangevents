@model ThanhToanViewModel
@{
    bool laMienPhi = Model.TongThanhToan <= 0;
    ViewData["Title"] = laMienPhi ? "Xác nhận đăng ký" : "Thanh toán";
    string backUrl = Model.CoSoDo ? $"/Booking/ChonGhe?suKienId={Model.SuKien.Id}" : $"/Home/ChiTiet/{Model.SuKien.Id}";
}

@section Styles {
<style>
.checkout-page{max-width:1160px;margin:auto;padding:34px 18px 75px}.checkout-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:22px}.back-link{color:#64748b;text-decoration:none;font-weight:700;font-size:.86rem}.checkout-top h1{font-size:1.65rem;font-weight:850;color:#1e1b4b;margin:15px 0 5px}.checkout-top p{color:#64748b;margin:0}.steps{display:flex;align-items:center;gap:8px;font-size:.8rem;font-weight:800;color:#94a3b8}.steps .done{color:#059669}.steps .active{color:#7c3aed}.draft-note{display:flex;gap:12px;align-items:flex-start;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:14px;padding:14px 16px;margin-bottom:22px;font-size:.86rem;line-height:1.5}.checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) 370px;gap:22px;align-items:start}.card-x{background:#fff;border:1px solid #e8e5f2;border-radius:19px;box-shadow:0 10px 30px rgba(50,36,90,.06);padding:23px;margin-bottom:18px}.card-x h2{font-size:1.03rem;color:#211c3d;font-weight:850;margin:0 0 17px}.event-mini{display:flex;gap:16px;align-items:center}.event-mini img{width:112px;height:76px;object-fit:cover;border-radius:12px;background:#ede9fe}.event-mini h3{font-size:1rem;font-weight:850;margin:0 0 5px;color:#1f2937}.event-mini p{font-size:.8rem;color:#64748b;margin:3px 0}.ticket-row{display:grid;grid-template-columns:1fr auto auto;gap:20px;padding:15px 0;border-bottom:1px solid #f0edf6;align-items:center}.ticket-row:last-child{border:0}.ticket-title{font-weight:800;color:#312e81}.ticket-sub{font-size:.76rem;color:#64748b;margin-top:3px}.ticket-qty{background:#f5f3ff;color:#6d28d9;padding:5px 9px;border-radius:8px;font-size:.76rem;font-weight:850}.ticket-price{font-weight:850;color:#1f2937}.seat-tags{display:flex;flex-wrap:wrap;gap:8px}.seat-tag{padding:8px 10px;border:1px solid color-mix(in srgb,var(--tag-color) 40%,#ddd);background:color-mix(in srgb,var(--tag-color) 9%,#fff);color:#334155;border-radius:10px;font-size:.77rem;font-weight:750}.summary-line{display:flex;justify-content:space-between;gap:10px;padding:11px 0;color:#64748b;font-size:.86rem}.summary-line strong{color:#1f2937}.summary-total{border-top:1px solid #e8e5f2;margin-top:7px;padding-top:16px;align-items:end}.summary-total strong{font-size:1.35rem;color:#7c3aed}.voucher-form{display:flex;gap:8px;margin-top:13px}.voucher-form input{min-width:0;flex:1;border:1.5px solid #d8d4e5;border-radius:11px;padding:10px 12px;font-weight:650;text-transform:uppercase}.voucher-form button{border:0;background:#ede9fe;color:#6d28d9;border-radius:11px;padding:10px 13px;font-weight:800}.voucher-applied{margin-top:11px;background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;border-radius:10px;padding:9px 11px;font-size:.8rem;font-weight:750}.payment-list{display:grid;gap:9px}.payment{display:flex;align-items:center;gap:12px;border:2px solid #e5e7eb;border-radius:13px;padding:13px;cursor:pointer;transition:.15s}.payment.active{border-color:#7c3aed;background:#faf5ff}.payment img{width:46px;height:29px;object-fit:contain}.payment strong{font-size:.88rem;flex:1}.payment i{color:#d1d5db}.payment.active i{color:#7c3aed}.pay-btn{width:100%;border:0;border-radius:13px;background:linear-gradient(135deg,#7c3aed,#9333ea);color:#fff;padding:15px;font-weight:850;margin-top:16px;box-shadow:0 9px 22px rgba(124,58,237,.22)}.pay-btn:disabled{opacity:.65}.pay-explain{text-align:center;color:#64748b;font-size:.74rem;line-height:1.45;margin:11px 3px 0}.alert-x{border-radius:13px;padding:12px 15px;margin-bottom:16px;font-size:.85rem;font-weight:650}.alert-error{background:#fff1f2;color:#be123c;border:1px solid #fecdd3}.alert-ok{background:#ecfdf5;color:#047857;border:1px solid #a7f3d0}@@media(max-width:880px){.checkout-grid{grid-template-columns:1fr}.checkout-top{display:block}.steps{margin-top:15px;overflow:auto}.ticket-row{grid-template-columns:1fr auto}.ticket-price{grid-column:1/-1}.event-mini img{width:90px}}
.free-confirm{display:flex;align-items:center;gap:12px;border:1px solid #a7f3d0;background:#ecfdf5;border-radius:13px;padding:14px;color:#047857}.free-confirm i{font-size:1.15rem}.free-confirm strong{font-size:.9rem}.pay-btn.free{background:#059669;box-shadow:0 9px 22px rgba(5,150,105,.2)}
</style>
}

<main class="checkout-page">
    <div class="checkout-top">
        <div>
            <a class="back-link" href="@backUrl"><i class="fas fa-arrow-left me-1"></i> Chọn lại</a>
            <h1>@(laMienPhi ? "Xác nhận đăng ký" : "Thanh toán")</h1>
        </div>
        <div class="steps"><span class="done"><i class="fas fa-check-circle"></i> Chọn vé</span><i class="fas fa-chevron-right"></i><span class="active">@(laMienPhi ? "Xác nhận" : "Thanh toán")</span></div>
    </div>

    @if (TempData["Error"] != null) { <div class="alert-x alert-error"><i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]</div> }
    @if (TempData["Message"] != null) { <div class="alert-x alert-ok"><i class="fas fa-circle-check me-2"></i>@TempData["Message"]</div> }

    <div class="checkout-grid">
        <div>
            <section class="card-x event-mini">
                <img src="@(string.IsNullOrWhiteSpace(Model.SuKien.AnhBia) ? "/images/default-event.svg" : Model.SuKien.AnhBia)" alt="@Model.SuKien.TenSuKien" />
                <div><h3>@Model.SuKien.TenSuKien</h3><p><i class="far fa-calendar me-1"></i>@Model.SuKien.NgayBatDau.ToString("dd/MM/yyyy HH:mm")</p><p><i class="fas fa-location-dot me-1"></i>@(Model.SuKien.LoaiSuKien == 1 ? "Sự kiện trực tuyến" : Model.SuKien.TenDiaDiem)</p></div>
            </section>

            <section class="card-x">
                <h2><i class="fas fa-ticket me-2" style="color:#7c3aed"></i>Vé đã chọn</h2>
                @foreach (var item in Model.CacLoaiVe)
                {
                    <div class="ticket-row">
                        <div><div class="ticket-title">@item.TenLoaiVe</div><div class="ticket-sub">Đơn giá @item.DonGia.ToString("N0") VND</div></div>
                        <span class="ticket-qty">× @item.SoLuong</span><span class="ticket-price">@item.ThanhTien.ToString("N0") VND</span>
                    </div>
                }
            </section>

            @if (Model.CoSoDo)
            {
                <section class="card-x"><h2><i class="fas fa-chair me-2" style="color:#7c3aed"></i>Ghế đã chọn</h2><div class="seat-tags">
                    @foreach (var ghe in Model.GheDaChon)
                    {
                        <span class="seat-tag" style="--tag-color:@(ghe.MauSac ?? "#7c3aed")"><i class="fas fa-chair me-1"></i>@ghe.SoGhe · @ghe.TenKhuVuc · @ghe.TenLoaiVe</span>
                    }
                </div></section>
            }
        </div>

        <aside>
            <section class="card-x">
                <h2><i class="fas fa-receipt me-2" style="color:#7c3aed"></i>Tóm tắt</h2>
                <div class="summary-line"><span>@Model.TongSoVe vé</span><strong>@Model.TongTienVe.ToString("N0") VND</strong></div>
                @if (!laMienPhi)
                {
                    <form method="post" action="/Booking/ApDungVoucher" class="voucher-form">
                        @Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Token" />
                        <input name="maCode" value="@Model.MaGiamGia" placeholder="MÃ GIẢM GIÁ" required /><button type="submit">Áp dụng</button>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(Model.MaGiamGia)) { <div class="voucher-applied"><i class="fas fa-tag me-1"></i>@Model.MaGiamGia: giảm @Model.TienGiamGia.ToString("N0") VND</div> }
                    <div class="summary-line"><span>Giảm giá</span><strong style="color:#059669">-@Model.TienGiamGia.ToString("N0") VND</strong></div>
                }
                <div class="summary-line summary-total"><span>@(laMienPhi ? "Tổng cộng" : "Tổng thanh toán")</span><strong>@(laMienPhi ? "Miễn phí" : Model.TongThanhToan.ToString("N0") + " VND")</strong></div>
            </section>

            <section class="card-x">
                @if (laMienPhi)
                {
                    <h2><i class="fas fa-circle-check me-2" style="color:#059669"></i>Hoàn tất đăng ký</h2>
                    <div class="free-confirm"><i class="fas fa-ticket"></i><strong>Vé miễn phí</strong></div>
                }
                else
                {
                    <h2><i class="fas fa-shield-halved me-2" style="color:#7c3aed"></i>Chọn cổng thanh toán</h2>
                    <div class="payment-list">
                        <label class="payment active" data-method="vnpay"><input hidden type="radio" name="method-ui" checked /><img src="/images/vnpay.svg" alt="VNPAY" /><strong>VNPAY</strong><i class="fas fa-circle-check"></i></label>
                        <label class="payment" data-method="momo"><input hidden type="radio" name="method-ui" /><img src="/images/momo.svg" alt="MoMo" /><strong>MoMo</strong><i class="fas fa-circle-check"></i></label>
                        <label class="payment" data-method="zalopay"><input hidden type="radio" name="method-ui" /><img src="/images/zalopay.svg" alt="ZaloPay" /><strong>ZaloPay</strong><i class="fas fa-circle-check"></i></label>
                    </div>
                }
                <form method="post" action="/Booking/XacNhanThanhToan" id="paymentForm">
                    @Html.AntiForgeryToken()<input type="hidden" name="token" value="@Model.Token" />
                    @if (!laMienPhi) { <input type="hidden" name="phuongThuc" id="paymentMethod" value="vnpay" /> }
                    <button type="submit" class="pay-btn @(laMienPhi ? "free" : "")" id="payButton"><i class="fas @(laMienPhi ? "fa-ticket" : "fa-lock") me-1"></i><span id="payLabel">@(laMienPhi ? "Hoàn tất đăng ký" : $"Thanh toán {Model.TongThanhToan:N0} VND")</span></button>
                </form>
            </section>
        </aside>
    </div>
</main>

@section Scripts {
<script>
const isFreeRegistration = @(laMienPhi ? "true" : "false");
document.querySelectorAll('.payment').forEach(card=>card.addEventListener('click',()=>{
    document.querySelectorAll('.payment').forEach(x=>x.classList.remove('active')); card.classList.add('active'); document.getElementById('paymentMethod').value=card.dataset.method;
}));
document.getElementById('paymentForm').addEventListener('submit',()=>{
    const button=document.getElementById('payButton'); button.disabled=true; document.getElementById('payLabel').textContent=isFreeRegistration?'Đang xác nhận đăng ký...':'Đang tạo đơn và chuyển tới cổng...';
});
</script>
}
